---
type AdItem = {
  id: string;
  title?: string;
  desc?: string;
  img?: string;
  video?: string;
  link: string;
  cta?: string;
  closeable?: boolean;
  desktop?: boolean;
  every?: number;
};

const { ad } = Astro.props as { ad: AdItem };
---

<div
  class="ad-wrapper ad-tilt in-content-ad-box grid-ad-box"
  data-ad-id={ad.id}
  data-closeable={ad.closeable ? "1" : "0"}
>
  <a href={ad.link} target="_blank" rel="noopener noreferrer" class="ad-link">
    <div class="ad-media">
      {
        ad.video ? (
          <video
            src={ad.video}
            autoplay
            loop
            muted
            playsinline
            aria-label={ad.title || "إعلان"}
          />
        ) : ad.img ? (
          <img
            src={ad.img}
            alt={ad.title || "إعلان"}
            loading="lazy"
            decoding="async"
          />
        ) : null
      }
    </div>

    {
      (ad.title || ad.desc || ad.cta) && (
        <div class="ad-body">
          {ad.title && <h4>{ad.title}</h4>}
          {ad.desc && <p>{ad.desc}</p>}
          {ad.cta && (
            <button type="button" class="ad-cta" tabindex="-1">
              {ad.cta}
            </button>
          )}
        </div>
      )
    }

    <span class="ad-badge">📢 إعلان</span>
  </a>
</div>