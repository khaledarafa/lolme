{/* CONFIG + SCRIPTS */}
<script
  type="application/json"
  id="ads-config"
  set:html={JSON.stringify(adsConfig)
    .replace(/</g, "\\u003c")
    .replace(/>/g, "\\u003e")
    .replace(/&/g, "\\u0026")}
/>

<script>
  function initFloatingAds() {
    document.querySelectorAll(".ad-floating").forEach((container) => {
      const ads = Array.from(container.querySelectorAll("[data-floating-ad]"));

      if (!ads.length) return;

      // اختيار إعلان عشوائي واحد
      const randomIndex = Math.floor(Math.random() * ads.length);
      const selectedAd = ads[randomIndex];

      // حذف بقية الإعلانات
      ads.forEach((ad, index) => {
        if (index !== randomIndex) {
          ad.remove();
        }
      });

      // إظهار الإعلان المختار
      container.classList.remove("floating-pending");
      selectedAd.classList.add("is-selected");
    });
  }

  function initSideAds() {
    document.querySelectorAll(".ad-right, .ad-left").forEach((container) => {
      const ads = Array.from(container.querySelectorAll("[data-side-ad]"));

      if (!ads.length) {
        container.classList.remove("side-random-pending");
        return;
      }

      // اختيار إعلان عشوائي واحد لكل جانب
      const randomIndex = Math.floor(Math.random() * ads.length);

      // حذف بقية الإعلانات
      ads.forEach((ad, index) => {
        if (index !== randomIndex) {
          ad.remove();
        }
      });

      // إظهار الإعلان المختار
      container.classList.remove("side-random-pending");
    });
  }

  function initAllAds() {
    initFloatingAds();
    initSideAds();
  }

  function initPromoFloatingAd() {
    const ad = document.getElementById("mobile-floating-ad");
    if (!ad || ad.dataset.initialized === "1") return;

    ad.dataset.initialized = "1";

    const closedKey = "lolme-promo-floating-closed";

    try {
      if (sessionStorage.getItem(closedKey) === "1") return;
    } catch {}

    ad.querySelector(".promo-floating-ad__close")?.addEventListener(
      "click",
      () => {
        try {
          sessionStorage.setItem(closedKey, "1");
        } catch {}

        ad.classList.remove("is-visible");
        ad.classList.add("is-closing");

        ad.addEventListener(
          "animationend",
          () => {
            ad.remove();
          },
          { once: true },
        );
      },
    );

    window.setTimeout(() => {
      if (ad.isConnected) ad.classList.add("is-visible");
    }, 1800);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPromoFloatingAd, {
      once: true,
    });
  } else {
    initPromoFloatingAd();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAllAds, {
      once: true,
    });
  } else {
    initAllAds();
  }
</script>
<script type="module" src={`/js/ads.js?v=${v}`}></script>
<script type="module" src={`/js/adsGrid.js?v=${v}`}></script>
<script type="module" src={`/js/tilt-cards.js?v=${v}`}></script>
