<script>
  function initFloatingAds() {
    document
      .querySelectorAll<HTMLElement>(".ad-floating")
      .forEach((container) => {
        const ads = Array.from(
          container.querySelectorAll<HTMLElement>("[data-floating-ad]"),
        );

        if (!ads.length) return;

        const randomIndex = Math.floor(Math.random() * ads.length);
        const selectedAd = ads[randomIndex];

        ads.forEach((ad, index) => {
          if (index !== randomIndex) {
            ad.remove();
          }
        });

        selectedAd.classList.add("is-selected");
        container.classList.remove("floating-pending");
        container.dataset.adReady = "true";
      });
  }

  function initSideAds() {
    document
      .querySelectorAll<HTMLElement>(".ad-right, .ad-left")
      .forEach((container) => {
        const ads = Array.from(
          container.querySelectorAll<HTMLElement>("[data-side-ad]"),
        );

        if (!ads.length) return;

        const randomIndex = Math.floor(Math.random() * ads.length);
        const selectedAd = ads[randomIndex];

        ads.forEach((ad, index) => {
          if (index !== randomIndex) {
            ad.remove();
          }
        });

        selectedAd.classList.add("is-selected");
        container.classList.remove("side-random-pending");
        container.dataset.adReady = "true";
      });
  }

  function initAllAds() {
    initFloatingAds();
    initSideAds();
  }

  function initPromoFloatingAd() {
    const ad = document.getElementById("mobile-floating-ad");

    if (!ad || ad.dataset.initialized === "1") return;

    ad.dataset.initialized = "1";

    const closedKey = "lolme-promo-floating-closed";

    try {
      if (sessionStorage.getItem(closedKey) === "1") return;
    } catch {}

    ad.querySelector(".promo-floating-ad__close")?.addEventListener(
      "click",
      () => {
        try {
          sessionStorage.setItem(closedKey, "1");
        } catch {}

        ad.classList.remove("is-visible");
        ad.classList.add("is-closing");

        ad.addEventListener(
          "animationend",
          () => {
            ad.remove();
          },
          { once: true },
        );
      },
    );

    window.setTimeout(() => {
      if (ad.isConnected) {
        ad.classList.add("is-visible");
      }
    }, 1800);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPromoFloatingAd, {
      once: true,
    });

    document.addEventListener("DOMContentLoaded", initAllAds, {
      once: true,
    });
  } else {
    initPromoFloatingAd();
    initAllAds();
  }
</script>

