import { adsConfig } from "../data/adsConfig.js";
import AdBox from "./AdBox.astro";

const ua = Astro.request.headers.get("user-agent") || "";
const isMobile =
  /(Mobile|Android|iPhone|iPad|iPod|Opera Mini|IEMobile|WPDesktop)/i.test(ua);

type AdItem = {
  id: string;
  title?: string;
  desc?: string;
  img?: string;
  video?: string;
  link: string;
  cta?: string;
  closeable?: boolean;
  desktop?: boolean;
  every?: number;
};

const pickRandomAd = (ads: AdItem[]): AdItem | null => {
  if (!ads.length) return null;
  return ads[Math.floor(Math.random() * ads.length)];
};

// الإعلانات الداخلية الاحتياطية
const internalFallback =
  (
    adsConfig as typeof adsConfig & {
      internalFallback?: AdItem[];
    }
  ).internalFallback ?? [];

// تحديد محتوى كل مساحة حسب الأولوية
const resolveSlotAds = (primaryAds?: AdItem[]) => {
  if (primaryAds?.length) {
    return { ads: primaryAds, type: "house" as const };
  }

  if (internalFallback.length) {
    return { ads: internalFallback, type: "internal" as const };
  }

  return { ads: [], type: "reservation" as const };
};

const rightAds = resolveSlotAds(adsConfig.sideRight);
const leftAds = resolveSlotAds(adsConfig.sideLeft);
const floatingAds = resolveSlotAds(adsConfig.floating);

const v = Date.now();

const {
  showTop = true,
  showBottom = true,
  showSide = true,
  showFloating = true,
} = Astro.props;
