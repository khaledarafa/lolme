<script is:inline type="module">
  import { db, collection, query, where, getDocs } from "/js/firebase.js";

  async function loadCampaign(banner) {
    if (banner.dataset.campaignLoaded === "true") return;
    banner.dataset.campaignLoaded = "true";

    const slotId = banner.dataset.adSlot;

    try {
      console.log("[LOLME Ads] جاري البحث عن حملة للمساحة:", slotId);

      const campaignsQuery = query(
        collection(db, "adCampaigns"),
        where("slotId", "==", slotId),
        where("status", "==", "active"),
      );

      const snapshot = await getDocs(campaignsQuery);
      const now = Date.now();

      const campaigns = snapshot.docs
        .map((item) => ({
          id: item.id,
          ...item.data(),
        }))
        .filter((campaign) => {
          const start = campaign.startAt?.toDate?.()?.getTime();
          const end = campaign.endAt?.toDate?.()?.getTime();

          return (
            Number.isFinite(start) &&
            Number.isFinite(end) &&
            start <= now &&
            end > now &&
            typeof campaign.imageUrl === "string" &&
            typeof campaign.targetUrl === "string"
          );
        })
        .sort((a, b) => {
          const aCreated = a.createdAt?.toDate?.()?.getTime() || 0;
          const bCreated = b.createdAt?.toDate?.()?.getTime() || 0;
          return bCreated - aCreated;
        });

      console.log("[LOLME Ads] الحملات المؤهلة:", slotId, campaigns.length);

      const campaign = campaigns[0];
      if (!campaign) return;

      let imageUrl;
      let targetUrl;

      try {
        imageUrl = new URL(campaign.imageUrl);
        targetUrl = new URL(campaign.targetUrl);
      } catch {
        console.error("[LOLME Ads] رابط صورة أو وجهة غير صالح:", campaign.id);
        return;
      }

      if (!["https:", "http:"].includes(imageUrl.protocol)) return;
      if (!["https:", "http:"].includes(targetUrl.protocol)) return;

      const content = banner.querySelector(".advertise-banner__content");
      const art = banner.querySelector(".advertise-banner__art");
      const creative = banner.querySelector(".advertiser-creative");
      const link = creative?.querySelector(".advertiser-creative__link");
      const image = creative?.querySelector(".advertiser-creative__image");

      if (!content || !creative || !link || !image) return;

      image.onload = () => {
        content.hidden = true;
        if (art) art.hidden = true;

        creative.hidden = false;
        banner.dataset.adType = "advertiser";

        const label = banner.querySelector(".advertiser-label");
        if (label) label.hidden = false;
        banner.dataset.adCampaignId = campaign.id;

        link.href = targetUrl.href;
        link.dataset.adCampaignId = campaign.id;
        link.dataset.adSlot = slotId;
        link.dataset.adType = "advertiser";
      };

      image.onerror = () => {
        console.error("[LOLME Ads] فشل تحميل صورة الحملة:", campaign.id);
        image.removeAttribute("src");
      };

      link.href = targetUrl.href;
      link.dataset.adCampaignId = campaign.id;
      link.dataset.adSlot = slotId;
      link.dataset.adType = "advertiser";
      image.alt = `إعلان ${campaign.advertiserName || ""}`;
      image.src = imageUrl.href;
    } catch (error) {
      console.error("[LOLME Ads] تعذر قراءة Firestore للمساحة:", slotId, error);
    }
  }

  document
    .querySelectorAll(".advertise-banner[data-ad-slot]")
    .forEach((banner) => {
      loadCampaign(banner);
    });
</script>

