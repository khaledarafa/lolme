  }

  @media (max-width: 750px) {
    .stats-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats-header h2 {
      font-size: 19px;
    }

    .stat-card {
      padding: 14px;
    }

    .stat-card strong {
      font-size: 25px;
    }

