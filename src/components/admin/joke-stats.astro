<section class="joke-stats" dir="rtl">
  <header class="stats-header">
    <div>
      <h2>📊 إحصائيات النكت والتفاعلات</h2>
      <p>تابع تفاعل الزوار مع النكت يومًا بيوم.</p>
    </div>
  </header>

  <div class="stats-cards">
    <article class="stat-card laugh">
      <span>😂 الضحكات الحالية</span>
      <strong id="total-laugh">—</strong>
    </article>

    <article class="stat-card love">
      <span>❤️ الإعجابات الحالية</span>
      <strong id="total-love">—</strong>
    </article>

    <article class="stat-card not-funny">
      <span>😐 مش مضحكة</span>
      <strong id="total-not-funny">—</strong>
    </article>

    <article class="stat-card total">
      <span>🔥 إجمالي التفاعلات</span>
      <strong id="total-reactions">—</strong>
    </article>
  </div>

  <section class="stats-panel">
    <div class="panel-header">
      <h3>📈 سجل التفاعلات اليومية</h3>
      <select id="stats-period">
        <option value="7">آخر 7 أيام</option>
        <option value="30" selected>آخر 30 يومًا</option>
        <option value="90">آخر 90 يومًا</option>
      </select>
    </div>

    <div id="joke-stats-chart" class="chart-placeholder">
      <span>سيظهر الرسم البياني بعد تحميل البيانات اليومية.</span>
    </div>
  </section>

  <section class="stats-panel">
    <div class="panel-header">
      <h3>📝 تفاصيل التفاعلات حسب النكتة</h3>
      <input type="date" id="stats-date" />
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>النكتة</th>
            <th>😂 ضحكات</th>
            <th>❤️ إعجابات</th>
            <th>😐 مش مضحكة</th>
            <th>الإجمالي</th>
          </tr>
        </thead>
        <tbody id="joke-stats-table">
          <tr>
            <td colspan="5" class="empty-state">
              لم يتم تحميل البيانات بعد.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</section>
<script is:inline type="module" src="/js/admin/joke-stats.js"></script>

<style>
