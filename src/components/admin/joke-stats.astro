      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 400px) {
    .joke-stats {
      padding: 12px;
    }

    .stats-cards {
      gap: 10px;
    }

    .stat-card {
      padding: 12px;
    }
  }

