---
import Layout from "../layouts/Layout.astro";
---

<Layout title="حسابي" description="إدارة حسابك في LOLME">
  <section class="account-card">
    <h2>👤 حسابي في LOLME</h2>
    <p id="account-status">جاري التحقق من تسجيل الدخول...</p>

    <div id="account-details" hidden>
      <div class="account-info">
        <p>البريد الإلكتروني: <strong id="account-email"></strong></p>
        <p>طريقة الدخول: <strong id="account-provider"></strong></p>
      </div>

      <div class="advertiser-section">
        <div class="advertiser-icon">📢</div>
        <div class="advertiser-content">
          <h3>مساحة المعلنين</h3>
          <p>
            تابع حملاتك الإعلانية، وشاهد عدد مرات الظهور والنقرات وأداء إعلاناتك
            من مكان واحد.
          </p>
          <a href="/advertiser" class="advertiser-button">
            لوحة تحكم المعلن
            <span>←</span>
          </a>
        </div>
      </div>

      <button id="logout-button" type="button">تسجيل الخروج</button>
    </div>
  </section>

  <script type="module" src="/js/account.js"></script>

  <style>
    .account-card {
      max-width: 540px;
      margin: 24px auto;
      padding: 26px;
      border: 1px solid #374151;
      border-radius: 18px;
      background: #17212f;
      color: #fff;
      overflow-wrap: anywhere;
    }

    .account-info {
      margin-bottom: 24px;
    }

    .advertiser-section {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      padding: 20px;
      margin: 24px 0;
      border: 1px solid rgba(22, 199, 101, 0.3);
      border-radius: 14px;
      background: rgba(22, 199, 101, 0.07);
    }

    .advertiser-icon {
      font-size: 30px;
      flex-shrink: 0;
    }

    .advertiser-content {
      flex: 1;
    }

    .advertiser-content h3 {
      margin: 0 0 10px;
      font-size: 19px;
    }

    .advertiser-content p {
      margin: 0 0 18px;
      color: #cbd5e1;
      font-size: 14px;
      line-height: 1.8;
    }

    .advertiser-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 12px 20px;
      border: 1px solid #16c765;
      border-radius: 9px;
      background: rgba(22, 199, 101, 0.12);
      color: #4ade80;
      font-weight: 700;
      text-decoration: none;
      transition: 0.2s;
    }

    .advertiser-button:hover {
      background: #16c765;
      color: #06140b;
      transform: translateY(-2px);
    }

    .account-card button {
      padding: 12px 20px;
      border: 0;
      border-radius: 9px;
      background: #16c765;
      color: #06140b;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    @media (max-width: 480px) {
      .account-card {
        margin: 16px;
        padding: 20px;
      }

      .advertiser-section {
        padding: 15px;
      }
    }
  </style>
</Layout>
