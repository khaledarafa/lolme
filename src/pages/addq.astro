---
// src/pages/addq.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="إضافة سؤال">

  <div class="add-category-box">

    <h3>➕ إضافة فئة جديدة</h3>

    <input id="new-cat-name" placeholder="اسم الفئة" />
    <input id="new-cat-slug" style="display:none" />

    <select id="new-cat-group">
        <option value="football">⚽ كورة</option>
        <option value="songs">🎵 أغاني</option>
        <option value="brain">🧠 ذكاء</option>
        <option value="movies">🎬 ترفيه</option>
        <option value="products">🛍️ منتجات</option>
        <option value="mix">🌍 منوعات</option>
    </select>

    <input type="file" id="new-cat-image" />

    <button id="add-cat-btn">➕ إضافة الفئة</button>

    <p id="cat-msg"></p>

</div>

<div id="category-buttons" class="category-buttons"></div>
