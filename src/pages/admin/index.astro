---
import Layout from "../../layouts/Layout.astro";
import Review from "../../components/admin/review.astro";
import Addc from "../../components/admin/addc.astro";
import Addq from "../../components/admin/addq.astro";
import Rooms from "../../components/admin/rooms.astro";
---

<Layout title="لوحة التحكم">

  <!-- 🔥 Tabs فوق -->
  <div class="top-tabs">
    <button data-tab="addq" class="active">➕ إضافة سؤال</button>
    <button data-tab="addc">📁 إضافة فئة</button>
    <button data-tab="review">✅ مراجعة</button>
    <button data-tab="rooms">🎮 الغرف</button>
  </div>

  <!-- 🔥 Content -->
  <main class="content">
    <div class="content-inner">

      <div id="addq" class="tab active">
        <Addq />
      </div>

      <div id="addc" class="tab">
        <Addc />
      </div>

      <div id="review" class="tab">
        <Review />
      </div>

      <div id="rooms" class="tab">
        <Rooms />
      </div>

    </div>
  </main>

  <script type="module" src="/js/admin.js"></script>

  <!-- 🎨 Styles -->
  <style>

    /* 🔥 Tabs */
    .top-tabs {
      display: flex;
      gap: 10px;
      padding: 15px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .top-tabs button {
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-color);
      padding: 10px 15px;
      border-radius: 8px;
      cursor: pointer;
      transition: 0.2s;
    }

    .top-tabs button:hover {
      background: var(--btn-bg);
    }

    .top-tabs button.active {
      background: var(--btn-active-bg);
      color: var(--btn-active-text);
    }

    /* 🔥 Content */
    .content {
      display: flex;
      justify-content: center;
      padding: 20px;
    }

    .content-inner {
      width: 100%;
      max-width: 1200px;
    }

    /* 🔥 Tabs Content */
    .tab {
      display: none;
      background: var(--card);
      padding: 20px;
      border-radius: 12px;
      border: 1px solid var(--border-color);
      box-shadow: 0 0 10px var(--shadow-color);
    }

    .tab.active {
      display: block;
    }

    h3 {
      color: var(--h3);
      margin-top: 0;
    }

    /* 📱 Responsive */
    @media (max-width: 768px) {
      .top-tabs {
        justify-content: flex-start;
        overflow-x: auto;
      }

      .top-tabs button {
        white-space: nowrap;
      }
    }

  </style>

</Layout><!-- ---
