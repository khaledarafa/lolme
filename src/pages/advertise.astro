import Layout from "../layouts/Layout.astro";

const slots = [
  {
    id: "jokes-1",
    section: "jokes",
    number: "01",
    name: "بداية صفحة النكت والاختبارات",
    position: "المساحة الإعلانية الأولى",
    detail:
      "ظهور مميز في بداية صفحة النكت، ويظهر أيضًا في الصفحة الرئيسية للاختبارات قبل محتوى الصفحة.",
    price: 399,
    featured: true,
  },
  {
    id: "jokes-2",
    section: "jokes",
    number: "02",
    name: "الجزء الأول",
    position: "المساحة الإعلانية الثانية",
    detail: "إعلانك وسط بداية محتوى النكت.",
    price: 249,
  },
  {
    id: "jokes-3",
    section: "jokes",
    number: "03",
    name: "الثلث الأول",
    position: "المساحة الإعلانية الثالثة",
    detail: "مساحة إعلانية بين مجموعات النكت.",
    price: 199,
  },
  {
    id: "jokes-4",
    section: "jokes",
    number: "04",
    name: "قبل المنتصف",
    position: "المساحة الإعلانية الرابعة",
    detail: "روّج لمنتجك وسط محتوى ترفيهي.",
    price: 179,
  },
  {
    id: "jokes-5",
    section: "jokes",
    number: "05",
    name: "منتصف الصفحة",
    position: "المساحة الإعلانية الخامسة",
