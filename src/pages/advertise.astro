    detail: "مساحة إعلانية تظهر مع محتوى الاختبارات.",
    price: 249,
    featured: true,
  },
];

const formatPrice = (price: number) =>
  new Intl.NumberFormat("ar-EG").format(price);

const whatsappLink = (slot: (typeof slots)[number]) => {
  const message = [
    `مرحباً، أنا مهتم بحجز المساحة الإعلانية: ${slot.id}`,
    `الموقع: ${slot.position}`,
    `السعر: ${slot.price} جنيه لمدة 30 يومًا.`,
    "أريد معرفة تفاصيل الحجز والتوافر.",
  ].join("\n");

  return `https://wa.me/201002008305?text=${encodeURIComponent(message)}`;
};
const floatingSpaces = [
  {
    id: "floating-right",
    name: "المساحة العائمة اليمنى",
    title: "إعلانك على يمين الموقع",
    detail: "مساحة إعلانية ثابتة على الجانب الأيمن من صفحات الموقع.",
    position: "يمين الشاشة",
    icon: "➡️",
  },
  {
    id: "floating-left",
    name: "المساحة العائمة اليسرى",
    title: "إعلانك على يسار الموقع",
    detail: "مساحة إعلانية ثابتة على الجانب الأيسر من صفحات الموقع.",
    position: "يسار الشاشة",
    icon: "⬅️",
  },
  {
    id: "floating-main",
    name: "المساحة العائمة الرئيسية",
    title: "إعلانك أسفل يمين الموقع",
    detail:
      "إعلان عائم ثابت أسفل يمين الشاشة، يظهر أمام زوار الموقع أثناء تصفح الصفحات.",
    position: "أسفل يمين الشاشة",
    icon: "📍",
  },
];

const floatingWhatsappLink = (space: (typeof floatingSpaces)[number]) => {
  const message = [
    `مرحباً، أنا مهتم بحجز ${space.name}.`,
    `مكان الإعلان: ${space.position}.`,
    "السعر: 399 جنيه لمدة 30 يومًا.",
    "أريد معرفة تفاصيل الحجز والتوافر.",
  ].join("\n");

  return `https://wa.me/201002008305?text=${encodeURIComponent(message)}`;
};
---

<Layout
  title="حجز مساحات إعلانية على الإنترنت | أعلن على LOLME"
  description="احجز مساحة إعلانية على موقع LOLME لمدة 30 يومًا. اختر إعلانًا داخل محتوى النكت والاختبارات أو مساحة عائمة على الكمبيوتر، وتواصل معنا لمعرفة التوافر والأسعار."
>
  <main class="advertise-page" dir="rtl">
    <section class="advertise-hero">
      <span class="hero-eyebrow">📢 مساحات إعلانية متاحة للحجز</span>

      <h1>احجز مساحة إعلانية على LOLME وروّج لمشروعك 🚀</h1>

      <p>
        بتدور على مكان تعرض فيه منتجك أو خدمتك لجمهور جديد؟ يوفر لك LOLME مساحات
        إعلانية داخل صفحات النكت والاختبارات، بالإضافة إلى إعلانات عائمة ثابتة
        على الكمبيوتر. اختر موضع إعلانك واحجزه لمدة 30 يومًا.
      </p>

      <div class="hero-stats">
        <div>
          <strong>12</strong>
          <span>مساحة داخل المحتوى</span>
        </div>

        <div>
          <strong>3</strong>
          <span>مساحات عائمة للكمبيوتر</span>
        </div>

        <div>
          <strong>30</strong>
          <span>يوم مدة الحجز</span>
        </div>

        <div>
          <strong>15</strong>
          <span>مساحة إعلانية إجمالًا</span>
        </div>
      </div>

      <a href="#available-slots" class="hero-button">
        استعرض المساحات والأسعار ↓
      </a>
    </section>

    <section class="advertise-intro">
      <h2>اختر مكان ظهور إعلانك على LOLME</h2>
      <p>
        نوفر أكثر من طريقة للإعلان عن المنتجات والخدمات والمشروعات. يمكنك اختيار
        مساحة داخل محتوى الموقع أو حجز إعلان عائم يظهر في موضع ثابت أثناء تصفح
        الموقع من الكمبيوتر. تختلف الأسعار حسب موضع الإعلان، ويمكنك الاطلاع على
        التفاصيل قبل التواصل للحجز.
      </p>
    </section>

    <section class="floating-spaces-section" id="floating-spaces">
      <div class="floating-spaces-heading">
        <span>📢 مساحات مميزة على LOLME</span>
        <h2>احجز مساحتك الإعلانية العائمة</h2>
        <p>
          احجز إعلانًا في موضع ثابت على شاشة الكمبيوتر. تظهر المساحات العائمة في
          جميع صفحات LOLME أثناء التصفح، ولكل مساحة موضع مستقل وسعر محدد لمدة 30
          يومًا. هذه المساحات لا تظهر على الهواتف المحمولة.
        </p>
      </div>

      <div class="floating-spaces-grid">
        {
          floatingSpaces.map((space, index) => (
            <article
              class:list={[
                "floating-space-card",
                { "floating-space-card--featured": index === 2 },
              ]}
            >
              <div class="floating-space-visual">
                <div class="floating-space-mockup">
                  <div class="mockup-header">LOLME 🤣</div>
                  <div class="mockup-content">
                    <span>محتوى الموقع</span>
                    <div
                      class:list={[
                        "mockup-ad",
                        `mockup-ad--${index === 0 ? "right" : index === 1 ? "left" : "main"}`,
                      ]}
                    >
                      <span>📢</span>
                      إعلانك هنا
                    </div>
                  </div>
                </div>
              </div>

              <div class="floating-space-info">
                <span class="floating-space-number">
                  المساحة {String(index + 1).padStart(2, "0")}
                </span>

                <h3>{space.title}</h3>
                <p>{space.detail}</p>

                <div class="floating-space-position">📍 {space.position}</div>

                <div class="floating-space-price">
                  <strong>399 جنيه</strong>
                  <span> / 30 يومًا</span>
                </div>

                <a
                  href={floatingWhatsappLink(space)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="floating-space-button"
                >
                  احجز هذه المساحة ←
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <p class="floating-spaces-note">
        المساحات العائمة الثلاث تظهر في جميع صفحات LOLME على أجهزة الكمبيوتر
        فقط، ولكل مساحة موضع ثابت وإحصائيات مستقلة. سعر الحجز 399 جنيهًا لكل
        مساحة لمدة 30 يومًا.
      </p>
    </section>

    <section class="slots-section" id="available-slots">
      <div class="section-heading">
        <span>🤣 صفحة النكت</span>
        <h2>المساحات الإعلانية في النكت</h2>
        <p>11 مكانًا إعلانيًا موزعًا على محتوى الصفحة.</p>
      </div>

      <div class="live-preview">
        <div>
          <strong>👀 عايز تشوف المساحات على الطبيعة؟</strong>
          <p>اتفرج على أماكن ظهور الإعلانات بنفسك في صفحة النكت والاختبارات.</p>
        </div>

        <div class="live-preview__buttons">
          <a href="/jokes" target="_blank" rel="noopener noreferrer">
            🤣 مشاهدة صفحة النكت
            <span>↗</span>
          </a>

          <a href="/tests" target="_blank" rel="noopener noreferrer">
            🧠 مشاهدة صفحة الاختبارات
            <span>↗</span>
          </a>
        </div>
      </div>
      <div class="slots-grid">
        {
          slots
            .filter((slot) => slot.section === "jokes")
            .map((slot) => (
              <article
                class:list={[
                  "slot-card",
                  { "slot-card--featured": slot.featured },
                ]}
              >
                <div class="slot-card__top">
                  <span class="slot-number">#{slot.number}</span>
                  {slot.featured && (
                    <span class="slot-featured">موقع مميز</span>
                  )}
                </div>

                <h3>{slot.name}</h3>

                <p>{slot.detail}</p>

                <div class="slot-position">📍 {slot.position}</div>

                <div class="slot-price">
                  <strong>{formatPrice(slot.price)}</strong>
                  <span>جنيه / 30 يومًا</span>
                </div>

                <a
                  href={whatsappLink(slot)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="slot-button"
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="19"
                    height="19"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M20.52 3.48A11.86 11.86 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.15 1.6 5.96L0 24l6.31-1.65a11.9 11.9 0 0 0 5.73 1.46h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.17-3.42-8.44ZM12.05 21.8a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-3.75.98 1-3.65-.24-.38a9.88 9.88 0 1 1 8.4 4.65Zm5.42-7.4c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.8-1.49-1.78-1.67-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z" />
                  </svg>
                  احجز عبر واتساب
                </a>
              </article>
            ))
        }
      </div>
    </section>

    <section class="slots-section tests-slots">
      <div class="section-heading">
        <span>🧠 صفحة الاختبارات</span>
        <h2>المساحة الإعلانية في الاختبارات</h2>
        <p>مكان إعلاني داخل تجربة الاختبارات التفاعلية.</p>
      </div>

      {
        slots
          .filter((slot) => slot.section === "tests")
          .map((slot) => (
            <article class="slot-card slot-card--tests">
              <div class="slot-card__top">
                <span class="slot-number">#{slot.number}</span>
                <span class="slot-featured">مساحة متاحة</span>
              </div>

              <h3>{slot.name}</h3>

              <p>{slot.detail}</p>

              <div class="slot-position">📍 {slot.position}</div>

              <div class="slot-price">
                <strong>{formatPrice(slot.price)}</strong>
                <span>جنيه / 30 يومًا</span>
              </div>

              <a
                href={whatsappLink(slot)}
                target="_blank"
                rel="noopener noreferrer"
                class="slot-button"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="19"
                  height="19"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M20.52 3.48A11.86 11.86 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.15 1.6 5.96L0 24l6.31-1.65a11.9 11.9 0 0 0 5.73 1.46h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.17-3.42-8.44ZM12.05 21.8a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-3.75.98 1-3.65-.24-.38a9.88 9.88 0 1 1 8.4 4.65Zm5.42-7.4c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.8-1.49-1.78-1.67-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z" />
                </svg>
                احجز عبر واتساب
              </a>
            </article>
          ))
      }
    </section>

    <section class="advertise-faq" id="advertising-faq" dir="rtl">
      <h2>أسئلة شائعة عن حجز المساحات الإعلانية</h2>

      <div class="advertise-faq__item">
        <h3>إزاي أحجز مساحة إعلانية على LOLME؟</h3>
        <p>
          اختار المساحة المناسبة من الصفحة واضغط على زر الحجز، وسيتم توجيهك إلى
          واتساب للتواصل معنا ومعرفة التوافر واستكمال تفاصيل الإعلان.
        </p>
      </div>

      <div class="advertise-faq__item">
        <h3>مدة الإعلان على الموقع كام يوم؟</h3>
        <p>
          مدة الحجز الأساسية 30 يومًا، وتبدأ بعد تأكيد الحجز والاتفاق على موعد
          نشر الإعلان.
        </p>
      </div>

      <div class="advertise-faq__item">
        <h3>هل الإعلانات العائمة بتظهر على الموبايل؟</h3>
        <p>
          لا، المساحات الإعلانية العائمة الثلاث مخصصة لأجهزة الكمبيوتر، بينما
          تتوفر المساحات الإعلانية داخل محتوى النكت والاختبارات وفق مواضع
          ظهورها.
        </p>
      </div>

      <div class="advertise-faq__item">
        <h3>أسعار المساحات الإعلانية بتبدأ من كام؟</h3>
        <p>
          تبدأ أسعار المساحات داخل المحتوى من 79 جنيهًا لمدة 30 يومًا، وتبلغ
          أسعار المساحات العائمة 399 جنيهًا للمساحة الواحدة لمدة 30 يومًا.
        </p>
      </div>

      <div class="advertise-faq__item">
        <h3>هل أقدر أحجز أكثر من مساحة إعلانية؟</h3>
        <p>
          نعم، يمكنك طلب حجز أكثر من مساحة، ويخضع كل حجز لتأكيد توافر الموضع
          المطلوب.
        </p>
      </div>
    </section>

    <!-- بيانات FAQ المنظمة لمحركات البحث -->
