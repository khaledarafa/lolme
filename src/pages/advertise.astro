    detail: "مساحة إعلانية اقتصادية وسط المحتوى.",
    price: 109,
  },
  {
    id: "jokes-9",
    section: "jokes",
    number: "09",
    name: "الجزء الأخير",
    position: "المساحة الإعلانية التاسعة",
    detail: "فرصة إعلانية بسعر مناسب.",
    price: 99,
  },
  {
    id: "jokes-10",
    section: "jokes",
    number: "10",
