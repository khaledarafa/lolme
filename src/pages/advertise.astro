    position: "المساحة الإعلانية السابعة",
    detail: "إعلانك بين مجموعات النكت في الجزء الثاني.",
    price: 119,
  },
  {
    id: "jokes-8",
    section: "jokes",
    number: "08",
    name: "الثلث الأخير",
    position: "المساحة الإعلانية الثامنة",
    detail: "مساحة إعلانية اقتصادية وسط المحتوى.",
    price: 109,
  },
  {
    id: "jokes-9",
    section: "jokes",
    number: "09",
    name: "الجزء الأخير",
    position: "المساحة الإعلانية التاسعة",
    detail: "فرصة إعلانية بسعر مناسب.",
    price: 99,
  },
  {
    id: "jokes-10",
    section: "jokes",
    number: "10",
    name: "قبل النهاية",
    position: "المساحة الإعلانية العاشرة",
    detail: "مساحة إعلانية اقتصادية في الجزء الأخير.",
    price: 89,
  },
  {
    id: "jokes-11",
    section: "jokes",
    number: "11",
    name: "نهاية الصفحة",
    position: "المساحة الإعلانية الحادية عشرة",
    detail: "أقل سعر إعلاني ضمن مساحات صفحة النكت.",
    price: 79,
  },
  {
    id: "tests",
    section: "tests",
    number: "12",
    name: "نهاية صفحة الاختبارات",
    position: "المساحة الإعلانية في الاختبارات",
    detail: "مساحة إعلانية تظهر مع محتوى الاختبارات.",
    price: 249,
    featured: true,
  },
];

const formatPrice = (price: number) =>
  new Intl.NumberFormat("ar-EG").format(price);

const whatsappLink = (slot: (typeof slots)[number]) => {
  const message = [
    `مرحباً، أنا مهتم بحجز المساحة الإعلانية: ${slot.id}`,
    `الموقع: ${slot.position}`,
    `السعر: ${slot.price} جنيه لمدة 30 يومًا.`,
    "أريد معرفة تفاصيل الحجز والتوافر.",
  ].join("\n");

  return `https://wa.me/201002008305?text=${encodeURIComponent(message)}`;
};
---

<Layout
  title="أعلن على LOLME | المساحات الإعلانية المتاحة"
  description="اكتشف المساحات الإعلانية المتاحة على LOLME، أماكن ظهور الإعلانات وأسعار الحجز لمدة 30 يومًا."
>
  <main class="advertise-page" dir="rtl">
    <section class="advertise-hero">
      <span class="hero-eyebrow">📢 فرصتك للإعلان على LOLME</span>

      <h1>LOLME بيكبر كل يوم.. إكبر معانا! 🚀</h1>

      <p>
        مجتمعنا بيزيد، وزياراتنا بتكبر، ودي فرصتك تكون من أوائل العلامات
        التجارية اللي تنضم لرحلتنا.
      </p>

      <div class="hero-stats">
        <div>
          <strong>12</strong>
          <span>مساحة إعلانية</span>
        </div>

        <div>
          <strong>30</strong>
          <span>يوم مدة الإعلان</span>
        </div>

        <div>
          <strong>79 ج</strong>
          <span>أقل سعر للحجز</span>
        </div>
      </div>

      <a href="#available-slots" class="hero-button">
        اكتشف المساحات المتاحة ↓
      </a>
    </section>

    <section class="advertise-intro">
      <h2>اختار المكان المناسب لإعلانك</h2>
      <p>
        وفرنا لك مجموعة من المساحات الإعلانية داخل صفحات LOLME. تقدر تختار مكان
        ظهور إعلانك حسب ميزانيتك والموضع اللي يناسبك.
      </p>
    </section>

    <section class="slots-section" id="available-slots">
      <div class="section-heading">
        <span>🤣 صفحة النكت</span>
        <h2>المساحات الإعلانية في النكت</h2>
        <p>11 مكانًا إعلانيًا موزعًا على محتوى الصفحة.</p>
      </div>

<div class="live-preview">
  <div>
    <strong>👀 عايز تشوف المساحات على الطبيعة؟</strong>
    <p>اتفرج على أماكن ظهور الإعلانات بنفسك في صفحة النكت والاختبارات.</p>
  </div>

  <div class="live-preview__buttons">
    <a href="/jokes" target="_blank" rel="noopener noreferrer">
      🤣 مشاهدة صفحة النكت
      <span>↗</span>
    </a>

    <a href="/tests" target="_blank" rel="noopener noreferrer">
      🧠 مشاهدة صفحة الاختبارات
      <span>↗</span>
    </a>
  </div>
</div>
      <div class="slots-grid">
        {
          slots
            .filter((slot) => slot.section === "jokes")
            .map((slot) => (
              <article
                class:list={[
                  "slot-card",
                  { "slot-card--featured": slot.featured },
                ]}
              >
                <div class="slot-card__top">
                  <span class="slot-number">#{slot.number}</span>
                  {slot.featured && (
                    <span class="slot-featured">موقع مميز</span>
                  )}
                </div>

                <h3>{slot.name}</h3>

                <p>{slot.detail}</p>

                <div class="slot-position">📍 {slot.position}</div>

                <div class="slot-price">
                  <strong>{formatPrice(slot.price)}</strong>
                  <span>جنيه / 30 يومًا</span>
                </div>

                <a
                  href={whatsappLink(slot)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="slot-button"
                >
<svg
  viewBox="0 0 24 24"
  width="19"
  height="19"
  fill="currentColor"
  aria-hidden="true"
>
  <path d="M20.52 3.48A11.86 11.86 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.15 1.6 5.96L0 24l6.31-1.65a11.9 11.9 0 0 0 5.73 1.46h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.17-3.42-8.44ZM12.05 21.8a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-3.75.98 1-3.65-.24-.38a9.88 9.88 0 1 1 8.4 4.65Zm5.42-7.4c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.8-1.49-1.78-1.67-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"/>
</svg>
احجز عبر واتساب
                </a>
              </article>
            ))
        }
      </div>
    </section>

    <section class="slots-section tests-slots">
      <div class="section-heading">
        <span>🧠 صفحة الاختبارات</span>
        <h2>المساحة الإعلانية في الاختبارات</h2>
        <p>مكان إعلاني داخل تجربة الاختبارات التفاعلية.</p>
      </div>

      {
        slots
          .filter((slot) => slot.section === "tests")
          .map((slot) => (
            <article class="slot-card slot-card--tests">
              <div class="slot-card__top">
                <span class="slot-number">#{slot.number}</span>
                <span class="slot-featured">مساحة متاحة</span>
              </div>

              <h3>{slot.name}</h3>

              <p>{slot.detail}</p>

              <div class="slot-position">📍 {slot.position}</div>

              <div class="slot-price">
                <strong>{formatPrice(slot.price)}</strong>
                <span>جنيه / 30 يومًا</span>
              </div>

              <a
                href={whatsappLink(slot)}
                target="_blank"
                rel="noopener noreferrer"
                class="slot-button"
              >
<svg
  viewBox="0 0 24 24"
  width="19"
  height="19"
  fill="currentColor"
  aria-hidden="true"
>
  <path d="M20.52 3.48A11.86 11.86 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.15 1.6 5.96L0 24l6.31-1.65a11.9 11.9 0 0 0 5.73 1.46h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.17-3.42-8.44ZM12.05 21.8a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-3.75.98 1-3.65-.24-.38a9.88 9.88 0 1 1 8.4 4.65Zm5.42-7.4c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.8-1.49-1.78-1.67-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"/>
</svg>
احجز عبر واتساب
              </a>
            </article>
          ))
      }
    </section>

<section class="advertise-bottom">
  <span>🚀</span>

  <h2>اختر مساحتك الإعلانية وابدأ مع LOLME!</h2>

  <p>
    تصفّح المساحات المتاحة، واختر المكان المناسب لإعلانك،
    ثم اضغط على زر الحجز في المساحة التي اخترتها للتواصل معنا عبر واتساب.
  </p>

  <a href="#available-slots">
    اختار مساحتك الإعلانية
    <span> ↑ </span>
  </a>
</section>

    <p class="advertise-note">
      جميع الأسعار بالجنيه المصري، ومدة الحجز 30 يومًا. الحجز يخضع لتأكيد توافر
      المساحة.
    </p>
  </main>
</Layout>

<style>
  .advertise-page {
    max-width: 1100px;
    margin: 35px auto;
    padding: 0 16px 40px;
    color: var(--text-color);
  }

  .advertise-hero {
    padding: 45px 25px;
    text-align: center;
    color: #fff;
    border-radius: 22px;
    background: linear-gradient(120deg, #111827, #312e81 65%, #6d28d9);
    border: 1px solid rgba(139, 92, 246, 0.4);
  }

  .hero-eyebrow {
    color: #fde68a;
    font-weight: 700;
  }

  .advertise-hero h1 {
    margin: 15px 0;
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    line-height: 1.5;
  }

  .advertise-hero > p {
    max-width: 650px;
    margin: 0 auto;
    color: #e5e7eb;
    line-height: 1.9;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 35px;
    margin: 30px 0;
  }

  .hero-stats div {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .hero-stats strong {
    color: #fde68a;
    font-size: 1.7rem;
  }

  .hero-stats span {
    color: #e5e7eb;
    font-size: 0.85rem;
  }

  .hero-button,
  .advertise-bottom a {
    display: inline-block;
    padding: 13px 23px;
    color: #fff;
    background: #16a34a;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
  }

  .advertise-intro {
    margin: 45px 0 30px;
    text-align: center;
  }

  .advertise-intro h2,
  .section-heading h2 {
    margin-bottom: 10px;
  }

  .advertise-intro p,
  .section-heading p {
    color: var(--text-secondary, #94a3b8);
    line-height: 1.8;
  }

  .section-heading {
    margin: 40px 0 20px;
    text-align: center;
  }

  .section-heading > span {
    color: #8b5cf6;
    font-weight: 700;
  }

  .slots-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .slot-card {
    display: flex;
    flex-direction: column;
    padding: 20px;
    border-radius: 16px;
    background: var(--card-bg, var(--bg-color));
    border: 1px solid var(--border-color, rgba(148, 163, 184, 0.2));
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.06);
    text-align: right;
  }

  .slot-card--featured {
    border-color: #8b5cf6;
  }

  .slot-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .slot-number {
    color: #8b5cf6;
    font-weight: 800;
    font-size: 1.1rem;
  }

  .slot-featured {
    padding: 5px 9px;
    border-radius: 20px;
    color: #fde68a;
    background: rgba(139, 92, 246, 0.15);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .slot-card h3 {
    margin: 18px 0 8px;
    font-size: 1.1rem;
  }

  .slot-card > p {
    min-height: 50px;
    margin: 0;
    color: var(--text-secondary, #94a3b8);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .slot-position {
    margin-top: 15px;
    color: var(--text-secondary, #94a3b8);
    font-size: 0.8rem;
  }

  .slot-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    margin: 20px 0;
  }

  .slot-price strong {
    color: #8b5cf6;
    font-size: 1.8rem;
  }

  .slot-price span {
    color: var(--text-secondary, #94a3b8);
    font-size: 0.8rem;
  }

  .slot-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: auto;
    padding: 12px;
    color: #fff;
    background: #16a34a;
    border-radius: 9px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .slot-button:hover {
    background: #15803d;
  }

  .tests-slots {
    margin-top: 50px;
  }

  .slot-card--tests {
    max-width: 420px;
    margin: 0 auto;
  }

  .advertise-bottom {
    margin-top: 55px;
    padding: 35px 20px;
    text-align: center;
    color: #fff;
    border-radius: 18px;
    background: linear-gradient(120deg, #111827, #312e81 65%, #6d28d9);
  }

  .advertise-bottom > span {
    font-size: 2.5rem;
  }

  .advertise-bottom h2 {
    font-size: 1.5rem;
    line-height: 1.7;
  }

  .advertise-bottom p {
    color: #e5e7eb;
    line-height: 1.8;
  }

  .advertise-note {
    margin-top: 20px;
    color: var(--text-secondary, #94a3b8);
    font-size: 0.8rem;
    text-align: center;
  }

  @media (max-width: 800px) {
    .slots-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .advertise-hero {
      padding: 30px 16px;
    }

    .hero-stats {
      gap: 20px;
    }

    .slots-grid {
      grid-template-columns: 1fr;
    }

    .slot-card > p {
      min-height: auto;
    }
  }

  .live-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  flex-wrap: wrap;
  margin: 20px 0;
  padding: 18px 20px;
  background: rgba(139, 92, 246, 0.08);
  border: 1px solid rgba(139, 92, 246, 0.3);
  border-radius: 14px;
}

.live-preview strong {
  color: var(--text-color);
  font-size: 1rem;
}

.live-preview p {
  margin: 6px 0 0;
  color: var(--text-secondary, #94a3b8);
  font-size: 0.85rem;
}

.live-preview__buttons {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.live-preview__buttons a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 11px 16px;
  background: #6d28d9;
  color: #fff;
  border-radius: 9px;
  text-decoration: none;
  font-weight: 700;
  white-space: nowrap;
  transition: background 0.2s ease;
}

.live-preview__buttons a:hover {
  background: #5b21b6;
}

@media (max-width: 600px) {
  .live-preview {
    flex-direction: column;
    align-items: stretch;
    text-align: center;
  }

  .live-preview__buttons {
    flex-direction: column;
  }

  .live-preview__buttons a {
    width: 100%;
    box-sizing: border-box;
  }
}
</style>
