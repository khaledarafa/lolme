---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="لوحة المعلن"
  description="تابع حملاتك الإعلانية وأداء إعلاناتك على LOLME"
>
  <section class="advertiser-dashboard" dir="rtl">
    <header class="dashboard-header">
      <div>
        <span class="dashboard-eyebrow">LOLME ADVERTISER</span>
        <h2>📊 لوحة المعلن</h2>
        <p>تابع أداء حملاتك الإعلانية من مكان واحد.</p>
      </div>
      <button id="advertiser-logout" type="button"> تسجيل الخروج </button>
    </header>

    <section class="stats-guide">
      <div class="stats-guide-header">
        <span>📈</span>
        <div>
          <h3>كيف نحسب إحصائيات إعلانك؟</h3>
          <p>توضيح مبسط للأرقام التي تظهر في لوحة التحكم.</p>
        </div>
      </div>

      <div class="stats-guide-grid">
        <article class="stats-guide-item">
          <strong>👁️ مرات الظهور</strong>
          <p>
            إجمالي عدد مرات مشاهدة إعلانك. تُحتسب مشاهدة جديدة في كل مرة يظهر
            فيها الإعلان بنسبة 50% على الأقل لمدة ثانية متواصلة. ويمكن احتساب
            أكثر من مشاهدة من الزائر نفسه.
          </p>
        </article>

        <article class="stats-guide-item">
          <strong>👥 الزوار المختلفون</strong>
          <p>
            عدد المتصفحات المختلفة التي شاهدت إعلانك خلال فترة الحملة. يُحتسب
            الزائر مرة واحدة فقط، حتى لو شاهد الإعلان مرات عديدة.
          </p>
        </article>

        <article class="stats-guide-item">
          <strong>🖱️ النقرات</strong>
          <p>
            عدد مرات النقر على رابط إعلانك. يتم تسجيل النقرة عند ضغط الزائر على
            رابط الإعلان.
          </p>
        </article>

        <article class="stats-guide-item">
          <strong>📊 معدل النقر (CTR)</strong>
          <p>
            النسبة المئوية للنقرات مقارنة بمرات الظهور. كلما ارتفع المعدل، زادت
            نسبة التفاعل مع إعلانك.
          </p>
        </article>
      </div>

      <div class="stats-guide-note">
        <strong>💡 مثال توضيحي:</strong>
        <p>
          إذا شاهد 100 زائر مختلف إعلانك، وشاهده بعضهم أكثر من مرة، فقد تكون
          النتيجة 250 مرة ظهور و100 زائر مختلف. هذا يعني أن الإعلان ظهر 250 مرة
          أمام 100 زائر مختلف.
        </p>
      </div>

      <div class="stats-guide-footer">
        يتم تحديث الإحصائيات عند تحميل لوحة التحكم أو الضغط على زر التحديث. وقد
        تختلف الأرقام عن عدد الأشخاص الحقيقيين؛ لأن القياس يعتمد على المتصفح أو
        الجهاز المستخدم.
      </div>
    </section>

    <div id="advertiser-status" class="dashboard-message">
      جاري التحقق من الحساب...
    </div>

    <div id="advertiser-content" hidden>
      <div class="advertiser-welcome">
        <div>
          <span>مرحبًا بك</span>
          <h3 id="advertiser-name">المعلن</h3>
          <p id="advertiser-email"></p>
        </div>
        <span class="account-badge">حساب معلن</span>
      </div>

      <div class="advertiser-stats">
        <article class="stat-card">
          <span>مرات الظهور</span>
          <strong id="total-impressions">0</strong>
        </article>

        <article class="stat-card">
          <span>الزوار المختلفون</span>
          <strong id="total-unique-visitors">0</strong>
        </article>

        <article class="stat-card">
          <span>النقرات</span>
          <strong id="total-clicks">0</strong>
        </article>

        <article class="stat-card">
          <span>معدل النقر CTR</span>
          <strong id="total-ctr">0%</strong>
        </article>

        <article class="stat-card">
          <span>الحملات</span>
          <strong id="total-campaigns">0</strong>
        </article>
      </div>

      <section class="campaign-section">
        <div class="section-heading">
          <div>
            <h3>📢 حملاتي الإعلانية</h3>
            <p>تفاصيل الحملات المسجلة على حسابك.</p>
          </div>
          <button id="advertiser-refresh" type="button"> ↻ تحديث </button>
        </div>

        <div id="advertiser-campaigns"></div>
      </section>
    </div>
  </section>

  <script type="module" src="/js/advertiser.js"></script>

  <style>
    .advertiser-dashboard {
      max-width: 1100px;
      margin: 25px auto;
      padding: clamp(14px, 3vw, 28px);
      color: #f9fafb;
      background: #1e293b;
      border: 1px solid rgba(139, 92, 246, 0.3);
      border-radius: 18px;
      box-sizing: border-box;
    }

    .dashboard-header,
    .section-heading,
    .advertiser-welcome {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .dashboard-header h2 {
      margin: 7px 0;
      color: #fff;
    }

    .dashboard-header p,
    .section-heading p {
      color: #94a3b8;
      margin: 5px 0;
    }

    .dashboard-eyebrow {
      color: #a78bfa;
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .advertiser-dashboard button {
      border: 0;
      border-radius: 9px;
      padding: 10px 15px;
      background: #4f46e5;
      color: white;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .advertiser-dashboard button:disabled {
      opacity: 0.6;
      cursor: wait;
    }

    #advertiser-logout {
      background: #374151;
    }

    .dashboard-message {
      margin: 20px 0;
      padding: 14px;
      border-radius: 10px;
      background: #111827;
      color: #cbd5e1;
      line-height: 1.8;
    }

    .advertiser-welcome {
      padding: 20px;
      margin: 22px 0;
      background: #111827;
      border: 1px solid #374151;
      border-radius: 13px;
    }

    .advertiser-welcome h3 {
      margin: 5px 0;
      color: #fde68a;
    }

    .advertiser-welcome p {
      margin: 0;
      color: #94a3b8;
      overflow-wrap: anywhere;
    }

    .account-badge {
      padding: 7px 12px;
      color: #86efac;
      background: #14532d;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 700;
    }

    .advertiser-stats {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 12px;
      margin: 20px 0 30px;
    }

    .stat-card {
      padding: 20px 12px;
      text-align: center;
      background: #273449;
      border: 1px solid #374151;
      border-radius: 12px;
    }

    .stat-card span {
      display: block;
      color: #cbd5e1;
      font-size: 0.9rem;
    }

    .stat-card strong {
      display: block;
      margin-top: 10px;
      color: #4ade80;
      font-size: 1.7rem;
    }

    .campaign-section {
      margin-top: 25px;
    }

    .section-heading {
      margin-bottom: 18px;
    }

    .section-heading h3 {
      margin: 0;
      color: #fde68a;
    }

    #advertiser-campaigns {
      display: grid;
      gap: 15px;
    }

    .advertiser-campaign-card {
      padding: 18px;
      background: #111827;
      border: 1px solid #374151;
      border-radius: 13px;
      min-width: 0;
    }

    .advertiser-campaign-card h4 {
      margin: 0 0 8px;
      color: #fde68a;
      overflow-wrap: anywhere;
    }

    .campaign-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      color: #cbd5e1;
      font-size: 0.9rem;
      line-height: 1.8;
    }

    .campaign-numbers {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin-top: 16px;
    }

    .campaign-number {
      padding: 12px;
      text-align: center;
      background: #273449;
      border-radius: 9px;
    }

    .campaign-number span {
      display: block;
      color: #94a3b8;
      font-size: 0.82rem;
    }

    .campaign-number strong {
      display: block;
      margin-top: 5px;
      color: #4ade80;
      font-size: 1.2rem;
    }

    .campaign-details {
      margin-top: 15px;
      padding-top: 13px;
      border-top: 1px solid #374151;
    }

    .campaign-details summary {
      color: #a78bfa;
      font-weight: 700;
      cursor: pointer;
    }

    .campaign-details table {
      width: 100%;
      margin-top: 12px;
      border-collapse: collapse;
      text-align: center;
    }

    .campaign-details th,
    .campaign-details td {
      padding: 9px 5px;
      border-bottom: 1px solid #374151;
      font-size: 0.85rem;
    }

    .campaign-details th {
      color: #fde68a;
    }

    .campaign-empty {
      padding: 25px;
      text-align: center;
      color: #cbd5e1;
      background: #111827;
      border-radius: 12px;
      line-height: 1.9;
    }

    @media (max-width: 650px) {
      .advertiser-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .campaign-numbers {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .campaign-details {
        overflow-x: auto;
      }
    }

    .stats-guide {
      margin: 25px 0 30px;
      padding: 22px;
      background: #111827;
      border: 1px solid #374151;
      border-radius: 14px;
    }

    .stats-guide-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }

    .stats-guide-header > span {
      font-size: 28px;
    }

    .stats-guide-header h3 {
      margin: 0 0 5px;
      color: #fde68a;
    }

    .stats-guide-header p {
      margin: 0;
      color: #94a3b8;
      font-size: 0.9rem;
    }

    .stats-guide-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .stats-guide-item {
      padding: 15px;
      background: #273449;
      border: 1px solid #374151;
      border-radius: 10px;
    }

    .stats-guide-item strong {
      display: block;
      margin-bottom: 9px;
      color: #a78bfa;
    }

    .stats-guide-item p {
      margin: 0;
      color: #cbd5e1;
      font-size: 0.9rem;
      line-height: 1.9;
    }

    .stats-guide-note {
      margin-top: 15px;
      padding: 15px;
      background: rgba(22, 199, 101, 0.07);
      border: 1px solid rgba(22, 199, 101, 0.25);
      border-radius: 10px;
    }

    .stats-guide-note strong {
      color: #4ade80;
    }

    .stats-guide-note p {
      margin: 7px 0 0;
      color: #cbd5e1;
      font-size: 0.9rem;
      line-height: 1.9;
    }

    .stats-guide-footer {
      margin-top: 15px;
      color: #94a3b8;
      font-size: 0.82rem;
      line-height: 1.8;
    }

    @media (max-width: 650px) {
      .stats-guide-grid {
        grid-template-columns: 1fr;
      }

      .stats-guide {
        padding: 16px;
      }
    }

    /* إحصائيات الإعلان حسب مكان ظهوره */

    :global(.placement-stats) {
      display: block;
      width: 100%;
      box-sizing: border-box;
      margin-top: 22px;
      padding: 20px;
      background: #172033;
      border: 1px solid #374151;
      border-radius: 14px;
      text-align: right;
    }

    :global(.placement-stats > h4) {
      margin: 0 0 20px;
      color: #fde68a;
      font-size: 1.1rem;
      text-align: right;
    }

    :global(.placement-card) {
      display: block;
      width: 100%;
      box-sizing: border-box;
      padding: 18px;
      margin-top: 14px;
      background: #273449;
      border: 1px solid #3b4b63;
      border-radius: 12px;
      text-align: right;
    }

    :global(.placement-card h5) {
      margin: 0 0 16px;
      padding-bottom: 12px;
      color: #4ade80;
      font-size: 1rem;
      border-bottom: 1px solid #475569;
    }

    :global(.placement-numbers) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    :global(.placement-number) {
      min-width: 0;
      box-sizing: border-box;
      padding: 16px 10px;
      text-align: center;
      background: #111827;
      border: 1px solid #374151;
      border-radius: 10px;
    }

    :global(.placement-number span) {
      display: block;
      color: #cbd5e1;
      font-size: 0.85rem;
      line-height: 1.6;
    }

    :global(.placement-number strong) {
      display: block;
      margin-top: 9px;
      color: #4ade80;
      font-size: 1.5rem;
      font-weight: 800;
      direction: ltr;
    }

    :global(.placement-empty) {
      padding: 15px;
      color: #cbd5e1;
      background: #273449;
      border-radius: 9px;
      line-height: 1.8;
    }

    @media (max-width: 650px) {
      :global(.placement-numbers) {
        grid-template-columns: 1fr;
      }

      :global(.placement-stats) {
        padding: 13px;
      }

      :global(.placement-card) {
        padding: 13px;
      }
    }

    /* =========================================
   ADVERTISER DASHBOARD
   Unified typography and components with Admin
========================================= */

    .advertiser-dashboard {
      font-family: inherit;
      line-height: 1.7;
    }

    /* العناوين الرئيسية */

    .advertiser-dashboard h2 {
      font-size: clamp(1.4rem, 3vw, 1.9rem);
      line-height: 1.5;
    }

    .advertiser-dashboard h3 {
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .dashboard-header p,
    .section-heading p {
      font-size: 0.92rem;
      line-height: 1.8;
    }

    /* البطاقات الرئيسية */

    .stat-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 9px;
      min-width: 0;
      padding: 17px 12px;
      background: #273449;
      border: 1px solid #334155;
      border-radius: 12px;
    }

    .stat-card span {
      color: #cbd5e1;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .stat-card strong {
      margin: 0;
      color: #4ade80;
      font-size: clamp(1.3rem, 3vw, 1.8rem);
      font-weight: 800;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    /* قسم شرح الإحصائيات */

    .stats-guide {
      padding: 22px;
      background: #111827;
      border: 1px solid #475569;
      border-radius: 14px;
    }

    .stats-guide-header h3 {
      font-size: 1.1rem;
    }

    .stats-guide-header p {
      font-size: 0.88rem;
      line-height: 1.8;
    }

    .stats-guide-item strong {
      font-size: 0.95rem;
    }

    .stats-guide-item p,
    .stats-guide-note p {
      font-size: 0.9rem;
      line-height: 1.8;
    }

    .stats-guide-footer {
      font-size: 0.85rem;
      line-height: 1.8;
    }

    /* عنوان الحملات */

    .section-heading {
      margin-bottom: 18px;
    }

    .section-heading h3 {
      margin: 0;
      color: #fde68a;
      font-size: 1.15rem;
    }

    .section-heading p {
      margin: 5px 0;
    }

    /* بطاقة الحملة */

    :global(.advertiser-campaign-card) {
      display: flex;
      flex-direction: column;
      gap: 16px;
      box-sizing: border-box;
      min-width: 0;
      padding: 20px;
      margin: 0;
      color: #e5e7eb;
      background: linear-gradient(145deg, #111827, #273449);
      border: 1px solid #475569;
      border-radius: 15px;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.16);
    }

    :global(.advertiser-campaign-card h4) {
      margin: 0;
      padding-bottom: 12px;
      color: #fde68a;
      font-size: 1.15rem;
      line-height: 1.7;
      border-bottom: 1px solid #475569;
      overflow-wrap: anywhere;
    }

    /* معلومات الحملة */

    :global(.campaign-meta) {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      padding: 12px 14px;
      color: #cbd5e1;
      background: #172033;
      border: 1px solid #374151;
      border-radius: 10px;
      font-size: 0.88rem;
      line-height: 1.8;
      overflow-wrap: anywhere;
    }

    /* أرقام الحملة الرئيسية */

    :global(.campaign-numbers) {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      margin-top: 0;
    }

    :global(.campaign-number) {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-width: 0;
      padding: 17px 10px;
      text-align: center;
      background: #111827;
      border: 1px solid #374151;
      border-radius: 10px;
    }

    :global(.campaign-number span) {
      color: #cbd5e1;
      font-size: 0.85rem;
      line-height: 1.6;
    }

    :global(.campaign-number strong) {
      margin: 0;
      color: #4ade80;
      font-size: 1.5rem;
      font-weight: 800;
      line-height: 1.4;
      direction: ltr;
      overflow-wrap: anywhere;
    }

    /* الأداء اليومي */

    :global(.campaign-details) {
      margin: 0;
      padding: 15px;
      background: #111827;
      border: 1px solid #374151;
      border-radius: 10px;
    }

    :global(.campaign-details summary) {
      padding: 5px;
      color: #c4b5fd;
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.8;
      cursor: pointer;
    }

    :global(.campaign-details[open] summary) {
      margin-bottom: 15px;
      padding-bottom: 12px;
      border-bottom: 1px solid #374151;
    }

    :global(.campaign-details table) {
      width: 100%;
      min-width: 550px;
      margin-top: 10px;
      border-collapse: collapse;
      text-align: center;
    }

    :global(.campaign-details th),
    :global(.campaign-details td) {
      padding: 13px 12px;
      color: #e5e7eb;
      border-bottom: 1px solid #475569;
      font-size: 0.88rem;
      line-height: 1.6;
      white-space: nowrap;
    }

    :global(.campaign-details th) {
      color: #fde68a;
    }

    /* تمرير جدول الأداء اليومي */

    :global(.campaign-details[open]) {
      overflow-x: auto;
    }

    /* إحصائيات الإعلان حسب الصفحة */

    :global(.placement-stats) {
      display: flex;
      flex-direction: column;
      gap: 15px;
      width: 100%;
      box-sizing: border-box;
      margin: 0;
      padding: 18px;
      background: #172033;
      border: 1px solid #475569;
      border-radius: 12px;
    }

    :global(.placement-stats > h4) {
      margin: 0;
      padding-bottom: 12px;
      color: #fde68a;
      font-size: 1rem;
      line-height: 1.7;
      border-bottom: 1px solid #475569;
    }

    :global(.placement-card) {
      box-sizing: border-box;
      width: 100%;
      min-width: 0;
      padding: 17px;
      margin: 0;
      background: #273449;
      border: 1px solid #475569;
      border-radius: 11px;
    }

    :global(.placement-card h5) {
      margin: 0 0 15px;
      padding-bottom: 12px;
      color: #4ade80;
      font-size: 0.95rem;
      line-height: 1.7;
      border-bottom: 1px solid #475569;
    }

    :global(.placement-numbers) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 9px;
    }

    :global(.placement-number) {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-width: 0;
      padding: 13px 6px;
      text-align: center;
      background: #111827;
      border: 1px solid #374151;
      border-radius: 8px;
    }

    :global(.placement-number span) {
      color: #cbd5e1;
      font-size: 0.78rem;
      line-height: 1.6;
    }

    :global(.placement-number strong) {
      color: #4ade80;
      font-size: 1.2rem;
      font-weight: 800;
      line-height: 1.4;
      direction: ltr;
      overflow-wrap: anywhere;
    }

    /* رسائل عدم وجود بيانات */

    :global(.campaign-empty),
    :global(.placement-empty) {
      padding: 18px;
      color: #cbd5e1;
      background: #111827;
      border: 1px solid #374151;
      border-radius: 10px;
      font-size: 0.9rem;
      line-height: 1.9;
    }

    /* تحسين المسافات */

    :global(.advertiser-campaign-card > *) {
      max-width: 100%;
    }

    /* الشاشات المتوسطة */

    @media (max-width: 750px) {
      .advertiser-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      :global(.campaign-numbers) {
