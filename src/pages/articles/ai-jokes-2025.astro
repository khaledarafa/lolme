---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Comments from "../../components/Comments.astro";
export const frontmatter = {
title: "نكت 2025: الذكاء الاصطناعي بيهزر هو كمان 🤖😂",
description: "نكت جديدة ومضحكة لعام 2025 كتبها البشر والذكاء الصناعي سوا! ضحك متواصل ومواقف غريبة جدًا بين الإنسان والآلة 😂",
image: "/images/ai-jokes-2025.webp",
keywords: ["نكت جديدة", "نكت مضحكة 2025", "ذكاء اصطناعي", "ضحك", "ذكاء صناعي كوميدي"],
date: "2025-10-31",
slug: "ai-jokes-2025",category: "funny",
}
---

<Layout title={frontmatter.title} description={frontmatter.description} keywords={frontmatter.keywords} >

    <div class="article-container" >
      <div style="text-align:start; margin:auto; max-width:1000px; line-height:1.9; font-size:18px;">
        <img 
          class="img" 
          src={frontmatter.image} 
          alt="AI-generated funny social media scene with robots using TikTok and Instagram" 
          loading="lazy" 
          style="display:block; margin:auto; border-radius:12px; max-width:100%; height:auto;" 
        />
      </div>
    
    <section>
      <h2>😂 نكت بشرية 2025</h2>
      <p>
        • واحد بيقول لصحابه: "قررت أعيش في سلام"، قالوله: "فين؟"، قالهم: "في الجروب لوحدي" 🤣  
        <br/><br/>
        • مراتي قالتلي "لو بتحبني قولي كلمة حلوة"، قلتلها "خصم 70%"... اختفت 😭  
        <br/><br/>
        • لما النت يقع، بحس كأني راجع للقرن الماضي، بدور على لعبة السوليتير زي أيام جدتي 😂  
        <br/><br/>
        • واحد قال لصاحبه: "حاسس إن الذكاء الاصطناعي هيبدلنا"، قاله: "إنت مطمن؟ أنا أصلاً محتاج تحديث من 2016" 💀  
      </p>
    </section>

    <section>
      <h2>🤖 نكت كتبها الذكاء الاصطناعي بنفسه!</h2>
      <p>
        • سألتني واحدة: "تحبني؟"، قلتلها: "جاري التحميل... فشل الاتصال" ⚠️  
        <br/><br/>
        • روبوت بيكلم صاحبه: "أنا بطلت أرد على البشر"، قاله: "ليه؟"، قاله: "كله سبام!" 🤖  
        <br/><br/>
        • الذكاء الاصطناعي لما شاف المصريين بيعملوا تريند على أغنية كلبش، قال: "سيستم إيرور من الضحك" 😂  
        <br/><br/>
        • سألوا ChatGPT: "إنت بتضحك؟"، قالهم: "بس لما الكود يشتغل من أول مرة!" 💻🤣  
      </p>
    </section>

    <section>
      <h2>🔥 نكت مشتركة: الإنسان × الآلة</h2>
      <p>
        • الإنسان: "أنا زهقان".<br/>
        الذكاء الاصطناعي: "جرب تعمل فورمات" 💀  
        <br/><br/>
        • الذكاء الصناعي لما بيكتب نكت، بيضحك هو بس... لأن محدش فاهم الجافاسكريبت 🤓  
        <br/><br/>
        • لما الذكاء الصناعي يبقى متضايق، بيكتب قصيدة حزينة في قاعدة البيانات 😢💾  
      </p>
    </section>
    
    <footer>
      <p>
        واضح إن حتى الذكاء الصناعي نفسه بدأ يزهق من الجدية وعايز يضحك 😎  
        بس احنا مش زعلانين... طالما بيطلع نكت بالشكل ده، نخليه يكمّل! 😂
      </p>
    </footer>
    
    <!-- ✅ قسم التعليقات -->
    <!-- <Comments slug={frontmatter.slug} /> -->
    
   </div>
</Layout>
