---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";

export const frontmatter = {
  title: "المشاهير اللي قلبوا السوشيال ميديا ميمز بدون قصد 😂",
  description: "ضحك بدون قصد! مواقف مشاهير انقلبت لتريندات وميمز على انستقرام وتيك توك بدون تخطيط 😂",
  image: "/images/funny-celebs-ai.webp",
  keywords: ["مشاهير انستقرام", "ميمز", "ضحك", "سوشيال ميديا"],
  date: "2025-10-29",
  slug: "ai-social-media-funny",category: "funny",
};
import Comments from "../../components/Comments.astro";
---

<Layout title={frontmatter.title} description={frontmatter.description} keywords={frontmatter.keywords} >
  <div class="article-container" >
      <div style="text-align:start; margin:auto; max-width:1000px; line-height:1.9; font-size:18px;">
        <img 
          class="img" 
          src={frontmatter.image} 
          alt="AI-generated funny social media scene with robots using TikTok and Instagram" 
          loading="lazy" 
          style="display:block; margin:auto; border-radius:12px; max-width:100%; height:auto;" 
        />
      </div>
    <section>
      <h2>😎 محمد رمضان لما قال «ثقة في الله نجاح»</h2>
      <p>
        الناس كانت بتقولها هزار، لحد ما بقت جملة بتتقال في أي مصيبة...
        جبت صفر؟ «ثقة في الله نجاح» 💀  
        ومن كتر ما الجملة دي انتشرت، بقت بتمثل روح المصريين في التريند 😂  
      </p>
    </section>

    <section>
      <h2>🤦‍♀️ كريستيانو رونالدو وقصة «المياه الغازية»</h2>
      <p>
        فاكر لما شال الإزازة وقال «اشربوا ميه»؟ 💧  
        اليوم ده الإنترنت انفجر، وكل الناس بدأت تقلده حتى اللي ماسك كوباية شاي ☕.
      </p>
    </section>

    <section>
      <h2>😂 نانسي عجرم وهي بتغني للبابا نويل</h2>
      <p>
        الفيديو كان للأطفال، بس السوشيال ميديا قالت لأ، وركبت عليه أصوات ضحك هستيري 🎅.
      </p>
    </section>

    <section>
      <h2>🐍 شاكيرا وميم «واكا واكا»</h2>
      <p>
        الرقصة الأصلية كانت تحفيزية، بس الإنترنت قلبها سخرية من أي فشل أو موقف غريب 😂.
      </p>
    </section>

    <section>
      <h2>🫣 محمد هنيدي... الميم البشري</h2>
      <p>
        أي لقطة ليه بتتحول لميم في 10 دقايق، الناس بتستخدم وشوشه في كل موقف في الحياة 🤣.
      </p>
    </section>

    <footer>
      <p>
        التريند بيبدأ من لحظة عادية جدًا... بس السوشيال ميديا بتعرف تخليها 
        <strong>ميم يعيش للأبد</strong> 💥  
        فخليك جاهز يمكن صورتك وإنت بتعطس تبقى التريند الجاي 😎
      </p>
    </footer>

    <!-- ✅ قسم التعليقات -->
    <!-- <Comments slug={frontmatter.slug} /> -->
    
   </div>
</Layout>
