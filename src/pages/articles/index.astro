---
// src/pages/articles/index.astro
export const prerender = false;
import Layout from "../../layouts/Layout.astro";

const title = "المقالات";
const description = "أحدث مقالات الميمز والترفيه والالعاب";

const articles = [
  {
    title: "أفضل مودات Euro Truck للواقعية (2026)",
    slug: "/articles/best-ets2-realism-mods-2026",
    img: "/images/mods/modat.webp",
    category: "gaming",
  },
  {
    title: "ازاي تخلي Euro Truck لعبة نقل ركاب (Bus + Passenger Mod)",
    slug: "/articles/bus-passenger-euro-truck",
    img: "/images/mods/bus2.webp",
    category: "gaming",
  },
  {
    title: "تجربتي مع طارة Logitech G29 في Euro Truck Simulator 2",
    slug: "/articles/logitech-g29-euro-truck",
    img: "/images/logitech-g29.webp",
    category: "gaming",
  },
  {
    title: "أفضل إعدادات Logitech G29 في Euro Truck",
    slug: "/articles/logitech-g29-settings-ets2",
    img: "/images/g29-settings.png",
    category: "gaming",
  },
  {
    title: "تجربتي مع Logitech Driving Force Shifter في Euro Truck",
    slug: "/articles/logitech-shifter-euro-truck",
    img: "/images/logitech-shifter-2.webp",
    category: "gaming",
  },
  {
    title: "تاريخ الميمز وانتشارها",
    slug: "/articles/تاريخ-الميمز-وانتشارها",
    img: "/images/meme-origin-350.webp",
    category: "memes",
  },
  {
    title: "ثقافة الميمز: ليه بقت لغة العالم الجديد؟",
    slug: "/articles/ثقافة-الميمز",
    img: "/images/1-350.webp",
    category: "memes",
  },
  {
    title: "ليه الميمز بتخلي يومك أحسن؟",
    slug: "/articles/ليه-الميمز-بتخلي-يومك-أحسن؟",
    img: "/images/6-350.webp",
    category: "memes",
  },
  {
    title: "الميمز: المرآة اللي بتعكس جيل كامل 😂",
    slug: "/articles/geel-kamel",
    img: "/images/12-350.webp",
    category: "memes",
  },
  {
    title: "النكت هى العلاج الطبيعي للروح 😄",
    slug: "/articles/النكت-هى-العلاج-الطبيعي-للروح",
    img: "/images/21-350.webp",
    category: "funny",
  },
  {
    title: "أغرب طرق الناس لكسب الفلوس من الإنترنت (الطريقة رقم 3 هتضحكك 😂)",
    slug: "/articles/tiktok-funny-money",
    img: "/images/tiktok-funny-money-350.webp",
    category: "funny",
  },
  {
    title: "الذكاء الاصطناعي دخل السوشيال ميديا... وبدأ يقلدنا 😂",
    slug: "/articles/ai-social-media-funny",
    img: "/images/ai-social-media-funny-350.webp",
    category: "funny",
  },
  {
    title: "أفكار محتوى مجنونة للتيك توك هتخليك تريند وانت نايم 😎",
    slug: "/articles/tiktok-crazy-ideas",
    img: "/images/tiktok-crazy-ideas-350.webp",
    category: "funny",
  },
  {
    title: "المشاهير اللي قلبوا السوشيال ميديا ميمز بدون قصد 😂",
    slug: "/articles/funny-celebs-ai",
    img: "/images/funny-celebs-ai-350.webp",
    category: "funny",
  },
  {
    title: "نكت 2025: الذكاء الاصطناعي بيهزر هو كمان 🤖😂",
    slug: "/articles/ai-jokes-2025",
    img: "/images/ai-jokes-2025-350.webp",
    category: "funny",
  },
];
const selectedCategory = Astro.url.searchParams.get("cat");
const filteredArticles = selectedCategory
  ? articles.filter(a => a.category === selectedCategory)
  : articles;
---

<Layout {title} {description}>
  <section style="text-align:center; padding: 20px;">
    <h1>📰 أحدث مقالات LOLME</h1>
    <p>اضحك وتعلم عن عالم الميمز والضحك بطريقة خفيفة ومجنونة 😎</p>
  </section>
<div class="categories">

<a href="/articles" class={!selectedCategory ? "active" : ""}>الكل</a>

<a href="/articles?cat=gaming" class={selectedCategory === "gaming" ? "active" : ""}>
🎮 جيمنج
</a>

<a href="/articles?cat=memes" class={selectedCategory === "memes" ? "active" : ""}>
😂 ميمز
</a>

<a href="/articles?cat=funny" class={selectedCategory === "funny" ? "active" : ""}>
🤣 نكت
</a>

</div>
<main class="articles-grid">
  {
    filteredArticles.map((article, i) => (
      <a href={article.slug} class="article-card tilt-card">
        <img
          src={article.img}
          alt={article.title}
          width="350"
          height="180"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
        />
        <div class="content">
          <h2>{article.title}</h2>
        </div>
      </a>
    ))
  }
</main>
  <script src="/js/tilt-cards.js" defer></script>
</Layout>

<style>
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
    max-width: 1000px;
    margin: auto;
    padding: 40px 8px;
  }

  .article-card {
    text-decoration: none;
    color: inherit;
    background: var(--bg-color);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 6px 15px var(--shadow-color);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 15px rgb(241, 249, 16);
  }

  .article-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .article-card .content {
    padding: 10px;
    text-align: center;
  }

  .article-card h3 {
    font-size: 1.1rem;
    margin: 0;
    color: var(--accent);
  }

  .categories {
  display:flex;
  gap:10px;
  justify-content:center;
  margin-bottom:20px;
}

.categories a {
  padding:8px 15px;
  border-radius:20px;
  background:#0f1723;
  color:#fff;
  text-decoration:none;
  border:1px solid #ffffff22;
}

.categories a:hover {
  background:#00ffcc;
  color:#000;
}
</style>
