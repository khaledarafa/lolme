---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Comments from "../../components/Comments.astro";

export const frontmatter = {
    title: "تجربتي مع طارة Logitech G29 في Euro Truck Simulator 2 🚛",
    description:
        "مراجعة وتجربة طارة Logitech G29 في لعبة Euro Truck Simulator 2 وأهم الإعدادات والفرق بينها وبين الكيبورد.",
    image: "/images/logitech-g29.webp",
    keywords: [
        "Logitech G29",
        "طارة لوجيتك",
        "Euro Truck Simulator 2",
        "أفضل طارة للقيادة",
        "إعدادات Logitech G29",
        "ETS2 steering wheel",
    ],
    date: "2026-03-16",
    slug: "logitech-g29-euro-truck",
};
---

<Layout
    title={frontmatter.title}
    description={frontmatter.description}
    keywords={frontmatter.keywords}
    img={frontmatter.image}
>
    <article class="article-page">
        <h1>تجربتي مع طارة Logitech G29 في Euro Truck Simulator 2</h1>

        <p>
            لو بتلعب Euro Truck Simulator 2 باستخدام الكيبورد أو يد التحكم
            فغالبًا أنت مستمتع باللعبة، لكن الحقيقة إن تجربة القيادة بتختلف
            تمامًا لما تستخدم طارة قيادة حقيقية مثل Logitech G29.
        </p>

        <p>
            أنا شخصيًا كنت بلعب لفترة طويلة بالكيبورد، لكن بعد ما جربت الطارة
            اكتشفت إن إحساس اللعبة اتغير تمامًا وأصبحت أقرب لمحاكاة القيادة
            الحقيقية.
        </p>

        <img
            src="/images/logitech-g29-2.webp"
            alt="Logitech G29 steering wheel"
            class="article-image"
        />

        <h2>الفرق بين الطارة والكيبورد في Euro Truck</h2>

        <p>
            قبل ما أجيب الطارة كنت بلعب بالكيبورد، وكان التحكم كويس لكن مش
            واقعي. بعد ما استخدمت Logitech G29 حصل فرق كبير جدًا في الإحساس
            بالقيادة.
        </p>

        <h3>التحكم في الدركسيون</h3>

        <p>
            مع الكيبورد الحركة يمين أو شمال بتكون حادة شوية، لكن مع الطارة تقدر
            تلف الدركسيون تدريجي وتتحكم في المنحنيات بدقة وكمان تركن الشاحنة
            بسهولة.
        </p>

        <ul>
            <li>تلف الدركسيون تدريجي</li>
            <li>تحكم أفضل في المنحنيات</li>
            <li>ركن الشاحنة أسهل</li>
        </ul>

        <h3>إحساس الطريق</h3>

        <p>
            ميزة Force Feedback في الطارة تخليك تحس بالمطبات واحتكاك الطريق وحتى
            وزن الشاحنة أثناء القيادة. وده يخلي التجربة أقرب لمحاكاة حقيقية.
        </p>

        <ul>
            <li>المطبات</li>
            <li>احتكاك الطريق</li>
            <li>وزن الشاحنة</li>
        </ul>

        <h3>ركن الشاحنة</h3>

        <p>
            ركن الشاحنة في اللعبة بالكيبورد ممكن يكون صعب، لكن بالطارة الموضوع
            بيبقى أسهل بكتير لأنك بتتحكم في زاوية العجل بدقة.
        </p>

        <h2>أهم شيء ناس كتير مش عارفاه: برنامج Logitech G Hub</h2>

        <p>
            واحدة من أهم الحاجات اللي اكتشفتها بعد استخدام الطارة هي إن
            السوفتوير الخاص بالطارة مهم جدًا.
        </p>

        <p>
            البرنامج اسمه <strong>Logitech G Hub</strong>. ومن خلاله تقدر تتحكم
            في:
        </p>

        <ul>
            <li>قوة Force Feedback</li>
            <li>حساسية الطارة</li>
            <li>زاوية الدوران</li>
            <li>إعدادات كل لعبة</li>
        </ul>

        <p>بدون البرنامج ده الطارة هتشتغل، لكن مش هتديك أفضل تجربة ممكنة.</p>

        <h2>أفضل إعدادات Logitech G29 في Euro Truck Simulator 2</h2>

        <p>
            الإعدادات بتفرق جدًا في إحساس القيادة. الإعدادات اللي أنا بستخدمها
            تقريبًا:
        </p>

        <ul>
            <li>Steering Sensitivity : 50%</li>
            <li>Force Feedback : 70%</li>
            <li>Deadzone : 0%</li>
            <li>Steering Rotation : 900°</li>
        </ul>

        <p>
            الإعدادات دي بتخلي السواقة واقعية والتحكم مريح والشاحنة ما تبقاش
            حساسة زيادة.
        </p>

        <h2>هل تستحق Logitech G29 الشراء؟</h2>

        <p>لو بتلعب ألعاب قيادة بشكل متكرر فالإجابة غالبًا نعم.</p>

        <ul>
            <li>إحساس واقعي في القيادة</li>
            <li>جودة تصنيع ممتازة</li>
            <li>دعم قوي للألعاب</li>
            <li>عمر طويل للطارة</li>
        </ul>

        <p>لكن لو بتلعب ألعاب القيادة نادرًا ممكن تكون الطارة مش ضرورية.</p>

        <h2>خلاصة التجربة</h2>

        <p>
            بعد استخدام الطارة لفترة طويلة أقدر أقول إن تجربة Euro Truck
            Simulator 2 اختلفت تمامًا.
        </p>

        <p>
            السواقة بقت أكثر واقعية وأكثر متعة وقريبة جدًا من محاكاة القيادة
            الحقيقية.
        </p>
    </article>

    <Comments />
</Layout>

<style>
    .article-page {
        max-width: 800px;
        margin: auto;
        padding: 40px 20px;
        line-height: 1.9;
        font-size: 1.05rem;
    }

    .article-page h1 {
        font-size: 2rem;
        margin-bottom: 20px;
    }

    .article-page h2 {
        margin-top: 40px;
        color: var(--highlight-color);
    }

    .article-image {
        width: 100%;
        border-radius: 12px;
        margin: 25px 0;
    }

    .article-page ul {
        margin: 15px 0;
        padding-right: 20px;
    }

    .article-page li {
        margin-bottom: 8px;
    }
</style>
