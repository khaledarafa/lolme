---
// src/pages/community-jokes.astro
import Layout from "../layouts/Layout.astro";
export const prerender = false;

const pageUrl = "https://lolme.cc/community-jokes";

const starterJokes = [
  "واحد راح للدكتور قاله: كل ما أشرب شاي عيني بتوجعني، قاله: شيل المعلقة من الكوباية الأول 😂",
  "واحد بخيل وقع منه جنيه في البلاعة، نزل وراه وقال: مش هسيبك تغرق لوحدك 🤣",
  "مدرس سأل طالب: إيه أسرع حاجة في الدنيا؟ قاله: الإجازة يا أستاذ، بتيجي وتخلص قبل ما نحس بيها 😅",
  "واحد اشترى ساعة ضد الميه، أول ما نزل البحر الساعة غرقت وهو اللي فضل عايش 😂",
  "واحد كسلان جدًا، لما حلم إنه بيجري صحي من النوم عشان يرتاح 🤣",
  "واحد راح يشتري نظارة، قال للبياع: عايز نظارة أشوف بيها المستقبل، قاله: دي عند العراف مش عندي 😂",
  "واحد نام متأخر، صحي لقى نفسه متأخر برضه.. قال: حتى النوم مبقاش بينفع 😆",
  "واحد بيقول لصاحبه: أنا ذاكرتي قوية جدًا، بس مش فاكر في إيه بالظبط 🤣",
  "واحد دخل مطعم قال للجرسون: عندكم أكل سريع؟ قاله: أيوه، قاله: طب خليه يجري ورايا 😂",
  "واحد اشترى موبايل ضد الكسر، وقع منه الموبايل واتكسر هو من الزعل 😅",
  "واحد راح البنك يفتح حساب، الموظف سأله: معاك كام؟ قاله: لو معايا كنت جيت أفتح حساب ليه؟ 😂",
  "واحد بيقول لمراته: أنا بحب الهدوء، قالتله: وأنا كمان، قالها: طب اسكتي بقى 🤣",
  "واحد سأل صاحبه: إنت بتصحى بدري؟ قاله: لأ، أنا بصحى متأخر بس بكون صاحي من بدري 😆",
  "واحد دخل امتحان جغرافيا، أول سؤال: أين تقع الصين؟ كتب: في قلب آسيا يا أستاذ، متقلقش 😂",
  "واحد راح الجيم أول يوم، رجع قال لأمه: ادعيلي، قالتله: مالك؟ قالها: المدرب قاللي هنبدأ من الصفر 🤣",
  "واحد اشترى سرير جديد، نام عليه يومين ورجعه، قالهم: مش مريح، قالوله: ليه؟ قال: كل ما أنام عليه أصحى 😅",
  "واحد بيقول لصاحبه: أنا بقيت نباتي، قاله: يعني مبتاكلش لحمة؟ قاله: لأ، بس بقعد جنب الزرع وأنا باكل 😂",
  "واحد سأل صاحبه: إيه أخبار الشغل؟ قاله: زي الفل، كل يوم بروح أستلم المرتب.. في الحلم 🤣",
  "واحد راح للحلاق قاله: عايز قصة تخليني أصغر عشر سنين، الحلاق قاله: أعملك قصة أطفال؟ 😂",
  "واحد فتح التلاجة بالليل، لقى النور منور، قال: حتى التلاجة مش عارفة تنام من كتر التفكير 😆",
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "نكت المجتمع | LOLME",
  description:
    "نكت LOLME المضحكة ونكت المجتمع المنشورة. اقرأ النكت وشاركنا الضحك.",
  url: pageUrl,
  inLanguage: "ar",
  isPartOf: {
    "@type": "WebSite",
    name: "LOLME",
    url: "https://lolme.cc/",
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "الرئيسية",
        item: "https://lolme.cc/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "نكت المجتمع",
        item: pageUrl,
      },
    ],
  },
};
---

<Layout
  title="نكت مضحكة من الجمهور 😂 | نكت المجتمع - LOLME"
  description="اقرأ نكت LOLME المضحكة ونكت المجتمع المنشورة، وشارك نكتتك مع الجمهور. نكت مصرية وعربية وضحك متجدد."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <main class="community-page" dir="rtl">
    <header class="community-hero">
      <span class="community-hero-icon">🤣</span>
      <h1>نكت المجتمع</h1>
      <p>ضحك من تأليف الناس... والضحكة الحلوة تستاهل المشاركة!</p>

      <a href="/submit-joke" class="send-joke-link">
        ✍️ ابعت نكتتك وشاركنا الضحك
      </a>
    </header>

    <section class="community-feed" aria-label="محتوى المجتمع">
      <!-- قسم أسئلة الجمهور -->
      <section
        class="community-questions-section"
        aria-labelledby="community-questions-title"
      >
        <div class="feed-heading">
          <h2 id="community-questions-title">🗳️ أسئلة الجمهور</h2>
          <span>شارك برأيك وصوّت… وطلّع اللي جواك! 🤣</span>
        </div>

        <div class="jokes-page card">
          <div id="community-questions-list" class="community-questions-list">
            <div class="community-loading">جاري تحميل أسئلة الجمهور...</div>
          </div>
        </div>
      </section>

      <!-- قسم النكت -->
      <section
        class="community-jokes-section"
        aria-labelledby="community-jokes-title"
      >
        <div class="feed-heading">
          <h2 id="community-jokes-title">😂 نكت المجتمع</h2>
          <span id="community-jokes-total">جاري التحميل...</span>
        </div>

        <!-- نكت LOLME الافتتاحية -->
        <div class="jokes-page card">
          <details class="starter-community-jokes">
            <summary id="starter-jokes-title">
              😂 نكت من LOLME
              <span class="starter-jokes-count">20 نكتة</span>
            </summary>

            <p>مجموعة من النكت الافتتاحية اللي بدأنا بيها الضحك!</p>

            <ul class="community-jokes-list">
              {
                starterJokes.map((joke, index) => {
                  const jokeId = `starter_${String(index + 1).padStart(2, "0")}`;

                  return (
                    <li class="card tilt-card" data-joke-id={jokeId}>
                      <div class="community-joke-meta">😂 نكتة من LOLME</div>
                      <p class="community-joke-text">{joke}</p>
                      <div class="joke-reactions" data-reactions-for={jokeId} />

                      <button
                        type="button"
                        class="share-btn"
                        data-share-joke={joke}
                      >
                        شارك الضحكة 😂
                      </button>
                    </li>
                  );
                })
              }
            </ul>
          </details>
        </div>

        <!-- نكت الأعضاء -->
        <div class="jokes-page card">
          <ul id="community-jokes-list" class="community-jokes-list">
            <li class="card tilt-card community-loading">
              <div class="loading-hero">
                <span class="loading-emoji">🤣</span>
                <h3>بنجهزلك جرعة الضحك!</h3>
                <p>بنحمّل أحدث نكت المجتمع... استعد للضحك 😂</p>
              </div>

              <div class="loading-progress">
                <span></span>
              </div>

              <small class="loading-caption">لحظات ونكون جاهزين ❤️</small>

              <div class="skeleton-joke">
                <div class="skeleton-meta">
                  <span></span>
                  <span></span>
                </div>
                <div class="skeleton-line"></div>
                <div class="skeleton-line short"></div>
              </div>
            </li>
          </ul>
        </div>
      </section>
    </section>

    <section class="community-bottom-cta">
      <h2>عندك نكتة أحلى؟ 😎</h2>
      <p>شاركها معانا، ويمكن تبقى النكتة اللي ضحكت آلاف الناس!</p>
      <a href="/submit-joke">إرسال نكتة جديدة 😂</a>
    </section>
  </main>

  <link rel="stylesheet" href="/css/jokes.css" />
  <script type="module" src="/js/community-jokes.js"></script>
</Layout>
