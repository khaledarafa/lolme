---
// src/pages/community-jokes.astro
import Layout from "../layouts/Layout.astro";
export const prerender = false;

const pageUrl = "https://lolme.cc/community-jokes";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "نكت المجتمع | LOLME",
  "description":
    "أحدث النكت المضحكة والمشاركات الكوميدية من مجتمع LOLME. اقرأ نكت الجمهور وشاركنا نكتتك.",
  "url": pageUrl,
  "inLanguage": "ar",
  "isPartOf": {
    "@type": "WebSite",
    "name": "LOLME",
    "url": "https://lolme.cc/"
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "الرئيسية",
        "item": "https://lolme.cc/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "نكت المجتمع",
        "item": pageUrl
      }
    ]
  }
};
---

<Layout
  title="نكت مضحكة من الجمهور 😂 | نكت المجتمع - LOLME"
description="اقرأ أحدث النكت المضحكة من مجتمع LOLME، وشارك نكتتك مع الجمهور. نكت مصرية وعربية وضحك متجدد."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <main class="community-page" dir="rtl">
    <header class="community-hero">
      <span class="community-hero-icon">🤣</span>
      <h1>نكت المجتمع</h1>
      <p>ضحك من تأليف الناس... والضحكة الحلوة تستاهل المشاركة!</p>

      <a href="/submit-joke" class="send-joke-link">
        ✍️ ابعت نكتتك وشاركنا الضحك
      </a>
    </header>

    <section class="community-feed" aria-label="النكت المنشورة">
      <div class="feed-heading">
        <h2>😂 أحدث النكت</h2>
        <span id="community-jokes-total">جاري التحميل...</span>
      </div>

      <div class="jokes-page card">
<ul id="community-jokes-list" class="community-jokes-list">
  <li class="card tilt-card community-loading">
    <div class="loading-hero">
      <span class="loading-emoji">🤣</span>
      <h3>بنجهزلك جرعة الضحك!</h3>
      <p>بنحمّل أحدث نكت المجتمع... استعد للضحك 😂</p>
    </div>

    <div class="loading-progress">
      <span></span>
    </div>

    <small class="loading-caption">لحظات ونكون جاهزين ❤️</small>

    <div class="skeleton-joke">
      <div class="skeleton-meta">
        <span></span>
        <span></span>
      </div>

      <div class="skeleton-line"></div>
      <div class="skeleton-line short"></div>
    </div>
  </li>
</ul>
      </div>
    </section>

    <section class="community-bottom-cta">
      <h2>عندك نكتة أحلى؟ 😎</h2>
      <p>شاركها معانا، ويمكن تبقى النكتة اللي ضحكت آلاف الناس!</p>
      <a href="/submit-joke">إرسال نكتة جديدة 😂</a>
    </section>
  </main>

  <link rel="stylesheet" href="/css/jokes.css" />
  <script type="module" src="/js/community-jokes.js"></script>
</Layout>


