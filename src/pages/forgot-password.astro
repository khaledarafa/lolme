
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="استعادة كلمة المرور">
  <section class="auth-card">
    <h2>🔑 نسيت كلمة المرور؟</h2>
    <p>اكتب بريدك الإلكتروني وسنرسل لك رابط إعادة تعيين كلمة المرور.</p>

    <form id="reset-form">
      <label for="reset-email">البريد الإلكتروني</label>
      <input id="reset-email" type="email" autocomplete="email" required />
      <button id="reset-submit" type="submit">إرسال رابط الاستعادة</button>
    </form>

    <p id="reset-message" role="status" aria-live="polite"></p>
    <p><a href="/login">العودة لتسجيل الدخول</a></p>
  </section>

  <script type="module" src="/js/forgot-password.js"></script>

  <style>
    .auth-card {
      max-width: 440px;
      margin: 24px auto;
      padding: 26px;
      border: 1px solid #374151;
      border-radius: 18px;
      background: #17212f;
      color: #fff;
    }

    .auth-card form { display: grid; gap: 12px; }

    .auth-card input {
      width: 100%;
      box-sizing: border-box;
      padding: 12px;
      border: 1px solid #475569;
      border-radius: 9px;
      background: #0f1723;
      color: #fff;
      font: inherit;
    }

    .auth-card button {
      padding: 12px;
      border: 0;
      border-radius: 9px;
      background: #16c765;
      color: #06140b;
      font: inherit;
      cursor: pointer;
    }

    .auth-card a { color: #16c765; }
    #reset-message { line-height: 1.8; overflow-wrap: anywhere; }
  </style>
</Layout>
