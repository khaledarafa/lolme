---
// src/pages/games/[slug].astr
import Layout from "../../layouts/Layout.astro";
import { db } from "../../lib/firebase-admin.js";
const categoryNames: Record<string, string> = {
  general: "منوعات",
  "what-animal-is-this": "ما هو الحيوان",
  "supermarket-products": "منتجات السوبر ماركت",
  "english-league": "الدوري الإنجليزي",
  "serie-a": "الدوري الإيطالي",
  "champions-league": "دوري أبطال أوروبا",
  "world-cup": "كأس العالم",
  "find-difference": "اوجد الاختلافات",
  songs: "ألعاب أغاني",
  geography: "جغرافيا",
  movies: "ألعاب أفلام",
  series: "مسلسلات",
  brain: "معلومات عامة",
  mix: "منوعات",
};

function generateSEOContent(data: any) {
  const category =
    data?.gamePlan?.[0]?.category || data?.categories?.[0] || "general";

  const map = {
    general: {
      title: "اختبار منوعات 🔥",
      intro: "اختبر معلوماتك في مجالات مختلفة 😏🔥",
      desc: "مجموعة أسئلة متنوعة وممتعة في كل المجالات.",
    },
    "what-animal-is-this": {
      title: "اختبار الحيوانات 🐾",
      intro: "هل تعرف الحيوانات كويس؟ 😏",
      desc: "أسئلة ممتعة عن الحيوانات.",
    },
  };

  const niceName =
    categoryNames[category as keyof typeof categoryNames] ||
    category.replaceAll("-", " ");

  return (
    map[category as keyof typeof map] || {
      title: `اختبار ${niceName}`,
      intro: `اختبر نفسك في ${niceName}`,
      desc: `أسئلة ممتعة عن ${niceName}`,
    }
  );
}
const { slug } = Astro.params as { slug: string };

let data = null;

let seo = null;
let niceName = "";
let title = "";

try {
  const snap = await db.collection("publicRooms").doc(slug).get();

  if (snap.exists) {
    data = snap.data();
  }

  if (data) {
    const category =
      data.gamePlan?.[0]?.category || data.categories?.[0] || "general";

    niceName = categoryNames[category] || category.replaceAll("-", " ");

    seo = generateSEOContent(data);

    const variants = [
      "اختبر معلوماتك في",
      "هل أنت خبير في",
      "تحدي سريع في",
      "اختبار قوي في",
    ];

    const randomText = variants[Math.floor(Math.random() * variants.length)];

    title = `${randomText} ${niceName} 🔥`;
  }
} catch (e) {
  console.log("ERROR", e);
}
---

<Layout>
  <div class="game-page">
    {!data && <p>❌ الصفحة مش موجودة</p>}

    {
      data && (
        <>
          <h1>{title}</h1>

          <p class="intro">{seo?.intro}</p>

          <p class="meta">
            عدد الأسئلة: {data.gamePlan?.[0]?.questions?.length || 0}
          </p>

          <div class="game-board">
            {data.gamePlan.map((cat: any) => (
              <div class="category">
                <h2>
                  {categoryNames[cat.category as keyof typeof categoryNames] ||
                    cat.category.replaceAll("-", " ")}
                </h2>

                {cat.questions.map((q: any) => (
                  <div class="question-card">
                    <p class="q-text">{q.text}</p>

                    <div class="options">
                      {(q.options || []).map((opt: any) => (
                        <button class="option-btn">{opt}</button>
                      ))}
                    </div>

                    <div class="cta-hint">
                      👀 عايز تعرف الإجابة؟ العب اللعبة 😏🔥
                    </div>
                  </div>
                ))}
              </div>
            ))}
          </div>

          <div class="seo-extra">
            <h3>ليه تعمل الاختبار ده؟ 🤔</h3>
            <p>{seo?.desc}</p>
          </div>

          <a href="/" class="play-btn">
            🎮 العب لايف مع أصحابك
          </a>
        </>
      )
    }
  </div>
  <script>
    document
      .querySelectorAll<HTMLButtonElement>(".option-btn")
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          btn.innerText = "❌ العب اللعبة عشان تعرف 😈";
          btn.style.background = "#3a1b1b";
        });
      });
  </script>
</Layout>
