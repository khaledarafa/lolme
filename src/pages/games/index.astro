---
import Layout from "../../layouts/Layout.astro";
import { db } from "../../lib/firebase-admin.js";
type Game = {
  slug: string;
  questionsCount: number;
  category: string;
};
let games: Game[] = [];

try {
    const snap = await db.collection("publicRooms").get();

    games = snap.docs.map((doc) => {
        const data = doc.data();

        return {
            slug: doc.id,
            questionsCount: data.gamePlan?.[0]?.questions?.length || 0,
            category: data.gamePlan?.[0]?.category || "general",
        };
    });
} catch (e) {
    console.log("FIREBASE ERROR", e);
}
---

<Layout title="🎮 كل الاختبارات">
    <p class="intro">
  اكتشف مجموعة كبيرة من الاختبارات والألعاب التفاعلية في مجالات مختلفة زي الكورة، الأفلام، المعلومات العامة، والأغاني 🎯
</p>

<p class="seo-text">
تصفح أفضل الاختبارات التفاعلية في مجالات متعددة مثل كرة القدم، الأفلام، المعلومات العامة، والأغاني.
يمكنك اختيار الاختبار المناسب لك وتجربة مستواك من خلال مجموعة أسئلة ممتعة ومتنوعة.
</p>

    <section class="categories-section">
        <h1>🔥 كل الاختبارات والألعاب</h1>

        <div class="home-grid">
            {
                games.map((data: any) => {
                    const category = data.category || "general";

                    const categoryNames = {
                        general: "منوعات",
                        "what-animal-is-this": "ما هو الحيوان",
                        "supermarket-products": "منتجات السوبر ماركت",
                        "english-league": "الدوري الإنجليزي",
                        "serie-a": "الدوري الإيطالي",
                        "champions-league": "دوري أبطال أوروبا",
                        "world-cup": "كأس العالم",
                        "find-difference": "اوجد الاختلافات",
                        songs: "ألعاب أغاني",
                        geography: "جغرافيا",
                        movies: "ألعاب أفلام",
                        series: "مسلسلات",
                        brain: "معلومات عامة",
                        mix: "منوعات",
                    };

const niceName =
  categoryNames[category as keyof typeof categoryNames] ||
  category.replaceAll("-", " ");

                    const names = ["اختبار", "تحدي", "لعبة", "مسابقة", "تجربة"];
                    const randomName =
                        names[Math.floor(Math.random() * names.length)];

                    const title = `${randomName} ${niceName} 🔥`;
const subtitle = `اختبر نفسك وشوف مستواك 😏`;

                    return (
   <a href={`/games/${data.slug}`} class="home-card">
  <div class="content">
    <h3>{title}</h3>
    <p>
{subtitle} في مجال {niceName} واكتشف مستواك الحقيقي من خلال أسئلة متنوعة.
</p>
    <span>🔥 {data.questionsCount} سؤال</span>
  </div>
</a>
                    );
                })
            }
        </div>

<button
  class="start-btn"
  onclick="window.location.href='/how-to-play'"
>
🔥 لعبة أسئلة تقدر تلعبها بطريقتك… لوحدك،  <br>
مع أصحابك كل واحد من موبايله،  <br>
أو تعمل لايف وتدير اللعبة بنفسك قدام الناس 😏  <br>
اضغط وجربها دلوقتي
  👉 
</button>
    </section>
</Layout>
