  <!-- <script type="module" src="/js/home-categories.js"></script> -->
  <!-- <script type="module" src="/js/home-seo-games.js"></script> -->
  <script type="module">
    import { functions, httpsCallable } from "/js/firebase.js";

    const getStats = httpsCallable(functions, "getGa4PublicStats");

    const numberFormat = new Intl.NumberFormat("ar-EG", {
      maximumFractionDigits: 0,
      minimumFractionDigits: 0,
    });

    function setText(id, value) {
      const element = document.getElementById(id);
      if (element) {
        element.textContent = Math.round(Number(value) || 0)
          .toLocaleString("ar-EG")
          .replace(/[٬,]/g, "");
      }
    }

    function setLabel(id, value) {
      const element = document.getElementById(id);
      if (element) {
        element.textContent = value;
      }
    }

    async function loadSiteStats() {
      const note = document.getElementById("stats-update-note");

      try {
        const response = await getStats();
        const stats = response.data;

        // الإحصائيات العامة
        setText("stat-page-views", stats.pageViews);

        // المستخدمون النشطون خلال آخر 30 يومًا
        setText("stat-unique-visitors", stats.activeUsers);

        // لا تتوفر بيانات آخر 5 دقائق من تقرير GA4
        setText("stat-sessions", stats.sessions);

        // توزيع مشاهدات الأقسام
        const sections = stats.sections || {};

        setText("stat-home", sections.home);

        setText("stat-jokes", sections.jokes);

        setText("stat-tests", sections.tests);

        // أكثر الاختبارات مشاهدة
        const topTestsList = document.getElementById("stats-top-tests-list");

        if (topTestsList) {
          topTestsList.replaceChildren();

          const tests = (stats.topTests || []).filter((test) => {
            const path = String(test.path || "").replace(/\/+$/, "") || "/";
            return path !== "/tests";
          });

          if (tests.length) {
            tests.forEach((test, index) => {
              const path = String(test.path || "/tests");
              const safePath = path.startsWith("/tests/") ? path : "/tests";

              const link = document.createElement("a");
              link.href = safePath;
              link.className = "top-test-row";

              const rank = document.createElement("span");
              rank.textContent = `#${index + 1}`;

              const name = document.createElement("span");
              name.textContent =
                path.replace(/^\/tests\/?/, "").replace(/\/$/, "") ||
                "صفحة الاختبارات";

              const views = document.createElement("strong");
              views.textContent = Math.round(
                Number(test.pageViews) || 0,
              ).toLocaleString("ar-EG");

              link.append(rank, name, views);
              topTestsList.appendChild(link);
            });
          } else {
            topTestsList.textContent = "لا توجد بيانات اختبارات كافية حاليًا.";
          }
        }

        // تاريخ ومدة الإحصائيات
        if (note) {
          note.textContent =
            `${stats.period || "آخر 30 يومًا مكتملًا"} — آخر تحديث: ` +
            new Date().toLocaleTimeString("ar-EG");
        }
      } catch (error) {
        console.error("GA4 Site statistics error:", error);

        if (note) {
          note.textContent = "تعذر تحميل الإحصائيات حاليًا.";
        }
      }
    }

    loadSiteStats();

    // تحديث كل 15 دقيقة
    setInterval(loadSiteStats, 15 * 60 * 1000);
  </script>
</Layout>
