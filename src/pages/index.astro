  <a href="/play" class="play-btn">🎮 كل الألعاب</a>
</section> -->

  <!-- scripts -->
  <script type="module" src="/js/install-btn.js"></script>
  <script src="/js/tilt-cards.js" defer></script>
  <script type="module" src="/js/codes.js"></script>
  <!-- <script type="module" src="/js/home-categories.js"></script> -->
  <!-- <script type="module" src="/js/home-seo-games.js"></script> -->
  <script type="module">
    import { functions, httpsCallable } from "/js/firebase.js";

    const getStats = httpsCallable(functions, "getGa4PublicStats");

    const numberFormat = new Intl.NumberFormat("ar-EG", {
      maximumFractionDigits: 0,
      minimumFractionDigits: 0,
    });

    function setText(id, value) {
      const element = document.getElementById(id);
      if (element) {
        element.textContent = Math.round(Number(value) || 0)
          .toLocaleString("ar-EG")
          .replace(/[٬,]/g, "");
      }
    }

    function setLabel(id, value) {
      const element = document.getElementById(id);
      if (element) {
        element.textContent = value;
      }
    }

    async function loadSiteStats() {
      const note = document.getElementById("stats-update-note");

      try {
        const response = await getStats();
        const stats = response.data;

        // الإحصائيات العامة
        setText("stat-page-views", stats.pageViews);

        // المستخدمون النشطون خلال آخر 30 يومًا
        setText("stat-unique-visitors", stats.activeUsers);

        // لا تتوفر بيانات آخر 5 دقائق من تقرير GA4
        setText("stat-sessions", stats.sessions);

        // توزيع مشاهدات الأقسام
        const sections = stats.sections || {};

        setText("stat-home", sections.home);

        setText("stat-jokes", sections.jokes);

        setText("stat-tests", sections.tests);

        // توزيع الجمهور حسب الدولة
        const countriesList = document.getElementById("stats-countries-list");

        if (countriesList) {
          countriesList.replaceChildren();

          const countries = stats.countries || [];
          const totalUsers = countries.reduce(
            (sum, item) => sum + (Number(item.activeUsers) || 0),
            0,
          );

          if (countries.length) {
            countries.forEach((item) => {
              const row = document.createElement("div");
              row.className = "stats-country-row";

              const name = document.createElement("span");
              name.className = "stats-country-name";
              const countryNames = {
                Egypt: "مصر",
                "Saudi Arabia": "السعودية",
                "United States": "الولايات المتحدة",
                Syria: "سوريا",
                Iraq: "العراق",
                Algeria: "الجزائر",
                Jordan: "الأردن",
                Yemen: "اليمن",
                Germany: "ألمانيا",
                Lebanon: "لبنان",
                Israel: "إسرائيل",
                "United Arab Emirates": "الإمارات",
                Tunisia: "تونس",
                Morocco: "المغرب",
                Türkiye: "تركيا",
                Turkey: "تركيا",
                Kuwait: "الكويت",
                Oman: "عُمان",
                Sudan: "السودان",
                Libya: "ليبيا",
                Palestine: "فلسطين",
                Qatar: "قطر",
                Netherlands: "هولندا",
                Bahrain: "البحرين",
                Canada: "كندا",
                France: "فرنسا",
                China: "الصين",
                Sweden: "السويد",
                "United Kingdom": "المملكة المتحدة",
                Australia: "أستراليا",
                Iran: "إيران",
                Italy: "إيطاليا",
                Belgium: "بلجيكا",
                India: "الهند",
              };

              name.textContent = countryNames[item.country] || item.country;

              const count = document.createElement("strong");
              count.textContent = numberFormat.format(item.activeUsers);

              const percentage = document.createElement("small");
              const percent = totalUsers
                ? (Number(item.activeUsers) / totalUsers) * 100
                : 0;
              row.style.setProperty("--country-share", `${percent}%`);
              percentage.textContent = `${percent.toFixed(1)}%`;

              row.append(name, count, percentage);
              countriesList.appendChild(row);
            });
          } else {
            countriesList.textContent = "لا توجد بيانات دول متاحة حاليًا.";
          }
        }

        // 🔥 الاختبارات الأكثر مشاهدة
        const topTestsList = document.getElementById("stats-top-tests-list");

        if (topTestsList) {
          topTestsList.replaceChildren();

          const tests = (stats.topTests || [])
            .filter((test) => {
              const path = String(test.path || "").replace(/\/+$/, "") || "/";
              return path !== "/tests";
            })
            .slice(0, 6);

          const testDetails = {
            wealth: {
              title: "عقلية الثراء",
              description: "اكتشف طريقة تفكيرك تجاه المال والوفرة",
              emoji: "💰",
            },
            fear: {
              title: "اختبار الخوف",
              description: "اكتشف ما الذي قد يثير خوفك",
              emoji: "😱",
            },
            "if-you-were-food": {
              title: "لو كنت أكلة؟",
              description: "اعرف شخصيتك من خلال اختياراتك",
              emoji: "🍔",
            },
            "your-mental-age": {
              title: "اكتشف عمرك العقلي",
              description: "هل تفكيرك مناسب لعمرك الحقيقي؟",
              emoji: "🧠",
            },
            peace: {
              title: "اختبار السلام الداخلي",
              description: "اكتشف مدى هدوئك وتوازنك",
              emoji: "☮️",
            },
          };

          if (tests.length) {
            tests.forEach((test, index) => {
              const path = String(test.path || "/tests");
              const slug = path.replace(/^\/tests\/?/, "").replace(/\/+$/, "");
              const safePath = path.startsWith("/tests/") ? path : "/tests";

              const details = testDetails[slug] || {
                title: slug
                  .split("-")
                  .filter(Boolean)
                  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
                  .join(" "),
                description: "جرّب الاختبار واكتشف نتيجتك بنفسك!",
                emoji: "✨",
              };

              const card = document.createElement("a");
              card.href = safePath;
              card.className = "featured-test-card";

              const icon = document.createElement("span");
              icon.className = "featured-test-icon";
              icon.textContent = details.emoji;

              const rank = document.createElement("span");
              rank.className = "featured-test-rank";
              rank.textContent = `#${index + 1}`;

              const title = document.createElement("h3");
              title.textContent = details.title;

              const description = document.createElement("p");
              description.textContent = details.description;

              const views = document.createElement("span");
              views.className = "featured-test-views";
              views.textContent = `👀 ${numberFormat.format(test.pageViews || 0)} مشاهدة`;

              const action = document.createElement("span");
              action.className = "featured-test-action";
              action.textContent = "جرّب الاختبار ←";

              card.append(icon, rank, title, description, views, action);
              topTestsList.appendChild(card);
            });
          } else {
            topTestsList.textContent = "لا توجد اختبارات متاحة حاليًا.";
          }
        }

        // تاريخ ومدة الإحصائيات
        if (note) {
          note.textContent =
            `${stats.period || "آخر 30 يومًا مكتملًا"} — آخر تحديث: ` +
            new Date().toLocaleTimeString("ar-EG");
        }
      } catch (error) {
        console.error("GA4 Site statistics error:", error);

        if (note) {
          note.textContent = "تعذر تحميل الإحصائيات حاليًا.";
        }
      }
    }

    loadSiteStats();

    // تحديث كل 15 دقيقة
    setInterval(loadSiteStats, 15 * 60 * 1000);
  </script>
</Layout>
