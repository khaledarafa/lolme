---
// src/pages/index.astro
export const prerender = false;
import Layout from "../layouts/Layout.astro";

interface ArticleFrontmatter {
  title: string;
  description?: string;
  image?: string;
  date?: string;
}

interface ArticleWithSlug extends ArticleFrontmatter {
  slug: string;
}

// load *frontmatter only* without eager or loading images/components
const modules = import.meta.glob("./articles/*.astro", {
  import: "frontmatter",
});

const articles: ArticleWithSlug[] = [];

for (const [path, loader] of Object.entries(modules)) {
  const fm = (await loader()) as ArticleFrontmatter;

  if (path.endsWith("index.astro")) continue;

  articles.push({
    slug: path.replace("./articles/", "").replace(".astro", ""),
    title: fm.title,
    description: fm.description ?? "",
    image: fm.image ?? "/images/default-article.webp",
    date: fm.date ?? "2000-01-01",
  });
}

articles.sort((a, b) => {
  const da = new Date(a.date ?? "2000-01-01").getTime();
  const db = new Date(b.date ?? "2000-01-01").getTime();
  return db - da;
});

const latestArticles: ArticleWithSlug[] = articles.slice(0, 5);

// home buttons
const homeButtons = [
  {
    title: "✨ جرب وشوف هيطلع لك إيه",
    slug: "/tests",
    img: "/images/tests.webp",
  },
  { title: "🤣 نكت مضحكة", slug: "/jokes", img: "/images/jokes.webp" },
  {
    title: "🎮 ركن الجيمنج",
    slug: "/gaming",
    img: "/images/moncellence-live.webp",
  },
  // { title: "📸 اعمل ميميز دلوقتي", slug: "/meme", img: "/images/meme.webp" },
  // { title: "🔥 روّست صاحبك", slug: "/roast", img: "/images/roast.webp" },
  // { title: "🤣 صور مضحكة", slug: "/funnyImages", img: "/images/funny.webp" },
  // { title: "حوّل PDF إلى صور 🤯", slug: "/pdf-to-images", img: "/images/pdf2imgs.webp" },
];
---

<Layout title="🤣 LOLME">
  <!-- 🔥 تثبيت التطبيق -->
  <section class="top-mini">
    <button id="install-btn" class="install-btn appbtn">📲 ثبت التطبيق</button>
    <p>جرعة خفيفة من المرح اليومي 😌</p>
  </section>

  <!-- 😂 ايموجي -->
  <div class="imojidiv">
    <div class="emoji" style="font-size:2rem;">🤣</div>
    <div class="emoji" style="left:20%;">🤣</div>
    <div class="emoji" style="left:35%;">😂</div>
    <div class="emoji" style="left:50%;">😎</div>
    <div class="emoji" style="left:65%;">🥳</div>
    <div class="emoji" style="left:80%;">🤪</div>
    <div class="emoji" style="font-size:2rem;">🥳</div>
  </div>

  <!-- 🎮 اللعب -->
  <section class="play-section">
    <h2>🎮 العب مع صحابك الآن</h2>

    <div class="play-box">
      <a href="/how-to-play" class="play-btn secondary">🚀 ابدأ لعبة جديدة</a>

      <input
        id="room-code"
        placeholder="اكتب الكود"
        maxlength="4"
        class="code-input"
      />
      <input id="player-name" placeholder="اكتب اسمك 😏" class="code-input" />

      <button id="join-game" class="play-btn secondary"> ادخل اللعبه </button>
    </div>

    <p class="game-desc">🔥 لعبة أسئلة متنوعة… كل جولة بتخليك تضحك أكتر 😏</p>
  </section>

  <!-- 🧠 الفئات (لوحدها بقى 👇) -->
  <section class="categories-section">
    <h2>🧠 من الكورة للأفلام للمعلومات… اختار وورّي صحابك مستواك 😏🔥</h2>
    <div id="home-categories" class="home-grid"></div>
  </section>

  <section class="seo-games">
    <h2>🔥 اختبارات ممكن تعجبك</h2>
    <div id="seo-games-list" class="home-grid"></div>
    <a href="/games" class="play-btn"> 🔥 شوف كل الاختبارات </a>
  </section>

  <!-- 😂 محتوى ترفيهي -->
  <section class="fun-section">
    <h2>😂 جرب حاجة تضحكك</h2>

    <div class="home-grid">
      {
        homeButtons.map((btn, i) => (
          <a href={btn.slug} class="home-card tilt-card">
            <img src={btn.img} alt={btn.title} />
            <div class="content">
              <h3>{btn.title}</h3>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 📰 مقالات -->
  <section class="articles-section">
    <h2>📰 أحدث المقالات</h2>

    <div class="articles-grid">
      {
        latestArticles.map((article) => (
          <a href={`/articles/${article.slug}`} class="article-card tilt-card">
            <img src={article.image} alt={article.title} />
            <h3>{article.title}</h3>
            <p>{article.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- scripts -->
  <script type="module" src="/js/install-btn.js"></script>
  <script src="/js/tilt-cards.js" defer></script>
  <script type="module" src="/js/codes.js"></script>
  <script type="module" src="/js/home-categories.js"></script>
  <script type="module" src="/js/home-seo-games.js"></script>
</Layout>
