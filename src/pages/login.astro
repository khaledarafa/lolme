
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="تسجيل الدخول" description="سجّل دخولك إلى LOLME">
  <section class="auth-card">
    <h2>👋 أهلًا بعودتك</h2>
    <p class="intro">سجّل دخولك لمتابعة حسابك.</p>

    <form id="login-form">
      <label for="login-email">البريد الإلكتروني</label>
      <input id="login-email" type="email" autocomplete="email" required />

      <label for="login-password">كلمة المرور</label>
      <input
        id="login-password"
        type="password"
        autocomplete="current-password"
        required
      />

      <button id="login-submit" type="submit">تسجيل الدخول</button>
    </form>

    <p><a href="/forgot-password">نسيت كلمة المرور؟</a></p>

    <div class="separator">أو</div>
    <button id="google-login" class="google-btn" type="button">
      🌐 الدخول باستخدام Google
    </button>

    <p id="auth-message" role="status" aria-live="polite"></p>
    <p class="auth-links">ليس لديك حساب؟ <a href="/register">أنشئ حسابًا</a></p>
  </section>

  <script type="module" src="/js/login.js"></script>

  <style>
    .auth-card {
      max-width: 440px;
      margin: 24px auto;
      padding: 26px;
      border: 1px solid #374151;
      border-radius: 18px;
      background: #17212f;
      color: #fff;
      box-shadow: 0 8px 30px #0002;
    }

    .auth-card h2,
    .intro,
    .auth-links,
    .separator {
      text-align: center;
    }

    .intro { color: #cbd5e1; margin-bottom: 24px; }

    .auth-card form { display: grid; gap: 10px; }

    .auth-card input {
      box-sizing: border-box;
      width: 100%;
      padding: 13px;
      border: 1px solid #475569;
      border-radius: 9px;
      background: #0f1723;
      color: #fff;
      font: inherit;
      margin-bottom: 8px;
    }

    .auth-card button {
      width: 100%;
      padding: 12px;
      border: 0;
      border-radius: 9px;
      background: #16c765;
      color: #06140b;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .auth-card button:disabled { opacity: .6; cursor: wait; }

    .auth-card .google-btn { background: #fff; color: #222; }
    .auth-card a { color: #16c765; }
    .separator { margin-top: 18px; }
    #auth-message { overflow-wrap: anywhere; line-height: 1.7; }
  </style>
</Layout>
