import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main class="home-grid single-card">
        <!-- <a id="host-start" class="home-card tilt-card start-card">
            <img src="/images/default-og.webp" alt="ابدأ لعبة" />
            <div class="content">
                <h3>🎯 ابدأ لعبة خاصة 🔥</h3>
