---
// src/pages/room/[code].astro
const { code } = Astro.params;
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <h1>🎮 غرفة اللعبة</h1>
    <p>الكود: {code}</p>
    <div id="role-box"></div>
    <!-- players -->
    <div id="players" data-code={code}></div>
    <div id="me-box"></div>

    <!-- host controls -->
    
        <div id="category-buttons" class="category-buttons">
            <button class="cat-btn" data-cat="funny">😂 مضحك</button>
            <button class="cat-btn" data-cat="truth">😏 صراحة</button>
            <button class="cat-btn" data-cat="deep">🧠 عميق</button>
            <button class="cat-btn" data-cat="friends">👯 صحاب</button>
            <button class="cat-btn" data-cat="love">❤️ حب</button>
            <button class="cat-btn" data-cat="challenge">🔥 تحدي</button>
            <button class="cat-btn" data-cat="embarrassing">😳 إحراج</button>
        </div>
        
    <div id="host-controls" class="host-box">
        <h3>👑 تحكم الهوست</h3>
        <button id="start-game">🚀 ابدأ اللعبة</button>
        <button id="end-game">❌ اقفل الروم</button>
        <button id="next-question">➡️ السؤال اللي بعده</button>
        <button id="show-results">📊 عرض النتائج</button>
    </div>

    <div id="question-box"></div>
    <div id="results-box"></div>

    <script type="module">
        import { db } from "/js/firebase.js";
        import {
            doc,
            onSnapshot,
            updateDoc,
            deleteDoc,
            collection,
            query,
            where,
            getDocs,
            getDoc,
        } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

        async function calculateScores(data) {
            const category = data.questionCategory;
            const currentIndex = data.currentIndex?.[category] ?? 0;

            const currentAnswers =
                data.answers?.[category]?.[currentIndex] || {};

            const startTime =
  data.questionStartTimes?.[`${category}_${currentIndex}`];
            const isCorrect =
  normalize(ans.answer) === normalize(ans.correctAnswer);

            // ❌ امسح currentQuestion من هنا
            if (data.scoredQuestions?.[`${category}_${currentIndex}`]) {
                console.log("⛔ السؤال ده اتحسب قبل كده");
                return;
            }

            let results = [];

            Object.entries(currentAnswers).forEach(([id, ans]) => {
                let diff = 0;

                if (startTime && ans.time) {
                    diff = (ans.time - startTime) / 1000;
                }

                const normalize = (str) => str?.trim().replace(/\s+/g, " ");

                const isCorrect =
                    normalize(ans.answer) === normalize(correctAnswer);

                results.push({
                    id,
                    time: diff,
                    correct: isCorrect,
                });
            });

            for (const r of results) {
                const prevScore = data.players?.[r.id]?.score || 0;

                // 👇 خلي عندك score حقيقي
                const score = r.correct ? Math.max(10 - r.time, 1) : 0;

                await updateDoc(roomRef, {
                    [`players.${r.id}.score`]: prevScore + score,
                });
            }

            // 👇 مهم عشان ما يتحسبش مرتين
            await updateDoc(roomRef, {
                [`scoredQuestions.${category}_${currentIndex}`]: true,
            });
        }
        document
            .getElementById("next-question")
            ?.addEventListener("click", async () => {
                const snap = await getDoc(roomRef);
                const data = snap.data();

                await calculateScores(data);
                const category = data.questionCategory;
                const currentIndex = data.currentIndex?.[category] ?? -1;
                const nextIndex = currentIndex + 1;

                const list = data.questionsList || [];

                if (nextIndex >= list.length) {
                    document.getElementById("question-box").innerHTML = `
                        <div class="question-card">
                            <h2>🏁 خلصت الأسئلة في الفئة دي</h2>
                        </div>
                    `;
                    return;
                }

                const q = list[nextIndex];
await updateDoc(roomRef, {
    [`currentIndex.${category}`]: nextIndex,
    question: q,
    [`answers.${category}.${nextIndex}`]: {},

    [`questionStartTimes.${category}_${nextIndex}`]: Date.now(), // 👈 المهم
});
            });
        const container = document.getElementById("players");
        const controls = document.getElementById("host-controls");

        const roomCode = container.dataset.code;
        let playerId;

        function loadPlayerId() {
            playerId = localStorage.getItem("player_" + roomCode);
            console.log("🧠 playerId:", playerId);
        }

        const meBox = document.getElementById("me-box");
        const roomRef = doc(db, "rooms", roomCode);

        loadPlayerId();
        async function loadCategoryCounts() {
            const catButtons = document.querySelectorAll(".cat-btn");

            for (const btn of catButtons) {
                const category = btn.dataset.cat;

                const q = query(
                    collection(db, "questions"),
                    where("approved", "==", true),
                    where("category", "==", category),
                );

                const snap = await getDocs(q);

                const count = snap.size;

                // 👇 نضيف العدد على الزرار
                btn.innerHTML += ` (${count})`;
            }
        }
        loadCategoryCounts();

        async function getRandomQuestionFromCategory(category) {
            const q = query(
                collection(db, "questions"),
                where("approved", "==", true),
                where("category", "==", category),
            );

            const snap = await getDocs(q);

            const list = snap.docs.map((doc) => doc.data());

            if (list.length === 0) return null;

            return list[Math.floor(Math.random() * list.length)];
        }

        const catButtons = document.querySelectorAll(".cat-btn");

catButtons.forEach((btn) => {
    btn.addEventListener("click", async () => {
        const snap = await getDoc(roomRef);
        const data = snap.data();

        if (playerId !== data.hostId) return;

        // UI
        catButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        const category = btn.dataset.cat;

        await updateDoc(roomRef, {
            questionCategory: category,

            // 👇 مهم جدًا
            question: null,
            questionsList: [],

            // 👇 نبدأ الفئة دي من الأول
            [`currentIndex.${category}`]: -1,
        });
    });
});

        // 🔥 هنا تحط الكود ده
        (async () => {
            const snap = await getDoc(roomRef);
            const data = snap.data();

            if (!data) return;

            if (playerId) {
                await updateDoc(roomRef, {
                    [`players.${playerId}`]: {
                        name: data.players?.[playerId]?.name || "لاعب 😏",
                        score: data.players?.[playerId]?.score || 0,
                        lastSeen: Date.now(),
                    },
                });

                console.log("🔄 رجعنا اللاعب (ممكن يكون هوست)");
            }
        })();

        // 🔄 realtime
        onSnapshot(roomRef, (snap) => {
            const data = snap.data();

            if (!data) {
                container.innerHTML = "الروم اتقفلت 👋";
                return;
            }

            console.log("👀 me:", playerId);
            console.log("👑 host:", data.hostId);
            console.log("🎯 isHost:", playerId === data.hostId);

            console.log("🔥 room:", data);
            const roleBox = document.getElementById("role-box");
            const now = Date.now();

            const activePlayers = Object.entries(data.players || {}).filter(
                ([id, player]) => now - (player.lastSeen || 0) < 4000,
            );

            const playersCount = activePlayers.length;
            if (playerId === data.hostId) {
                roleBox.innerHTML = `
  👑 انت الهوست - انت اللي بتتحكم
  <br>👥 عدد اللاعبين: ${playersCount}
`;
            } else {
                roleBox.innerHTML = "🎮 انت لاعب";
            }
            // 👥 players
            container.innerHTML = "<h3>👥 اللاعبين:</h3>";

            Object.entries(data.players || {}).forEach(([id, player]) => {
                const div = document.createElement("div");
                // div.textContent = player.name + " (" + id.slice(-4) + ")";
                div.className = "player-card";
                if (id === playerId) {
                    div.style.border = "2px solid #22c55e";
                }
                div.innerHTML = `
                    <span>${player.name}</span>
                    ${id === data.hostId ? "👑" : ""}
                `;
                if (id === data.hostId) {
                    div.textContent += " 👑";
                }

                container.appendChild(div);
            });
            const myName = data.players?.[playerId]?.name;

            if (myName) {
                meBox.innerHTML = `
                    <div class="me-card">
                        🎯 انت: ${myName} ${playerId === data.hostId ? "👑 (هوست)" : ""}
                    </div>
                `;
            }
            const questionBox = document.getElementById("question-box");
            const category = data.questionCategory;
            const currentIndex = data.currentIndex?.[category] ?? 0;

            const myAnswer =
                data.answers?.[category]?.[currentIndex]?.[playerId]?.answer;

            const q = data.question;
            const correctAnswer = data.question?.correct;

            console.log("🧠 السؤال الحالي:", data.question);
            console.log("✅ الصح:", correctAnswer);
            console.log("👈 اختياري:", myAnswer);
            if (q) {
                let feedbackHTML = "";

                if (myAnswer) {
                    const isCorrect = myAnswer === correctAnswer;

                    feedbackHTML = `
    <div class="feedback ${isCorrect ? "correct" : "wrong"}">
      ${isCorrect ? "✅ إجابة صح يا بطل!" : "❌ غلط يا نجم 😏"}
    </div>
  `;
                }
                questionBox.innerHTML = `
                    <div class="question-card">
                        <h2>${q.text}</h2>
                        <div class="answers">
                        ${q.options
                            .map(
                                (opt) => `
                            <button class="answer-btn" data-answer="${opt}">
                            ${opt}
                            </button>
                        `,
                            )
                            .join("")}
                        </div>
        ${feedbackHTML}
                    </div>
                    `;

                // 🔥 هنا بقى المهم
                document.querySelectorAll(".answer-btn").forEach((btn) => {
                    const answer = btn.dataset.answer;

                    // 🔒 لو جاوب قبل كده
                    if (myAnswer) {
                        btn.disabled = true;

                        if (answer === myAnswer) {
                            btn.style.background = "#3b82f6"; // اختياره
                        }
                    }

btn.addEventListener("click", async () => {
    if (myAnswer) return;

    const snap = await getDoc(roomRef);
    const data = snap.data();

    const startTime =
      data.questionStartTimes?.[`${category}_${currentIndex}`];

    // 🚫 لو لسه مفيش startTime
    if (!startTime) {
        console.log("⏳ لسه السؤال ما بدأش");
        return;
    }

    await updateDoc(roomRef, {
        [`answers.${category}.${currentIndex}.${playerId}`]: {
            answer,
            correctAnswer,
            category,
            questionIndex: currentIndex,
            time: Date.now(),
        },
    });
});
                });
            }

            const currentAnswers =
                data.answers?.[category]?.[currentIndex] || {};

            let fastestPlayer = null;
            let fastestTime = Infinity;

            Object.entries(currentAnswers).forEach(([id, ans]) => {
                if (ans.time < fastestTime) {
                    fastestTime = ans.time;
                    fastestPlayer = id;
                }
            });

            if (fastestPlayer) {
                console.log("🏆 أسرع لاعب:", fastestPlayer);
            }

            const resultBox = document.getElementById("results-box");

            const startTime =
  data.questionStartTimes?.[`${category}_${currentIndex}`];

            let results = [];

            Object.entries(currentAnswers).forEach(([id, ans]) => {
                let diff = 0;

                if (startTime && ans.time) {
                    diff = (ans.time - startTime) / 1000;
                }

                const normalize = (str) => str?.trim().replace(/\s+/g, " ");

                const isCorrect =
                    normalize(ans.answer) === normalize(correctAnswer);

                results.push({
                    id,
                    time: diff,
                    correct: isCorrect,
                });
            });
            results.sort((a, b) => a.time - b.time);
            resultBox.innerHTML = `
                <div class='results-card'>
                    <h3>⚡ ترتيب السرعة:</h3>
                </div>
                `;
            resultBox.innerHTML =
                "<div class='results-card'><h3>⚡ أسرع اللاعبين:</h3></div>";

            results.forEach((r, index) => {
                const name = data.players[r.id]?.name || "لاعب";

                const isMe = r.id === playerId;

                const div = document.createElement("div");
                const isHost = playerId === data.hostId;

                if (isHost) {
                    // 👑 الهوست يشوف كله
                    div.className = `result-item ${
                        r.correct ? "correct-player" : "wrong-player"
                    }`;
                } else {
                    // 🎮 اللاعب يشوف نفسه بس
                    if (isMe) {
                        div.className = `result-item ${
                            r.correct ? "correct-player" : "wrong-player"
                        }`;
                    } else {
                        div.className = "result-item"; // عادي بدون ألوان
                    }
                }
                div.innerHTML = `
  <span>
    ${index === 0 ? "🏆" : "⚡"} 
    ${name}
    ${isMe ? "👉 (انت)" : ""}
  </span>
  <span>
  ${r.time ? r.time.toFixed(2) + "s" : "--"}
</span>
`;

                resultBox.querySelector(".results-card").appendChild(div);
            });

            // 👑 تحديد الهوست
            const isHost = playerId && playerId === data.hostId;
            controls.style.display = isHost ? "block" : "none";

            // 🎮 حالة اللعبة
            if (data.status === "playing") {
                console.log("🔥 اللعبة بدأت!");
                document.body.style.background = "#111";
            }
        });

        // 🚀 start game
        document
            .getElementById("start-game")
            ?.addEventListener("click", async () => {
                const snap = await getDoc(roomRef);
                const data = snap.data();

                const category = data.questionCategory;

                if (!category) {
                    alert("اختار فئة الأول يا نجم 😏");
                    return;
                }

                const qSnap = await getDocs(
                    query(
                        collection(db, "questions"),
                        where("approved", "==", true),
                        where("category", "==", category),
                    ),
                );

                const list = qSnap.docs.map((doc) => doc.data());

                // shuffle
                list.sort(() => Math.random() - 0.5);

                if (list.length === 0) {
                    document.getElementById("question-box").innerHTML = `
                        <div class="question-card">
                            <h2>😅 مفيش أسئلة في الفئة دي</h2>
                        </div>
                    `;
                    return;
                }

                await updateDoc(roomRef, {
                    status: "playing",

                    questionsList: list,
                    question: list[0],

                    // 👇 مهم
                    [`answers.${category}`]: {},
                    [`currentIndex.${category}`]: 0,

[`questionStartTimes.${category}_0`]: Date.now()
                });
            });
        // ❌ end game
        document
            .getElementById("end-game")
            ?.addEventListener("click", async () => {
                await deleteDoc(roomRef);
                alert("الروم اتقفلت 👋");
                window.location.href = "/";
            });
        document
            .getElementById("show-results")
            ?.addEventListener("click", () => {
                window.location.href = `/room/${roomCode}/results`;
            });
    </script>
</Layout>
// setInterval(() => {
    //   if (!playerId) return;
    //   updateDoc(roomRef, {
    //     [`players.${playerId}.lastSeen`]: Date.now(),
    //   });
    // }, 2000);
}
