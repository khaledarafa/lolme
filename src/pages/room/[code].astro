---
// src/pages/room/[code].astro
const { code } = Astro.params;
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <h1>🎮 غرفة اللعبة</h1>
    <p>الكود: {code}</p>
    <div id="role-box"></div>
    <!-- players -->
    <div id="players" data-code={code}></div>
    <div id="me-box"></div>

    <!-- host controls -->
    <div id="host-controls" class="host-box">
        <h3>👑 تحكم الهوست</h3>

        <button id="start-game">🚀 ابدأ اللعبة</button>
        <button id="end-game">❌ اقفل الروم</button>
        <button id="next-question">➡️ السؤال اللي بعده</button>
        <button id="show-results">📊 عرض النتائج</button>
    </div>

    <div id="question-box"></div>
    <div id="results-box"></div>

    <script type="module">
        import { db } from "/js/firebase.js";
        import {
            doc,
            onSnapshot,
            updateDoc,
            deleteDoc,
        } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
        import { questions } from "/data/questions.js";

        import { getDoc } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

        async function calculateScores(data) {
            const currentAnswers = data.answers?.[data.currentQuestion] || {};
            const startTime = data.questionStartTimes?.[data.currentQuestion];
            const q = questions[data.currentQuestion % questions.length];
            const correctAnswer = q.correct;

            if (data.scoredQuestions?.[data.currentQuestion]) {
                console.log("⛔ السؤال ده اتحسب قبل كده");
                return;
            }

            let results = [];

            Object.entries(currentAnswers).forEach(([id, ans]) => {
                let diff = 0;

                if (startTime && ans.time) {
                    diff = (ans.time - startTime) / 1000;
                }

                const normalize = (str) => str?.trim().replace(/\s+/g, " ");

                const isCorrect =
                    normalize(ans.answer) === normalize(correctAnswer);

                results.push({
                    id,
                    time: diff,
                    correct: isCorrect, // 🔥 دي كانت ناقصة
                });
            });
            for (const r of results) {
                const prevScore = data.players?.[r.id]?.score || 0;

                await updateDoc(roomRef, {
                    [`players.${r.id}.score`]: prevScore + r.score,
                });
            }

            await updateDoc(roomRef, {
                [`scoredQuestions.${data.currentQuestion}`]: true,
            });
        }
        document
            .getElementById("next-question")
            ?.addEventListener("click", async () => {
                const snap = await getDoc(roomRef);
                const data = snap.data();

                await calculateScores(data);
                const nextIndex = (data.currentQuestion ?? -1) + 1;

                const q = questions[nextIndex % questions.length];

                await updateDoc(roomRef, {
                    currentQuestion: nextIndex,
                    question: q,
                    questionStartTimes: {
                        ...(data.questionStartTimes || {}), // 🔥 دي السحر
                        [nextIndex]: Date.now(),
                    }, // 🔥 مهم جداً
                    [`answers.${nextIndex}`]: {},
                });
            });
        const container = document.getElementById("players");
        const controls = document.getElementById("host-controls");

        const roomCode = container.dataset.code;
        let playerId;

        function loadPlayerId() {
            playerId = localStorage.getItem("player_" + roomCode);
            console.log("🧠 playerId:", playerId);
        }

        const meBox = document.getElementById("me-box");
        const roomRef = doc(db, "rooms", roomCode);

        loadPlayerId();

setInterval(() => {
  if (!playerId) return;

  updateDoc(roomRef, {
    [`players.${playerId}.lastSeen`]: Date.now(),
  });
}, 2000);

        // 🔥 هنا تحط الكود ده
        (async () => {
            const snap = await getDoc(roomRef);
            const data = snap.data();

            if (!data) return;

            if (playerId) {
                await updateDoc(roomRef, {
                    [`players.${playerId}`]: {
                        name: data.players?.[playerId]?.name || "لاعب 😏",
                        score: data.players?.[playerId]?.score || 0,
                        lastSeen: Date.now(),
                    },
                });

                console.log("🔄 رجعنا اللاعب (ممكن يكون هوست)");
            }
        })();
        function getRandomQuestion() {
            return questions[Math.floor(Math.random() * questions.length)];
        }

        // 🔄 realtime
        onSnapshot(roomRef, (snap) => {
            const data = snap.data();

            if (!data) {
                container.innerHTML = "الروم اتقفلت 👋";
                return;
            }

            console.log("👀 me:", playerId);
            console.log("👑 host:", data.hostId);
            console.log("🎯 isHost:", playerId === data.hostId);

            console.log("🔥 room:", data);
            const roleBox = document.getElementById("role-box");
const now = Date.now();

const activePlayers = Object.entries(data.players || {}).filter(
  ([id, player]) => now - (player.lastSeen || 0) < 4000
);

const playersCount = activePlayers.length;
            if (playerId === data.hostId) {
                roleBox.innerHTML = `
  👑 انت الهوست - انت اللي بتتحكم
  <br>👥 عدد اللاعبين: ${playersCount}
`;
            } else {
                roleBox.innerHTML = "🎮 انت لاعب";
            }
            // 👥 players
            container.innerHTML = "<h3>👥 اللاعبين:</h3>";

            Object.entries(data.players || {}).forEach(([id, player]) => {
                const div = document.createElement("div");
                // div.textContent = player.name + " (" + id.slice(-4) + ")";
                div.className = "player-card";
                if (id === playerId) {
                    div.style.border = "2px solid #22c55e";
                }
                div.innerHTML = `
                    <span>${player.name}</span>
                    ${id === data.hostId ? "👑" : ""}
                `;
                if (id === data.hostId) {
                    div.textContent += " 👑";
                }

                container.appendChild(div);
            });
            const myName = data.players?.[playerId]?.name;

            if (myName) {
                meBox.innerHTML = `
                    <div class="me-card">
                        🎯 انت: ${myName} ${playerId === data.hostId ? "👑 (هوست)" : ""}
                    </div>
                `;
            }
            const questionBox = document.getElementById("question-box");
            const myAnswer =
                data.answers?.[data.currentQuestion]?.[playerId]?.answer;

            const q = questions[data.currentQuestion % questions.length];
            const correctAnswer = q.correct;
            console.log("🧠 السؤال الحالي:", data.question);
            console.log("✅ الصح:", correctAnswer);
            console.log("👈 اختياري:", myAnswer);
            if (q) {
                let feedbackHTML = "";

                if (myAnswer) {
                    const isCorrect = myAnswer === correctAnswer;

                    feedbackHTML = `
    <div class="feedback ${isCorrect ? "correct" : "wrong"}">
      ${isCorrect ? "✅ إجابة صح يا بطل!" : "❌ غلط يا نجم 😏"}
    </div>
  `;
                }
                questionBox.innerHTML = `
                    <div class="question-card">
                        <h2>${q.text}</h2>
                        <div class="answers">
                        ${q.options
                            .map(
                                (opt) => `
                            <button class="answer-btn" data-answer="${opt}">
                            ${opt}
                            </button>
                        `,
                            )
                            .join("")}
                        </div>
        ${feedbackHTML}
                    </div>
                    `;

                // 🔥 هنا بقى المهم
                document.querySelectorAll(".answer-btn").forEach((btn) => {
                    const answer = btn.dataset.answer;

                    // 🔒 لو جاوب قبل كده
                    if (myAnswer) {
                        btn.disabled = true;

                        if (answer === myAnswer) {
                            btn.style.background = "#3b82f6"; // اختياره
                        }
                    }

                    btn.addEventListener("click", async () => {
                        if (myAnswer) return;

                        await updateDoc(roomRef, {
                            [`answers.${data.currentQuestion}.${playerId}`]: {
                                answer: answer,
                                time: Date.now(),
                            },
                        });
                    });
                });
            }

            const currentAnswers = data.answers?.[data.currentQuestion] || {};

            let fastestPlayer = null;
            let fastestTime = Infinity;

            Object.entries(currentAnswers).forEach(([id, ans]) => {
                if (ans.time < fastestTime) {
                    fastestTime = ans.time;
                    fastestPlayer = id;
                }
            });

            if (fastestPlayer) {
                console.log("🏆 أسرع لاعب:", fastestPlayer);
            }

            const resultBox = document.getElementById("results-box");

            const startTime = data.questionStartTimes?.[data.currentQuestion];

            let results = [];

            Object.entries(currentAnswers).forEach(([id, ans]) => {
                let diff = 0;

                if (startTime && ans.time) {
                    diff = (ans.time - startTime) / 1000;
                }

                const normalize = (str) => str?.trim().replace(/\s+/g, " ");

                const isCorrect =
                    normalize(ans.answer) === normalize(correctAnswer);

                results.push({
                    id,
                    time: diff,
                    correct: isCorrect,
                });
            });
            results.sort((a, b) => a.time - b.time);
            resultBox.innerHTML = `
                <div class='results-card'>
                    <h3>⚡ ترتيب السرعة:</h3>
                </div>
                `;
            resultBox.innerHTML =
                "<div class='results-card'><h3>⚡ أسرع اللاعبين:</h3></div>";

            results.forEach((r, index) => {
                const name = data.players[r.id]?.name || "لاعب";

                const isMe = r.id === playerId;

                const div = document.createElement("div");
const isHost = playerId === data.hostId;

if (isHost) {
  // 👑 الهوست يشوف كله
  div.className = `result-item ${
    r.correct ? "correct-player" : "wrong-player"
  }`;
} else {
  // 🎮 اللاعب يشوف نفسه بس
  if (isMe) {
    div.className = `result-item ${
      r.correct ? "correct-player" : "wrong-player"
    }`;
  } else {
    div.className = "result-item"; // عادي بدون ألوان
  }
}
                div.innerHTML = `
  <span>
    ${index === 0 ? "🏆" : "⚡"} 
    ${name}
    ${isMe ? "👉 (انت)" : ""}
  </span>
  <span>
  ${r.time ? r.time.toFixed(2) + "s" : "--"}
</span>
`;

                resultBox.querySelector(".results-card").appendChild(div);
            });
            // 👑 تحديد الهوست
            const isHost = playerId && playerId === data.hostId;
            controls.style.display = isHost ? "block" : "none";

            // 🎮 حالة اللعبة
            if (data.status === "playing") {
                console.log("🔥 اللعبة بدأت!");
                document.body.style.background = "#111";
            }
        });

        // 🚀 start game
        document
            .getElementById("start-game")
            ?.addEventListener("click", async () => {
                const snap = await getDoc(roomRef);
                const data = snap.data();

                const q = getRandomQuestion();

                await updateDoc(roomRef, {
                    status: "playing",
                    currentQuestion: 0,
                    question: q,
                    questionStartTimes: {
                        0: Date.now(),
                    },
                    answers: {},
                });
            });
        // ❌ end game
        document
            .getElementById("end-game")
            ?.addEventListener("click", async () => {
                await deleteDoc(roomRef);
                alert("الروم اتقفلت 👋");
                window.location.href = "/";
            });
        document
            .getElementById("show-results")
            ?.addEventListener("click", () => {
                window.location.href = `/room/${roomCode}/results`;
            });
    </script>
</Layout>
