---
const { code } = Astro.params;
import Layout from "../../../layouts/Layout.astro";
---

<Layout>
    <div class="top-bar">
        <div class="left">
            <span>🎮 كود الغرفة: {code}</span>
            <button id="end-game" class="end-btn">❌ اقفل الروم</button>
            <button id="open-admin">👑 شاشة الأدمن</button>
        </div>

        <div class="center">
            <div id="answer-progress" class="answer-progress"></div>
            <div id="not-answered-list" class="not-answered"></div>
        </div>

        <div class="right">
            <button id="show-results" style="display:none;"
                >📊 عرض النتائج</button
            >
        </div>
    </div>

    <div id="players-section" data-code={code}></div>
    <div class="suggest-box">
        <button id="send-suggest-admin">إرسال</button>
        <input id="suggest-input-admin" placeholder="اقترح فئة 😏" />
    </div>

    <div class="suggestions-wrapper">
        <div id="suggestions-list" class="suggestions-list"></div>
    </div>

    <div class="board" id="board"></div>

    <div id="question-sheet" class="sheet hidden">
        <div class="sheet-content" id="sheet-content">
            <!-- 👇 هنا -->
            <!-- <button id="hint-btn">💡 تلميح</button>
            <p id="hint-box" style="display:none;"></p> -->
        </div>
    </div>

    <div id="image-modal" class="image-modal hidden">
        <span id="close-image">❌</span>
        <img id="modal-img" />
    </div>
</Layout>

<script
    src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"
></script>
<script type="module">
    import {
        db,
        doc,
        onSnapshot,
        updateDoc,
        getDoc,
        deleteDoc,
        getDocs,
        collection,
    } from "/js/firebase.js";

    const roomCode =
        document.querySelector(".board").dataset?.code ||
        window.location.pathname.split("/")[2];

    const roomRef = doc(db, "rooms", roomCode);
    const winSound = new Audio("/sounds/winn.mp3");
    const loseSound = new Audio("/sounds/lose.mp3");
    function normalize(text) {
        return text
            .toLowerCase()
            .trim()
            .replace(/[\u064B-\u065F]/g, "")
            .replace(/أ|إ|آ/g, "ا")
            .replace(/ى/g, "ي")
            .replace(/ة/g, "ه");
    }

    function levenshtein(a, b) {
        const matrix = [];

        for (let i = 0; i <= b.length; i++) matrix[i] = [i];
        for (let j = 0; j <= a.length; j++) matrix[0][j] = j;

        for (let i = 1; i <= b.length; i++) {
            for (let j = 1; j <= a.length; j++) {
                if (b[i - 1] === a[j - 1]) {
                    matrix[i][j] = matrix[i - 1][j - 1];
                } else {
                    matrix[i][j] = Math.min(
                        matrix[i - 1][j - 1] + 1,
                        matrix[i][j - 1] + 1,
                        matrix[i - 1][j] + 1,
                    );
                }
            }
        }

        return matrix[b.length][a.length];
    }

    function isCorrectAnswer(userAnswer, correctAnswer) {
        const user = normalize(userAnswer);
        const correct = normalize(correctAnswer);

        const distance = levenshtein(user, correct);

        return distance <= 1;
    }
    let categoriesMap = {};
    let currentQuestion = null;

    async function loadCategoriesMap() {
        const snap = await getDocs(collection(db, "categories"));

        snap.forEach((doc) => {
            const cat = doc.data();
            categoriesMap[cat.slug] = { image: cat.image, name: cat.name };
        });
    }

    await loadCategoriesMap();

    function playWinEffect() {
        winSound.currentTime = 0;
        winSound.play();

        // 💥 انفجار في النص
        confetti({
            particleCount: 100,
            spread: 70,
            origin: { y: 0.6 },
        });

        // 👉 من اليمين
        confetti({
            particleCount: 60,
            angle: 120,
            spread: 55,
            origin: { x: 1 },
        });

        // 👈 من الشمال
        confetti({
            particleCount: 60,
            angle: 60,
            spread: 55,
            origin: { x: 0 },
        });

        // 🎯 من فوق
        confetti({
            particleCount: 80,
            spread: 100,
            origin: { y: 0 },
        });

        // 🌸 ورد (pink vibes 😂)
        confetti({
            particleCount: 50,
            spread: 80,
            colors: ["#ff69b4", "#ffc0cb", "#ff1493"],
        });

        // 🔁 شغل مستمر (حلاوة بقى)
        const duration = 1500;
        const end = Date.now() + duration;

        (function frame() {
            confetti({
                particleCount: 4,
                angle: 60,
                spread: 55,
                origin: { x: 0 },
            });
            confetti({
                particleCount: 4,
                angle: 120,
                spread: 55,
                origin: { x: 1 },
            });

            if (Date.now() < end) {
                requestAnimationFrame(frame);
            }
        })();
    }

    function playLoseEffect() {
        loseSound.currentTime = 0;
        loseSound.play();

        document.body.classList.add("shake");
        setTimeout(() => {
            document.body.classList.remove("shake");
        }, 300);
    }
    const board = document.getElementById("board");
    let playerId = localStorage.getItem("player_" + roomCode);

    (async () => {
        const snap = await getDoc(roomRef);
        const data = snap.data();

        if (!data || playerId !== data.hostId || data.adminMode !== "admin") {
            alert("❌ مش أدمن يا نجم 😏");
            window.location.href = `/room/${roomCode}/board`;
            return;
        }

        document.body.style.display = "block";
    })();

    // ✅ عند الخروج
    window.addEventListener("beforeunload", () => {
        if (playerId) {
            updateDoc(roomRef, {
                [`players.${playerId}.lastSeen`]: Date.now(),
            });
        }
    });

    // ✅ عند الدخول
    (async () => {
        if (!playerId) return;

        const snap = await getDoc(roomRef);
        const data = snap.data();

        if (!data) return;

        await updateDoc(roomRef, {
            [`players.${playerId}`]: {
                name: data.players?.[playerId]?.name || "لاعب 😏",
                score: data.players?.[playerId]?.score || 0,
                lastSeen: Date.now(),
            },
        });
    })();

    let lastCount = 0;
    const msgSound = new Audio("/sounds/msg.mp3");
    let soundEnabled = false;

    document.addEventListener("click", () => {
        if (!soundEnabled) {
            msgSound
                .play()
                .then(() => {
                    msgSound.pause();
                    msgSound.currentTime = 0;
                    soundEnabled = true;
                })
                .catch(() => {});
        }
    });
    onSnapshot(roomRef, (snap) => {
        const data = snap.data();

        const progressBox = document.getElementById("answer-progress");
        const notAnsweredBox = document.getElementById("not-answered-list");

        const currentQ = data.currentQuestion;

        let totalPlayers = Object.keys(data.players || {}).length;
        let answeredPlayers = 0;
        let notAnsweredNames = [];

        progressBox.classList.remove("green", "red", "waiting");

        if (!currentQ) {
            // ⚪ مفيش سؤال
            progressBox.innerText = "🎯 اختار سؤال الأول";
            progressBox.classList.add("waiting");
            notAnsweredBox.innerText = "";
        } else {
            const key = `${currentQ.categoryIndex}_${currentQ.questionIndex}`;
            const answersForQ = data.answers?.[key] || {};

            const answeredIds = Object.keys(answersForQ);
            answeredPlayers = answeredIds.length;

            // 👇 نجيب اللي ما جاوبوش
            Object.entries(data.players || {}).forEach(([id, player]) => {
                if (!answeredIds.includes(id)) {
                    notAnsweredNames.push(player.name);
                }
            });

            if (answeredPlayers === totalPlayers && totalPlayers > 0) {
                // 🟢 كله جاوب
                progressBox.innerText = "🔥 كل اللعيبة جاوبت";
                progressBox.classList.add("green");
            } else {
                // 🔴 في ناس لسه
                progressBox.innerText = `⚠️ جاوب ${answeredPlayers} من ${totalPlayers}`;
                progressBox.classList.add("red");
            }

            // 👇 أسماء اللي لسه
            notAnsweredBox.innerText = notAnsweredNames.length
                ? `⏳ مستني: ${notAnsweredNames.join(" - ")}`
                : "";
        }
        const messages = data.suggestions || [];
        const list = document.getElementById("suggestions-list");

        if (list) {
            list.innerHTML = messages
                .map((m) => {
                    const name =
                        m.playerName ||
                        data.players?.[m.player]?.name ||
                        "لاعب 😏";

                    return `
                <div class="suggest-item">
                    <span class="name">${name}</span>
                    <span class="text">${m.text}</span>
                </div>
            `;
                })
                .join("");

            list.scrollTop = list.scrollHeight;
        }

        // 🔊 صوت
        if (lastCount !== 0 && messages.length > lastCount) {
            const lastMsg = messages[messages.length - 1];

            if (lastMsg.player !== playerId) {
                msgSound.currentTime = 0;
                msgSound.play().catch(() => {});
            }
        }

        lastCount = messages.length;

        const gamePlan = data.gamePlan || [];
        // if (playerId !== data.hostId) {
        //     window.location.href = `/room/${roomCode}/player`;
        // }

        const totalQuestions = data.gamePlan?.reduce((total, cat) => {
            return total + (cat.questions?.length || 0);
        }, 0);

        const answeredCount = Object.keys(data.answeredQuestions || {}).length;

        // 👇 لو كل الأسئلة اتجاوبت
        if (answeredCount >= totalQuestions && totalQuestions > 0) {
            document.getElementById("show-results").style.display =
                "inline-block";
        } else {
            document.getElementById("show-results").style.display = "none";
        }

        board.innerHTML = "";

        const section = document.getElementById("players-section");

        const playersCount = Object.keys(data.players || {}).length;

        section.innerHTML = `
            <div class="players-card compact">

                <div class="players-header">
                👥 ${playersCount}
                ${playerId === data.hostId ? " | 👑 هوست" : " | 🎮 لاعب"}
                </div>

                <div class="players-list">
                ${Object.entries(data.players || {})
                    .map(
                        ([id, player]) => `
                    <span class="player-chip ${id === playerId ? "me" : ""}">
                    ${player.name} ${id === data.hostId ? "👑" : ""}
                    </span>
                `,
                    )
                    .join("")}
                </div>

            </div>
            `;
        async function openQuestion(cat, index, catIndex) {
            const sheet = document.getElementById("question-sheet");
            const content = document.getElementById("sheet-content");

            const question = cat.questions[index];
            currentQuestion = question;

            const imageHtml = question.image
                ? `<img src="${question.image}" class="question-img" />`
                : "";

            if (!question) return;

            await updateDoc(roomRef, {
                currentQuestion: {
                    text: question.text,
                    options: question.options || [],
                    correct: question.correct,
                    type: question.type || "choice",
                    category: cat.category,
                    categoryIndex: catIndex,
                    questionIndex: index,
                    image: question.image || null,
                    hint: question.hint || null,
                },
                [`questionStartTimes.${catIndex}_${index}`]: Date.now(),
                hints: {},
            });
            if (!question) return;

            if (question.type === "text") {
                content.innerHTML = `
        <div class="question-box">

            ${imageHtml}
<h2>${question.text}</h2>
    <button id="hint-btn">💡 تلميح</button>
    <p id="hint-box" style="display:none;"></p>

            <div class="text-answer-box">
                <input id="text-answer" placeholder="اكتب إجابتك 😏" />
                <button id="send-answer">إرسال</button>
            </div>

            <div id="feedback"></div>

        </div>

        <div class="close-sheet">
            <button id="close-sheet">❌ قفل</button>
        </div>
    `;
                const hintBtn = document.getElementById("hint-btn");
                const hintBox = document.getElementById("hint-box");
                hintBox.style.display = "none";
                hintBox.innerText = "";

hintBtn.onclick = async () => {
    const snap = await getDoc(roomRef);
    const data = snap.data();
    const q = data.currentQuestion;

    if (!q) return;

    const key = `${q.categoryIndex}_${q.questionIndex}`;

    await updateDoc(roomRef, {
        [`hints.${key}`]: true
    });

    if (!q.hint) {
        hintBox.innerText = "❌ مفيش تلميح";
    } else {
        hintBox.innerText = q.hint;
    }

    hintBox.style.display = "block";
};
            } else {
                content.innerHTML = `
        <div class="question-box">

            ${imageHtml}
<h2>${question.text}</h2>
    <button id="hint-btn">💡 تلميح</button>
    <p id="hint-box" style="display:none;"></p>

            <div class="answers">
                ${question.options
                    .map(
                        (opt) => `
                    <button class="answer-btn" data-answer="${opt}">
                        ${opt}
                    </button>
                `,
                    )
                    .join("")}
            </div>

            <div id="feedback"></div>

        </div>

        <div class="close-sheet">
            <button id="close-sheet">❌ قفل</button>
        </div>
    `;
                const hintBtn = document.getElementById("hint-btn");
                const hintBox = document.getElementById("hint-box");
                hintBox.style.display = "none";
                hintBox.innerText = "";

hintBtn.onclick = async () => {
    const snap = await getDoc(roomRef);
    const data = snap.data();
    const q = data.currentQuestion;

    if (!q) return;

    const key = `${q.categoryIndex}_${q.questionIndex}`;

    await updateDoc(roomRef, {
        [`hints.${key}`]: true
    });

    if (!q.hint) {
        hintBox.innerText = "❌ مفيش تلميح";
    } else {
        hintBox.innerText = q.hint;
    }

    hintBox.style.display = "block";
};
            }
            setTimeout(() => {
                const qImg = document.querySelector(".question-img");

                if (qImg) {
                    qImg.addEventListener("click", () => {
                        const modal = document.getElementById("image-modal");
                        const modalImg = document.getElementById("modal-img");

                        modalImg.src = qImg.src;
                        modal.classList.remove("hidden");
                    });
                }
            }, 0);
            let answered = false;

            // 👇 text question
            const sendBtn = document.getElementById("send-answer");

            if (sendBtn) {
                sendBtn.addEventListener("click", async () => {
                    if (answered) return;
                    answered = true;

                    const input = document.getElementById("text-answer");
                    const answer = input.value.trim();

                    if (!answer) return;

                    const playerId = localStorage.getItem("player_" + roomCode);
                    const correctAnswer = cat.questions[index]?.correct;

                    const answeredKey = `${catIndex}_${index}`;

                    await updateDoc(roomRef, {
                        [`answers.${answeredKey}.${playerId}`]: {
                            answer,
                            correctAnswer,
                            category: cat.category,
                            questionIndex: index,
                            time: Date.now(),
                        },
                        [`answeredQuestions.${answeredKey}`]: true,
                    });

                    const feedback = document.getElementById("feedback");
                    const user = normalize(answer);
                    const correct = normalize(correctAnswer);

                    if (user === correct) {
                        playWinEffect();
                        feedback.innerHTML = `
<div class="feedback-box success">
    🔥 صح 100% يا بطل!
</div>
`;
                    } else if (isCorrectAnswer(answer, correctAnswer)) {
                        playWinEffect();
                        feedback.innerHTML = `
<div class="feedback-box success">
    😏 قريبة فشخ… هنعديها!
</div>
`;
                    } else {
                        playLoseEffect();
                        feedback.innerHTML = `
<div class="feedback-box error">
    ❌ غلط يا نجم 😏
    <br><br>
    <span class="correct-answer">✅ الإجابة الصحيحة: ${correctAnswer}</span>
</div>
`;
                    }
                });
            }

            document.querySelectorAll(".answer-btn").forEach((btn) => {
                btn.addEventListener("click", async () => {
                    if (answered) return;
                    answered = true;

                    const answer = btn.dataset.answer;
                    const playerId = localStorage.getItem("player_" + roomCode);

                    // 👇 الصح بقى
                    const correctAnswer = cat.questions[index]?.correct;

                    // 👇 نفس المفتاح اللي في البورد
                    const answeredKey = `${catIndex}_${index}`;
                    if (!playerId) {
                        alert("❌ في مشكلة في اللاعب يا نجم");
                        return;
                    }
                    await updateDoc(roomRef, {
                        [`answers.${answeredKey}.${playerId}`]: {
                            answer,
                            correctAnswer,
                            category: cat.category,
                            questionIndex: index,
                            time: Date.now(),
                        },
                        [`answeredQuestions.${answeredKey}`]: true,
                    });

                    const feedback = document.getElementById("feedback");

                    document.querySelectorAll(".answer-btn").forEach((b) => {
                        b.disabled = true;

                        const btnAnswer = b.dataset.answer;

                        // ✅ الإجابة الصح دايمًا أخضر
                        if (btnAnswer === correctAnswer) {
                            b.style.background = "#22c55e";
                            b.style.color = "#000";
                        }

                        // ❌ اللي الأدمن اختاره وكان غلط
                        else if (btnAnswer === answer) {
                            b.style.background = "#ef4444";
                            b.style.color = "#fff";
                        }

                        // 👇 باقي الاختيارات باهتة
                        else {
                            b.style.opacity = "0.4";
                        }
                    });

                    // 🔥 ده اللي كان ناقصك بصراحة
                    if (answer === correctAnswer) {
                        playWinEffect();
                        feedback.innerHTML = `
<div class="feedback-box success">
    🔥 صح يا بطل!
</div>
`;
                        feedback.style.color = "#22c55e";
                    } else {
                        playLoseEffect();

                        feedback.innerHTML = `
<div class="feedback-box error">
    ❌ غلط يا نجم 😏
    <br><br>
    <span class="correct-answer">✅ الإجابة الصحيحة: ${correctAnswer}</span>
</div>
`;
                    }

                    feedback.style.textAlign = "center";
                    feedback.style.marginTop = "10px";
                    feedback.style.fontWeight = "bold";
                });
            });
            sheet.classList.add("show");

            document.getElementById("close-sheet").onclick = () => {
                sheet.classList.remove("show");
            };
        }

        gamePlan.forEach((cat, catIndex) => {
            const col = document.createElement("div");
            col.className = "column";

            // 👇 اسم الفئة
            const title = document.createElement("div");
            title.className = "category-card";

            // title.style.backgroundImage = `url(${categoryImages[cat.category]})`;

            const realCat = cat.category;

            title.innerHTML = `
    <img src="${categoriesMap[realCat]?.image}" />
    <div class="overlay">
        ${categoriesMap[realCat]?.name || realCat}
    </div>
`;
            col.appendChild(title);

            // 👇 الكروت (قيم ثابتة)
            cat.questions.forEach((_, i) => {
                const card = document.createElement("div");
                card.className = "card";
                card.innerText = "❓";

                const answeredKey = `${catIndex}_${i}`;
                const isAnswered = data.answeredQuestions?.[answeredKey];

                if (isAnswered) {
                    card.style.opacity = "0.3";
                    card.style.pointerEvents = "none";
                    card.innerText = "✔️";
                } else {
                    card.addEventListener("click", () => {
                        openQuestion(cat, i, catIndex);
                    });
                }

                col.appendChild(card);
            });

            board.appendChild(col);
        });
    });

    document.getElementById("open-admin")?.addEventListener("click", () => {
        window.open(`/room/${roomCode}/adminwanswer`, "_blank");
    });

    // إرسال
    document
        .getElementById("send-suggest-admin")
        ?.addEventListener("click", async () => {
            const input = document.getElementById("suggest-input-admin");
            const text = input.value.trim();
            if (!text) return;

            const snap = await getDoc(roomRef);
            const data = snap.data();

            const newSuggestion = {
                text,
                player: playerId,
                playerName: data.players?.[playerId]?.name || "لاعب 😏",
                time: Date.now(),
            };

            await updateDoc(roomRef, {
                suggestions: [...(data.suggestions || []), newSuggestion],
            });

            input.value = "";
        });
    const endBtn = document.getElementById("end-game");

    endBtn?.addEventListener("click", async () => {
        if (!confirm("متأكد إنك عايز تقفل الروم؟ 😏")) return;

        // 👇 ده الجديد
        localStorage.removeItem("counted_room");

        await deleteDoc(roomRef);
        window.location.href = "/";
    });

    document.getElementById("close-image").onclick = () => {
        document.getElementById("image-modal").classList.add("hidden");
    };
    document
        .getElementById("show-results")
        ?.addEventListener("click", async () => {
            await updateDoc(roomRef, {
                showResults: true,
            });

            window.location.href = `/room/${roomCode}/results`;
        });
</script>
