---
// src/pages/room/[code].astro
const { code } = Astro.params;
import Layout from "../../../layouts/Layout.astro";
---

<Layout>
    <div class="room-container">
        <div
            style="font-size: x-large; text-align: center; 
    margin-top: 16px;"
        >
            🎮 كود الغرفه : {code}
        </div>

        <div class="room-header">
            <div class="category-dropdown">
                <button id="open-admin">👑 شاشة الأدمن</button>
                <button class="dropdown-btn">🎯 الفئات ▼</button>

                <div class="dropdown-menu">
                    <div
                        class="cat-card cat-btn"
                        data-cat="funny"
                        style="background-image:url('/images/funny.webp')"
                    >
                        <span>😂 مضحك</span>
                    </div>

                    <div
                        class="cat-card cat-btn"
                        data-cat="truth"
                        style="background-image:url('/images/truth.webp')"
                    >
                        <span>😏 صراحة</span>
                    </div>

                    <div
                        class="cat-card cat-btn"
                        data-cat="deep"
                        style="background-image:url('/images/deep.webp')"
                    >
                        <span>🧠 عميق</span>
                    </div>

                    <div
                        class="cat-card cat-btn"
                        data-cat="friends"
                        style="background-image:url('/images/friends.webp')"
                    >
                        <span>👯 صحاب</span>
                    </div>

                    <div
                        class="cat-card cat-btn"
                        data-cat="love"
                        style="background-image:url('/images/love.webp')"
                    >
                        <span>❤️ حب</span>
                    </div>

                    <div
                        class="cat-card cat-btn"
                        data-cat="challenge"
                        style="background-image:url('/images/challenge.webp')"
                    >
                        <span>🔥 تحدي</span>
                    </div>

                    <div
                        class="cat-card cat-btn"
                        data-cat="embarrassing"
                        style="background-image:url('/images/embarrassing.webp')"
                    >
                        <span>😳 إحراج</span>
                    </div>

                    <div
                        class="cat-card cat-btn"
                        data-cat="songs"
                        style="background-image:url('/images/songs.webp')"
                    >
                        <span>🎵 أغاني</span>
                    </div>

                    <div
                        class="cat-card cat-btn"
                        data-cat="football"
                        style="background-image:url('/images/football.webp')"
                    >
                        <span>⚽ كورة</span>
                    </div>

                    <div
                        class="cat-card cat-btn"
                        data-cat="hazoom"
                        style="background-image:url('/images/hazooma.jpeg')"
                    >
                        <span>💣 حزوم</span>
                    </div>
                </div>
            </div>

            <button id="start-game">🚀 ابدأ اللعبة</button>
            <button id="next-question">➡️ السؤال اللي بعده</button>
            <button id="show-results">📊 عرض النتائج</button>
            <button id="end-game">❌ اقفل الروم</button>
        </div>
        <div id="players-section" data-code={code}></div>

        <div id="question-box"></div>
        <div id="results-box"></div>

        <div class="suggest-box">
            <button id="send-suggest-admin">إرسال</button>
            <input id="suggest-input-admin" placeholder="اقترح فئة 😏" />
        </div>

        <div class="suggestions-wrapper">
            <div id="suggestions-list" class="suggestions-list"></div>
        </div>
    </div>
    <script type="module">
        import { db } from "/js/firebase.js";
        import { doc, onSnapshot, updateDoc, deleteDoc, collection, query, where, getDocs, getDoc, } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
        const normalize = (str) => str ?.toLowerCase() .trim() .replace(/[أإآ]/g, "ا") // كل الألف زي بعض .replace(/ة/g, "ه") .replace(/ى/g, "ي") .replace(/\s+/g, " ");
        async function calculateScores(data) {
            const category = data.questionCategory;
            const currentIndex = data.currentIndex?.[category] ?? 0;

            const currentAnswers =
                data.answers?.[category]?.[currentIndex] || {};

            const startTime =
                data.questionStartTimes?.[`${category}_${currentIndex}`];

            // ❌ امسح currentQuestion من هنا
            if (data.scoredQuestions?.[`${category}_${currentIndex}`]) {
                console.log("⛔ السؤال ده اتحسب قبل كده");
                return;
            }

            let results = [];

            Object.entries(currentAnswers).forEach(([id, ans]) => {
                let diff = 0;

                if (startTime && ans.time) {
                    diff = (ans.time - startTime) / 1000;
                }

                const normalize = (str) => str?.trim().replace(/\s+/g, " ");

                let isCorrect = false;

                if (Array.isArray(ans.correctAnswer)) {
                    isCorrect = ans.correctAnswer.some(
                        (c) => normalize(ans.answer) === normalize(c),
                    );
                } else {
                    isCorrect =
                        normalize(ans.answer) === normalize(ans.correctAnswer);
                }
                results.push({
                    id,
                    time: diff,
                    correct: isCorrect,
                });
            });

            for (const r of results) {
                const prevScore = data.players?.[r.id]?.score || 0;

                // 👇 خلي عندك score حقيقي
                const score = r.correct ? Math.max(10 - r.time, 1) : 0;

                await updateDoc(roomRef, {
                    [`players.${r.id}.score`]: prevScore + score,
                });
            }

            // 👇 مهم عشان ما يتحسبش مرتين
            await updateDoc(roomRef, {
                [`scoredQuestions.${category}_${currentIndex}`]: true,
            });
        }
        document
            .getElementById("next-question")
            ?.addEventListener("click", async () => {
                const snap = await getDoc(roomRef);
                const data = snap.data();

                await calculateScores(data);
                const category = data.questionCategory;
                const currentIndex = data.currentIndex?.[category] ?? -1;
                const nextIndex = currentIndex + 1;

                const list = data.questionsList || [];

                if (nextIndex >= list.length) {
                    document.getElementById("question-box").innerHTML = `
                        <div class="question-card">
                            <h2>🏁 خلصت الأسئلة في الفئة دي</h2>
                        </div>
                    `;
                    return;
                }

                const q = list[nextIndex];
                await updateDoc(roomRef, {
                    [`currentIndex.${category}`]: nextIndex,
                    question: q,
                    [`answers.${category}.${nextIndex}`]: {},

                    [`questionStartTimes.${category}_${nextIndex}`]: Date.now(), // 👈 المهم
                });
            });
        // const container = document.getElementById("players");
        const container = document.getElementById("players-section");
        const controls = document.getElementById("host-controls");

        const roomCode = container.dataset.code;
        let playerId;
        document.getElementById("open-admin")?.addEventListener("click", () => {
            window.open(`/room/${roomCode}/admin`, "_blank");
        });
        function loadPlayerId() {
            playerId = localStorage.getItem("player_" + roomCode);
            console.log("🧠 playerId:", playerId);
        }

        // const meBox = document.getElementById("me-box");
        const roomRef = doc(db, "rooms", roomCode);

        loadPlayerId();

        // sessionStorage → بيتمسح لما تعمل refresh أو تقفل التاب ✅
        async function loadCategoryCounts() {
            const catButtons = document.querySelectorAll(".cat-btn");

            // 🧠 كاش السيشن
            const cached = sessionStorage.getItem("categoryCounts");

            if (cached) {
                const counts = JSON.parse(cached);

                catButtons.forEach((btn) => {
                    const category = btn.dataset.cat;
                    if (counts[category] !== undefined) {
                        btn.innerHTML += ` (${counts[category]})`;
                    }
                });

                console.log("⚡ من السيشن");
                return;
            }

            // 🔥 أول مرة في السيشن
            const counts = {};

            for (const btn of catButtons) {
                const category = btn.dataset.cat;

                const q = query(
                    collection(db, "questions"),
                    where("approved", "==", true),
                    where("category", "==", category),
                );

                const snap = await getDocs(q);

                const count = snap.size;
                counts[category] = count;

                btn.innerHTML += ` (${count})`;
            }

            // 💾 خزّن في السيشن
            sessionStorage.setItem("categoryCounts", JSON.stringify(counts));

            console.log("💾 اتحفظ في السيشن");
        }

        loadCategoryCounts();

        const catButtons = document.querySelectorAll(".cat-btn");

        catButtons.forEach((btn) => {
            btn.addEventListener("click", async () => {
                const snap = await getDoc(roomRef);
                const data = snap.data();

                if (playerId !== data.hostId) return;

                // UI
                catButtons.forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");

                const category = btn.dataset.cat;

                await updateDoc(roomRef, {
                    questionCategory: category,

                    // 👇 مهم جدًا
                    question: null,
                    questionsList: [],

                    // 👇 نبدأ الفئة دي من الأول
                    [`currentIndex.${category}`]: -1,
                });
            });
        });

        // 🔥 هنا تحط الكود ده
        (async () => {
            const snap = await getDoc(roomRef);
            const data = snap.data();

            if (!data) return;

            if (playerId) {
                await updateDoc(roomRef, {
                    [`players.${playerId}`]: {
                        name: data.players?.[playerId]?.name || "لاعب 😏",
                        score: data.players?.[playerId]?.score || 0,
                        lastSeen: Date.now(),
                    },
                });

                console.log("🔄 رجعنا اللاعب (ممكن يكون هوست)");
            }
        })();

        // 🔄 realtime
        onSnapshot(roomRef, (snap) => {
            const data = snap.data();
            const isHost = playerId && playerId === data.hostId;
            if (playerId !== data.hostId) {
                document.body.innerHTML = "🚫 مش مسموح";
                return;
            }
            if (!data) {
                container.innerHTML = "الروم اتقفلت 👋";
                return;
            }

            console.log("👀 me:", playerId);
            console.log("👑 host:", data.hostId);
            console.log("🎯 isHost:", playerId === data.hostId);

            console.log("🔥 room:", data);
            const section = document.getElementById("players-section");

const now = Date.now();

const activePlayers = Object.entries(data.players || {}).filter(
  ([id, player]) => now - (player.lastSeen || 0) < 4000,
);

const playersCount = activePlayers.length;

// const myName = data.players?.[playerId]?.name;

section.innerHTML = `
  <div class="players-card compact">

    <div class="players-header">
      👥 ${playersCount}
      ${
        playerId === data.hostId
          ? " | 👑 هوست"
          : " | 🎮 لاعب"
      }
    </div>

    <div class="players-list">
      ${Object.entries(data.players || {})
        .map(
          ([id, player]) => `
        <span class="player-chip ${id === playerId ? "me" : ""}">
          ${player.name} ${id === data.hostId ? "👑" : ""}
        </span>
      `,
        )
        .join("")}
    </div>

  </div>
`;
            const questionBox = document.getElementById("question-box");
            const category = data.questionCategory;
            const currentIndex = data.currentIndex?.[category] ?? 0;

            const myAnswer =
                data.answers?.[category]?.[currentIndex]?.[playerId]?.answer;

            const q = data.question;
            const correctAnswer = data.question?.correct;

            console.log("🧠 السؤال الحالي:", data.question);
            console.log("✅ الصح:", correctAnswer);
            console.log("👈 اختياري:", myAnswer);
            if (q) {
                let feedbackHTML = "";

                if (myAnswer) {
                    const isCorrect =
                        normalize(myAnswer) === normalize(correctAnswer);

                    feedbackHTML = `
                        <div class="feedback ${isCorrect ? "correct" : "wrong"}">
                        ${isCorrect ? "✅ إجابة صح يا بطل!" : "❌ غلط يا نجم 😏"}
                        </div>
                    `;
                }

                if (q.type === "choice" || !q.type) {
                    questionBox.innerHTML = `
                        <div class="question-card">
                            <h2>${q.text}</h2>
<div class="admin-answer" style="
    margin-top:10px;
    padding:8px;
    background:#020617;
    border:1px solid #22c55e;
    border-radius:8px;
    color:#22c55e;
    font-size:14px;
">
     الإجابة: ${Array.isArray(correctAnswer) ? correctAnswer.join(" / ") : correctAnswer}
</div>
                            <div class="answers">
                                ${q.options
                                    .map(
                                        (opt) => `
                                    <button class="answer-btn" data-answer="${opt}">
                                        ${opt}
                                    </button>
                                `,
                                    )
                                    .join("")}
                            </div>
                            ${feedbackHTML}
                        </div>
                    `;
                } else {
                    questionBox.innerHTML = `
                        <div class="question-card">
                            <h2>${q.text}</h2>
<div class="admin-answer" style="
    margin-top:10px;
    padding:8px;
    background:#020617;
    border:1px solid #22c55e;
    border-radius:8px;
    color:#22c55e;
    font-size:14px;
">
    👑 الإجابة: ${Array.isArray(correctAnswer) ? correctAnswer.join(" / ") : correctAnswer}
</div>
                            <input id="text-answer" placeholder="اكتب إجابتك 😏" />
                            <button id="send-answer">إرسال</button>

                            ${feedbackHTML}
                        </div>
                    `;
                }

                // 🔥 هنا بقى المهم
                document.querySelectorAll(".answer-btn").forEach((btn) => {
                    const answer = btn.dataset.answer;

                    // 🔒 لو جاوب قبل كده
                    if (myAnswer) {
                        btn.disabled = true;

                        if (answer === myAnswer) {
                            btn.style.background = "#3b82f6"; // اختياره
                        }
                    }

                    btn.addEventListener("click", async () => {
                        if (myAnswer) return;

                        const snap = await getDoc(roomRef);
                        const data = snap.data();

                        const startTime =
                            data.questionStartTimes?.[
                                `${category}_${currentIndex}`
                            ];

                        // 🚫 لو لسه مفيش startTime
                        if (!startTime) {
                            console.log("⏳ لسه السؤال ما بدأش");
                            return;
                        }

                        await updateDoc(roomRef, {
                            [`answers.${category}.${currentIndex}.${playerId}`]:
                                {
                                    answer,
                                    correctAnswer,
                                    category,
                                    questionIndex: currentIndex,
                                    time: Date.now(),
                                },
                        });
                    });
                });

                const sendBtn = document.getElementById("send-answer");

                if (sendBtn) {
                    sendBtn.addEventListener("click", async () => {
                        if (myAnswer) return;

                        const input = document.getElementById("text-answer");
                        const answer = input.value.trim();

                        if (!answer) return;

                        const snap = await getDoc(roomRef);
                        const data = snap.data();

                        const startTime =
                            data.questionStartTimes?.[
                                `${category}_${currentIndex}`
                            ];

                        if (!startTime) return;

                        await updateDoc(roomRef, {
                            [`answers.${category}.${currentIndex}.${playerId}`]:
                                {
                                    answer,
                                    correctAnswer,
                                    category,
                                    questionIndex: currentIndex,
                                    time: Date.now(),
                                },
                        });
                    });
                }
            }

            const currentAnswers =
                data.answers?.[category]?.[currentIndex] || {};

            let fastestPlayer = null;
            let fastestTime = Infinity;

            Object.entries(currentAnswers).forEach(([id, ans]) => {
                if (ans.time < fastestTime) {
                    fastestTime = ans.time;
                    fastestPlayer = id;
                }
            });

            if (fastestPlayer) {
                console.log("🏆 أسرع لاعب:", fastestPlayer);
            }

            const resultBox = document.getElementById("results-box");

            const startTime =
                data.questionStartTimes?.[`${category}_${currentIndex}`];

            let results = [];

            Object.entries(currentAnswers).forEach(([id, ans]) => {
                let diff = 0;

                if (startTime && ans.time) {
                    diff = (ans.time - startTime) / 1000;
                }

                let isCorrect = false;

                if (Array.isArray(correctAnswer)) {
                    isCorrect = correctAnswer.some(
                        (c) => normalize(ans.answer) === normalize(c),
                    );
                } else {
                    isCorrect =
                        normalize(ans.answer) === normalize(correctAnswer);
                }
                results.push({
                    id,
                    time: diff,
                    correct: isCorrect,
                });
            });
            results.sort((a, b) => a.time - b.time);
            resultBox.innerHTML = `
                <div class='results-card'>
                    <h3>⚡ ترتيب السرعة:</h3>
                </div>
                `;
            resultBox.innerHTML =
                "<div class='results-card card'><h3>⚡ أسرع اللاعبين:</h3></div>";

            results.forEach((r, index) => {
                const name = data.players[r.id]?.name || "لاعب";

                const isMe = r.id === playerId;

                const div = document.createElement("div");
                // const isHost = playerId === data.hostId;

                if (isHost) {
                    // 👑 الهوست يشوف كله
                    div.className = `result-item ${
                        r.correct ? "correct-player" : "wrong-player"
                    }`;
                } else {
                    // 🎮 اللاعب يشوف نفسه بس
                    if (isMe) {
                        div.className = `result-item ${
                            r.correct ? "correct-player" : "wrong-player"
                        }`;
                    } else {
                        div.className = "result-item"; // عادي بدون ألوان
                    }
                }
                div.innerHTML = `
  <span>
    ${index === 0 ? "🏆" : "⚡"} 
    ${name}
    ${isMe ? "👉 (انت)" : ""}
  </span>
  <span>
  ${r.time ? r.time.toFixed(2) + "s" : "--"}
</span>
`;

                resultBox.querySelector(".results-card").appendChild(div);
            });

            // 👑 تحديد الهوست
if (controls) {
  controls.style.display = isHost ? "block" : "none";
}
            // 🎮 حالة اللعبة
            if (data.status === "playing") {
                console.log("🔥 اللعبة بدأت!");
                // document.body.style.background = "#111";
            }
        });

        // 🚀 start game
        document
            .getElementById("start-game")
            ?.addEventListener("click", async () => {
                const snap = await getDoc(roomRef);
                const data = snap.data();

                const category = data.questionCategory;

                if (!category) {
                    alert("اختار فئة الأول يا نجم 😏");
                    return;
                }

                const qSnap = await getDocs(
                    query(
                        collection(db, "questions"),
                        where("approved", "==", true),
                        where("category", "==", category),
                    ),
                );

                const list = qSnap.docs.map((doc) => doc.data());

                // shuffle
                list.sort(() => Math.random() - 0.5);

                if (list.length === 0) {
                    document.getElementById("question-box").innerHTML = `
                        <div class="question-card">
                            <h2>😅 مفيش أسئلة في الفئة دي</h2>
                        </div>
                    `;
                    return;
                }

                await updateDoc(roomRef, {
                    status: "playing",

                    questionsList: list,
                    question: list[0],

                    // 👇 مهم
                    [`answers.${category}`]: {},
                    [`currentIndex.${category}`]: 0,

                    [`questionStartTimes.${category}_0`]: Date.now(),
                });
            });
        // ❌ end game
        document
            .getElementById("end-game")
            ?.addEventListener("click", async () => {
                await deleteDoc(roomRef);
                alert("الروم اتقفلت 👋");
                window.location.href = "/";
            });
        document
            .getElementById("show-results")
            ?.addEventListener("click", () => {
                window.location.href = `/room/${roomCode}/results`;
            });
const dropdown = document.querySelector(".category-dropdown");

document.querySelectorAll(".cat-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    dropdown.classList.remove("open");
  });
});
const btn = document.querySelector(".dropdown-btn");

btn.addEventListener("click", () => {
  dropdown.classList.toggle("open");
});
    </script>
</Layout>
