---
const { code } = Astro.params;
import Layout from "../../../layouts/Layout.astro";
---

<Layout>
    <h1 style="text-align:center; margin:20px;">📊 نتائج اللعبة</h1>
    <button id="back-to-game" style="margin:20px;"> 🔙 رجوع للعبة </button>
    <div id="results"></div>
    <script
        src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"
    ></script>

    <script type="module">
        import { db } from "/js/firebase.js";
        import {
            doc,
            onSnapshot,
            updateDoc,
        } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

        const roomCode = window.location.pathname.split("/")[2];
        const roomRef = doc(db, "rooms", roomCode);

        const container = document.getElementById("results");
        const counted = {};
        const winMusic = new Audio("/sounds/win.mp3");

        winMusic.volume = 0.6;

        window.addEventListener("pageshow", (event) => {
            if (event.persisted) {
                window.location.reload();
            }
        });
        function startConfetti() {
            const duration = 5 * 1000;
            const end = Date.now() + duration;

            (function frame() {
                confetti({
                    particleCount: 15,
                    spread: 120,
                    origin: {
                        x: Math.random(),
                        y: Math.random() * 0.5,
                    },
                });

                if (Date.now() < end) {
                    requestAnimationFrame(frame);
                }
            })();
        }

        // 🔥 realtime listener
        onSnapshot(roomRef, (snap) => {
            const data = snap.data();

            if (!data) {
                window.location.href = "/";
                return;
            }

            // 🔥 أهم شرط بقى
            if (!data.showResults) {
                window.history.back();
                return;
            }

            renderResults(data);
        });

        function renderResults(data) {
            const answers = data.answers || {};
            const players = data.players || {};

            let html = `
        <table class="results-table">
            <thead>
                <tr>
                    <th>👤 اللاعب</th>
                    <th>📂 الفئة</th>
                    <th>❓ السؤال</th>
                    <th>✍️ إجابته</th>
                    <th>🏁 النتيجة</th>
                    <th>✅ الصح</th>
                    <th>⏱️ الوقت</th>
                </tr>
            </thead>
            <tbody>
    `;

            const scores = {};

            for (let questionKey in data.questionStartTimes || {}) {
                const startTime = data.questionStartTimes[questionKey];
                const question = answers[questionKey];

                if (!question) continue;

                let fastestTime = Infinity;
                let fastestPlayer = null;

                for (let playerId in question) {
                    const ans = question[playerId];

                    if (ans.time) {
                        const diff = (ans.time - startTime) / 1000;

                        if (diff > 0 && diff < fastestTime) {
                            fastestTime = diff;
                            fastestPlayer = playerId;
                        }
                    }
                }

                for (let playerId in question) {
                    const ans = question[playerId];

                    let timeDiff = null;

                    if (ans.time) {
                        timeDiff = (ans.time - startTime) / 1000;
                    }

                    const playerName = players[playerId]?.name || "لاعب";
                    const isCorrect = ans.answer === ans.correctAnswer;

                    if (!counted[playerId]) counted[playerId] = new Set();

                    if (isCorrect && !counted[playerId].has(questionKey)) {
                        scores[playerId] = (scores[playerId] || 0) + 1;
                        counted[playerId].add(questionKey);
                    }

                    html += `
                <tr>
                    <td><strong>${playerName}</strong></td>
                    <td>${ans.category}</td>
                    <td>#${ans.questionIndex + 1}</td>
                    <td>${ans.answer}</td>
                    <td>${isCorrect ? "✔️ صح" : "❌ غلط"}</td>
                    <td>${ans.correctAnswer}</td>
                    <td>
                        ${timeDiff !== null ? timeDiff.toFixed(2) + "s" : "--"}
                        ${playerId === fastestPlayer ? "⚡" : ""}
                    </td>
                </tr>
            `;
                }
            }

            html += `</tbody></table>`;

            const playersCount = Object.keys(players).length;

            let leaderboardHTML = "";

            if (playersCount < 2) {
                leaderboardHTML = `
        <div class="leaderboard">
            <div class="trophy-box">
                <div class="trophy-icon">😏</div>
                <div class="leader-title">إنت لوحدك يا نجم 😂</div>
            </div>
        </div>
    `;
            } else {
                leaderboardHTML = `
        <div class="leaderboard">
            <div class="trophy-box">
                <div class="trophy-icon">🏆</div>
                <div class="leader-title">الترتيب</div>
            </div>
            ${Object.entries(scores)
                .sort((a, b) => b[1] - a[1])
                .slice(0, 3)
                .map(([playerId, score], i) => {
                    const name = players[playerId]?.name || "لاعب";

                    return `
                        <div class="leader-item">
                            <span>#${i + 1}</span>
                            <span>${name}</span>
                            <span>${score} نقطة</span>
                        </div>
                    `;
                })
                .join("")}
        </div>
    `;
            }

            container.innerHTML = `
        <div class="flip-card" id="flip-card">
            <div class="flip-inner">
                <div class="flip-front">
                    <h2>🎯 اضغط لمعرفة الفائز</h2>
                </div>

                <div class="flip-back">
                    ${leaderboardHTML}
                </div>
            </div>
        </div>

        <div class="table-wrapper">
            ${html}
        </div>
    `;

            const card = document.getElementById("flip-card");

            // 🔥 لو الأدمن فتح الكارت
            if (data.showWinner) {
                card.classList.add("flipped");

                startConfetti();
                winMusic.currentTime = 0;
                winMusic.play().catch(() => {});
            }

            // 👇 لما الأدمن يدوس
            card.onclick = async () => {
                await updateDoc(roomRef, {
                    showWinner: true,
                });
            };
        }
        document
            .getElementById("back-to-game")
            ?.addEventListener("click", async () => {
                await updateDoc(roomRef, {
                    showResults: false,
                    showWinner: false,
                });
            });
    </script>
</Layout>
