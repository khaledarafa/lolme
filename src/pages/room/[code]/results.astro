---
const { code } = Astro.params;
import Layout from "../../../layouts/Layout.astro";
---

<Layout>
    <h1>📊 نتائج اللعبة</h1>
    <p>الكود: {code}</p>

    <!-- <div id="results-table" data-code={code}></div> -->
<div class="table-wrapper">
  <div id="results-table" data-code={code}></div>
</div>
    <script type="module">
        import { db } from "/js/firebase.js";
        import {
            doc,
            onSnapshot,
        } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

        const container = document.getElementById("results-table");
        const roomCode = container.dataset.code;
        const roomRef = doc(db, "rooms", roomCode);

        onSnapshot(roomRef, (snap) => {
            const data = snap.data();

            if (!data) {
                container.innerHTML = "الروم اتقفلت 👋";
                return;
            }

            let allResults = [];

            const answers = data.answers || {};
            const players = data.players || {};

            Object.entries(answers).forEach(([category, categoryAnswers]) => {
                Object.entries(categoryAnswers).forEach(
                    ([qIndex, qAnswers]) => {
                        const startTime =
                            data.questionStartTimes?.[`${category}_${qIndex}`];

                        Object.entries(qAnswers).forEach(([playerId, ans]) => {
                            const diff = startTime
                                ? Math.max((ans.time - startTime) / 1000, 0) // 👈 fix السالب
                                : 0;

                            const normalize = (str) =>
                                str?.trim().replace(/\s+/g, " ");

                            const isCorrect =
                                normalize(ans.answer) ===
                                normalize(ans.correctAnswer);

                            allResults.push({
                                playerId,
                                name: players[playerId]?.name || "لاعب",
                                category,
                                question: Number(qIndex),
                                time: diff,
                                answer: ans.answer,
                                correct: isCorrect,
                            });
                        });
                    },
                );
            });
            // 🔥 ترتيب حسب السرعة
            allResults.sort((a, b) => a.time - b.time);

            // 🧾 جدول
            container.innerHTML = `
        <table class="results-table">
          <thead>
            <tr>
              <th>#</th>
              <th>اللاعب</th>
              <th>الفئة</th>
                <th>السؤال</th> 
              <th>الوقت (ث)</th>
              <th>الإجابة</th>
            </tr>
          </thead>
          <tbody>
            ${allResults
                .map(
                    (r, i) => `
                    <tr>
                       <td>
                        ${i === 0 ? "💎 أسطورة" : i === 1 ? "🔶 محترف" : i === 2 ? "🥉 جامد" : i + 1}
                        </td>
                        <td>${r.name}</td>
                        <td>${r.category}</td>
                        <td>سؤال ${r.question + 1}</td>
                        <td>
                        ${r.time !== null && r.time !== undefined ? r.time.toFixed(2) + "s" : "--"}
                        </td>
                        <td class="${r.correct ? "correct-answer" : "wrong-answer"}">
                        ${r.answer}
                        </td>
                    </tr>
                    `,
                )
                .join("")}
          </tbody>
        </table>
      `;
        });
    </script>
</Layout>
