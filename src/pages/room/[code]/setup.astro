---
// src/pages/room/[code]/setup.astro
const { code } = Astro.params;
import Layout from "../../../layouts/Layout.astro";
---

<Layout>
    <div class="setup-container">
        <h1>🎯 إعداد الجولة</h1>
        <p class="sub">🎮 اختار الفئات وعدد الأسئلة… وخلي اللعب يبدأ 🔥 👇</p>

        <!-- ⚙️ عدد الأسئلة -->
        <div class="questions-count">
            <button class="q-btn active" data-count="3">3 أسئلة</button>
            <button class="q-btn" data-count="5">5 أسئلة</button>
            <button class="q-btn" data-count="7">7 أسئلة</button>
        </div>
        <div id="setup-root" data-code={code}></div>

        <!-- 🎴 الفئات -->
        <div id="categories-grid" class="categories-grid" style="display:none;">
        </div>
        <p id="summary"></p>
        <!-- 🚀 زرار البداية -->
        <div class="role-select">
            <p>اختار دورك 👇</p>

            <button class="role-btn" data-role="player"> 🎮 هلعب معاهم </button>
            <button class="role-btn" data-role="admin"> 🧠 هدور اللعبة </button>
            <button class="role-btn" data-role="host">
                🎤 هعمل لايف (مذيع)
            </button>
        </div>
        <button id="start-round" class="start-btn"> 🚀 ابدأ الجولة </button>
    </div>

    <script type="module">
        import {
            db,
            doc,
            collection,
            query,
            where,
            getDocs,
            setDoc,
            increment,
        } from "/js/firebase.js";

        async function buildGamePlan(selectedCategories, questionsCount) {
            const gamePlan = [];

            // 👇 نجيب كل الفئات مرة واحدة
            const catsSnap = await getDocs(collection(db, "categories"));
            const catsMap = {};

            catsSnap.forEach((doc) => {
                const c = doc.data();
                catsMap[c.slug] = c;
            });

            for (const cat of selectedCategories) {
                const catData = catsMap[cat];

                // 🔥 أهم فلترة
                if (catData?.roles && !catData.roles.includes(selectedRole)) {
                    continue;
                }

                const q = query(
                    collection(db, "questions"),
                    where("approved", "==", true),
                    where("category", "==", cat),
                );

                const snap = await getDocs(q);

                let list = snap.docs.map((d) => d.data());

                list.sort(() => Math.random() - 0.5);
                list = list.slice(0, questionsCount);

                gamePlan.push({
                    category: cat,
                    questions: list,
                });
            }

            return gamePlan;
        }
        const roomCode = document.getElementById("setup-root").dataset.code;
        const roomRef = doc(db, "rooms", roomCode);

        let selectedCategories = [];
        let questionsCount = 3;

        // 🎯 اختيار عدد الأسئلة
        document.querySelectorAll(".q-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                document
                    .querySelectorAll(".q-btn")
                    .forEach((b) => b.classList.remove("active"));

                btn.classList.add("active");
                questionsCount = Number(btn.dataset.count);

                updateSummary(); // 👈 ضيف دي هنا
            });
        });

        // 🎴 اختيار الفئات
        document.querySelectorAll(".cat-card").forEach((card) => {
            card.addEventListener("click", () => {
                const cat = card.dataset.cat;

                if (selectedCategories.includes(cat)) {
                    selectedCategories = selectedCategories.filter(
                        (c) => c !== cat,
                    );
                    card.classList.remove("active");
                } else {
                    selectedCategories.push(cat);
                    card.classList.add("active");
                }
            });
        });
        let selectedRole = null;

        document.querySelectorAll(".role-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                document
                    .querySelectorAll(".role-btn")
                    .forEach((b) => b.classList.remove("active"));

                btn.classList.add("active");

                selectedRole = btn.dataset.role;

                localStorage.setItem("role", selectedRole);

                // 👇 الجديد بقى
                document.getElementById("categories-grid").style.display =
                    "block";

                loadCategories();
            });
        });
        const savedRole = localStorage.getItem("role");

        if (savedRole) {
            selectedRole = savedRole;

            document.querySelectorAll(".role-btn").forEach((btn) => {
                if (btn.dataset.role === savedRole) {
                    btn.classList.add("active");
                }
            });

            // 🔥 المهم بقى
            document.getElementById("categories-grid").style.display = "block";
            loadCategories();
        }

        function updateSummary() {
            const total = selectedCategories.length * questionsCount;

            document.getElementById("summary").innerText =
                `🎯 ${selectedCategories.length} فئات = ${total} سؤال`;
        }

        const grid = document.getElementById("categories-grid");

        async function loadCategories() {
            const snap = await getDocs(collection(db, "categories"));
            const questionsSnap = await getDocs(collection(db, "questions"));

            const questionsCountMap = {};

            questionsSnap.forEach((doc) => {
                const q = doc.data();

                if (!q.approved) return;

                const cat = q.category;

                if (!questionsCountMap[cat]) {
                    questionsCountMap[cat] = 0;
                }

                questionsCountMap[cat]++;
            });
            grid.innerHTML = "";

            const groups = {};
            function getGroupLabel(group) {
                const map = {
                    football: "⚽ كورة",
                    songs: "🎵 أغاني",
                    brain: "🧠 معلومات",
                    movies: "🎬 ترفيه",
                    products: "🛍️ منتجات",
                    mix: "🌍 منوعات",
                };

                return map[group] || group;
            }
            snap.forEach((doc) => {
                const cat = doc.data();

                // 👇 أهم سطر في حياتك حالياً 😂
                if (cat.roles && !cat.roles.includes(selectedRole)) return;

                if (cat.hidden) return;

                if (!groups[cat.group]) {
                    groups[cat.group] = [];
                }

                groups[cat.group].push(cat);
            });

            // 🔥 نبني الواجهة بالجروبات
            Object.keys(groups).forEach((groupName) => {
                const groupWrapper = document.createElement("div");
                groupWrapper.className = "group-block";

                const title = document.createElement("h3");
                title.innerText = getGroupLabel(groupName);
                title.className = "group-title";

                const row = document.createElement("div");
                row.className = "group-row";

                groups[groupName].forEach((cat) => {
                    const div = document.createElement("div");
                    div.className = "cat-card";
                    div.dataset.cat = cat.slug;
                    div.style.backgroundImage = `url(${cat.image})`;

                    const count = questionsCountMap[cat.slug] || 0;

                    const span = document.createElement("span");
                    span.innerText = `${cat.name} (${count})`;

                    div.appendChild(span);

                    div.addEventListener("click", () => {
                        const catSlug = cat.slug;

                        if (selectedCategories.includes(catSlug)) {
                            selectedCategories = selectedCategories.filter(
                                (c) => c !== catSlug,
                            );
                            div.classList.remove("active");
                        } else {
                            selectedCategories.push(catSlug);
                            div.classList.add("active");
                        }

                        updateSummary();
                    });

                    row.appendChild(div);
                });

                groupWrapper.appendChild(title);
                groupWrapper.appendChild(row);

                grid.appendChild(groupWrapper);
            });
        }
        // loadCategories();

        // 🚀 بدء الجولة
        document
            .getElementById("start-round")
            .addEventListener("click", async () => {
                if (!selectedRole) {
                    alert("اختار انت هتلعب ولا هتدير يا نجم 😏");
                    return;
                }

                if (selectedCategories.length === 0) {
                    alert("اختار فئة 😏");
                    return;
                }

                const gamePlan = await buildGamePlan(
                    selectedCategories,
                    questionsCount,
                );

                await setDoc(
                    roomRef,
                    {
                        gamePlan,
                        currentCategoryIndex: 0,
                        currentQuestionIndex: 0,
                        status: "playing",
                        adminMode: selectedRole,
                        hostId: localStorage.getItem("player_" + roomCode),
                    },
                    { merge: true },
                );
                if (!localStorage.getItem("counted_room")) {
                    const today = new Date().toISOString().slice(0, 10);

                    await setDoc(
                        doc(db, "stats", today),
                        {
                            rooms: increment(1),
                        },
                        { merge: true },
                    );

                    localStorage.setItem("counted_room", "1");
                }
                // 👇 روح للعبة
                if (selectedRole === "admin") {
                    window.location.href = `/room/${roomCode}/admin-board`;
                    await setDoc(
                        roomRef,
                        {
                            currentQuestion: null,
                        },
                        { merge: true },
                    );
                } else if (selectedRole === "host") {
                    // 👑 يفتح صفحتين
                    window.open(`/room/${roomCode}/liveboard`, "_blank");

                    window.location.href = `/room/${roomCode}/liveadmin`;
                } else {
                    window.location.href = `/room/${roomCode}/board`;
                }
            });
    </script>
</Layout>
