---
// src/pages/room/[code]/setup.astro
const { code } = Astro.params;
import Layout from "../../../layouts/Layout.astro";
---

<Layout>
    <div class="setup-container">
        <h1>🎯 إعداد الجولة</h1>
        <p class="sub">
            👇 اختار هتلعب إزاي الأول… وبعدها هنكمل خطوة خطوة 😏🔥
        </p>
        <!-- 🚀 زرار البداية -->
        <div class="modes-intro">
            <h2>🎮 تختار تلعب إزاي؟</h2>
            <p>اختار الطريقة اللي تناسبك وابدأ التحدي 😏🔥</p>

            <div class="modes-grid">
                <!-- 🎮 لعب -->
                <div class="mode-card">
                    <div class="icon">🎮</div>
                    <h3>العب مع أصحابك</h3>
                    <p>
                        1️⃣ اختار الفئات وابدأ الجولة <br />
                        2️⃣ اعمل لعبة وابعت الكود لصحابك <br />
                        3️⃣ كل واحد يدخل ويجاوب من موبايله <br />
                        4️⃣ في الآخر يظهر مين كسب 🔥
                    </p>
                    <button class="role-btn" data-role="player">
                        🎮 هلعب معاهم
                    </button>
                </div>

                <!-- 🧠 ادمن -->
                <div class="mode-card">
                    <div class="icon">🧠</div>
                    <h3>إدارة اللعبة</h3>
                    <p>
                        1️⃣ اختار الفئات وابدأ الجولة <br />
                        2️⃣ افتح الأسئلة عندك <br />
                        3️⃣ أصحابك يشوفوا ويجاوبوا من عندهم <br />
                        4️⃣ إنت تشوف الإجابات وتدير اللعبة 😎
                    </p>
                    <button class="role-btn" data-role="admin">
                        🧠 هدور اللعبة
                    </button>
                </div>

                <!-- 🎤 لايف -->
                <div class="mode-card">
                    <div class="icon">🎤</div>
                    <h3>وضع اللايف</h3>
                    <p>
                        1️⃣ اختار الفئات وابدأ الجولة <br />
                        2️⃣ هتفتح لك صفحتين تلقائي 👇 <br /><br />

                        💡 شاشة اللايف بورد قدام الكاميرا 🎥 <br />
                        🚫 أي كليك عليها مش هيشتغل <br />

                        🧠 كل التحكم بيكون من لايف أدمن 😎 <br />
                        <br />
                        الجمهور يشوف الأسئلة على اللايف <br />
                        وإنت تكتب النتيجه وتحدد مين كسب 😎
                    </p>
                    <button class="role-btn" data-role="host">
                        🎤 هعمل لايف (مذيع)
                    </button>
                </div>
            </div>
        </div>
        <!-- ⚙️ عدد الأسئلة -->
        <div class="questions-count" id="questions-box" style="display:none;">
            <button class="q-btn active" data-count="3">3 أسئلة</button>
            <button class="q-btn" data-count="5">5 أسئلة</button>
            <button class="q-btn" data-count="7">7 أسئلة</button>
        </div>
        <div id="setup-root" data-code={code}></div>

        <!-- 🎴 الفئات -->
        <div id="categories-grid" class="categories-grid" style="display:none;">
        </div>
        <p id="summary"></p>

        <button id="start-round" class="start-btn" style="display:none;">
            🚀 ابدأ الجولة
        </button>
    </div>

    <script type="module">
        import { db, doc, collection, query, where, orderBy, limit, getDocs, setDoc, increment, getCountFromServer, } from "/js/firebase.js";
        async function buildGamePlan(selectedCategories, questionsCount) {
            const gamePlan = [];

            // 👇 نجيب كل الفئات مرة واحدة
            const catsSnap = await getDocs(collection(db, "categories"));
            const catsMap = {};

            catsSnap.forEach((doc) => {
                const c = doc.data();
                catsMap[c.slug] = c;
            });

            for (const cat of selectedCategories) {
                const catData = catsMap[cat];

                // 🔥 أهم فلترة
                if (catData?.roles && !catData.roles.includes(selectedRole)) {
                    continue;
                }

                const rand = Math.random();

                let q = query(
                    collection(db, "questions"),
                    where("approved", "==", true),
                    where("category", "==", cat),
                    where("random", ">=", rand),
                    orderBy("random"),
                    limit(questionsCount),
                );

                let snap = await getDocs(q);

                // 👇 fallback لو مفيش نتايج
                if (snap.empty) {
                    q = query(
                        collection(db, "questions"),
                        where("approved", "==", true),
                        where("category", "==", cat),
                        orderBy("random"),
                        limit(questionsCount),
                    );

                    snap = await getDocs(q);
                }

                let list = snap.docs.map((d) => d.data());

                gamePlan.push({
                    category: cat,
                    questions: list,
                });
            }

            return gamePlan;
        }
        const roomCode = document.getElementById("setup-root").dataset.code;
        const roomRef = doc(db, "rooms", roomCode);

        let selectedCategories = [];
        let questionsCount = 3;

        // 🎯 اختيار عدد الأسئلة
        document.querySelectorAll(".q-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                document
                    .querySelectorAll(".q-btn")
                    .forEach((b) => b.classList.remove("active"));

                btn.classList.add("active");
                questionsCount = Number(btn.dataset.count);

                // 👇 بعد ما يختار عدد الأسئلة نظهر الفئات
                document.getElementById("categories-grid").style.display =
                    "block";

                loadCategories();

                // scroll
                const el = document.getElementById("categories-grid");

                const y = el.getBoundingClientRect().top + window.scrollY - 120;

                window.scrollTo({
                    top: y,
                    behavior: "smooth",
                });

                updateSummary(); // 👈 ضيف دي هنا
            });
        });

        // 🎴 اختيار الفئات
        document.querySelectorAll(".cat-card").forEach((card) => {
            card.addEventListener("click", () => {
                const cat = card.dataset.cat;

                if (selectedCategories.includes(cat)) {
                    selectedCategories = selectedCategories.filter(
                        (c) => c !== cat,
                    );
                    card.classList.remove("active");
                } else {
                    selectedCategories.push(cat);
                    card.classList.add("active");
                }
            });
        });
        let selectedRole = null;

        document.querySelectorAll(".role-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                document
                    .querySelectorAll(".role-btn")
                    .forEach((b) => b.classList.remove("active"));

                btn.classList.add("active");

                selectedRole = btn.dataset.role;

                localStorage.setItem("role", selectedRole);

                // 👇 نوري بس عدد الأسئلة الأول
                document.getElementById("questions-box").style.display =
                    "block";

                // نخبي الباقي
                document.getElementById("categories-grid").style.display =
                    "none";
                document.getElementById("start-round").style.display = "none";
            });
        });
        const savedRole = localStorage.getItem("role");

        if (savedRole) {
            selectedRole = savedRole;

            document.querySelectorAll(".role-btn").forEach((btn) => {
                if (btn.dataset.role === savedRole) {
                    btn.classList.add("active");
                }
            });

            document.getElementById("questions-box").style.display = "block";
            window.scrollTo(0, 0);
        }

        function updateSummary() {
            const total = selectedCategories.length * questionsCount;

            document.getElementById("summary").innerText =
                `🎯 ${selectedCategories.length} فئات = ${total} سؤال`;
        }

        const grid = document.getElementById("categories-grid");
        function generateSkeleton() {
            let html = "";

            const groupsCount = 4; // نفس عدد السكاشن تقريبًا

            for (let i = 0; i < groupsCount; i++) {
                html += `
      <div class="group-block">
        <div class="group-title skeleton-title"></div>
        <div class="group-row">
          ${Array(6)
              .fill(`<div class="cat-card skeleton-card"></div>`)
              .join("")}
        </div>
      </div>
    `;
            }

            return html;
        }
        async function loadCategories() {
            grid.innerHTML = generateSkeleton();
            const snap = await getDocs(collection(db, "categories"));

            // 👇 استنى شوية عشان المستخدم يشوف التحميل
            await new Promise((resolve) => setTimeout(resolve, 500));
            // 👇 امسح السكلتون قبل ما تعرض الحقيقي
            grid.innerHTML = "";
            const groups = {};
            function getGroupLabel(group) {
                const map = {
                    football: "⚽ كورة",
                    songs: "🎵 أغاني",
                    brain: "🧠 معلومات",
                    movies: "🎬 ترفيه",
                    products: "🛍️ منتجات",
                    mix: "🌍 منوعات",
                };

                return map[group] || group;
            }
            snap.forEach((doc) => {
                const cat = doc.data();

                // 👇 أهم سطر في حياتك حالياً 😂
                if (cat.roles && !cat.roles.includes(selectedRole)) return;

                if (cat.hidden) return;

                if (!groups[cat.group]) {
                    groups[cat.group] = [];
                }

                groups[cat.group].push(cat);
            });

            // 🔥 نبني الواجهة بالجروبات
            Object.keys(groups).forEach(async (groupName) => {
                const groupWrapper = document.createElement("div");
                groupWrapper.className = "group-block";

                const title = document.createElement("h3");
                title.innerText = getGroupLabel(groupName);
                title.className = "group-title";

                const row = document.createElement("div");
                row.className = "group-row";

                const cards = await Promise.all(
                    groups[groupName].map(async (cat) => {
                        const div = document.createElement("div");
                        div.className = "cat-card";
                        div.dataset.cat = cat.slug;
                        div.style.backgroundImage = `url(${cat.image})`;

                        const qRef = query(
                            collection(db, "questions"),
                            where("approved", "==", true),
                            where("category", "==", cat.slug),
                        );

                        const snapshot = await getCountFromServer(qRef);
                        const count = snapshot.data().count;

                        const span = document.createElement("span");
                        span.innerText = `${cat.name} (${count})`;

                        div.appendChild(span);

                        div.addEventListener("click", () => {
                            const catSlug = cat.slug;

                            if (selectedCategories.includes(catSlug)) {
                                selectedCategories = selectedCategories.filter(
                                    (c) => c !== catSlug,
                                );
                                div.classList.remove("active");
                            } else {
                                selectedCategories.push(catSlug);
                                div.classList.add("active");
                            }

                            updateSummary();
                            if (selectedCategories.length > 0) {
                                document.getElementById(
                                    "start-round",
                                ).style.display = "block";
                            }
                        });

                        return div;
                    }),
                );

                // 👇 نضيفهم مرة واحدة
                cards.forEach((div) => row.appendChild(div));
                groupWrapper.appendChild(title);
                groupWrapper.appendChild(row);

                grid.appendChild(groupWrapper);
            });
        }
        // loadCategories();

        // 🚀 بدء الجولة
        document
            .getElementById("start-round")
            .addEventListener("click", async () => {
                if (!selectedRole) {
                    alert("اختار انت هتلعب ولا هتدير يا نجم 😏");
                    return;
                }

                if (selectedCategories.length === 0) {
                    alert("اختار فئة 😏");
                    return;
                }

                const gamePlan = await buildGamePlan(
                    selectedCategories,
                    questionsCount,
                );

                await setDoc(
                    roomRef,
                    {
                        gamePlan,
                        currentCategoryIndex: 0,
                        currentQuestionIndex: 0,
                        status: "playing",
                        adminMode: selectedRole,
                        hostId: localStorage.getItem("player_" + roomCode),
                    },
                    { merge: true },
                );
                if (!localStorage.getItem("counted_room")) {
                    const today = new Date().toISOString().slice(0, 10);

                    await setDoc(
                        doc(db, "stats", today),
                        {
                            rooms: increment(1),
                        },
                        { merge: true },
                    );

                    localStorage.setItem("counted_room", "1");
                }
                // 👇 روح للعبة
                if (selectedRole === "admin") {
                    window.location.href = `/room/${roomCode}/admin-board`;
                    await setDoc(
                        roomRef,
                        {
                            currentQuestion: null,
                        },
                        { merge: true },
                    );
                } else if (selectedRole === "host") {
                    // 👑 يفتح صفحتين
                    window.open(`/room/${roomCode}/liveboard`, "_blank");

                    window.location.href = `/room/${roomCode}/liveadmin`;
                } else {
                    window.location.href = `/room/${roomCode}/board`;
                }
            });
    </script>
</Layout>
