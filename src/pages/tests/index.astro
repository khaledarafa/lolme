---
// src/pages/tests/index.astro
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import { quizzes } from "../../data/quizzes/index.js";
// import AdsInjector from "../../components/AdsInjector.astro";
---

<Layout 
  title="اختبارات مضحكة وشخصيات | LOLME 😂"
  description="مجموعة اختبارات خفيفة ومسلية تكتشف بيها شخصيتك بطريقة مرحة. جرّب اختبارات الأكل، الأفلام، الحيوانات والمزيد 😏"
>
  <main class="tests-page">

    <!-- <AdsInjector showTop={true} showSide={true} showFloating={true} showBottom={false} /> -->
    <section class="intro">
      <h1>اختبارات خفيفة ومسلية 🔮</h1>
      <h2 class="cta-line">خلينا نلعب شوية 😎 👇</h2>
    </section>

    <section class="grid">
      {quizzes.map((quiz, i) => (
        <a href={`/tests/${quiz.slug}`} class="quiz-card tilt-card">
          <img
            src={quiz.img}
            alt={quiz.title}
            loading={i < 3 ? "eager" : "lazy"}
            fetchpriority={i < 3 ? "high" : "auto"}
          />
          <div class="content">
            <p class="card-title">{quiz.title}</p>
            <p>{quiz.desc}</p>
          </div>
        </a>
      ))}      
    </section>
    <!-- <AdsInjector showTop={false} showSide={false} showFloating={false} showBottom={true} /> -->

  </main>
  <!-- <script src="/js/tilt-cards.js" defer></script> -->
  
  <script src="/js/tilt-cards.js" defer></script>

  <!-- <script type="module" src="/js/tilt-cards.js"></script> -->

  <style>
    .tests-page {
      max-width: 1000px;
      margin: auto;
      padding: 40px 20px;
    }

    .intro {
      text-align: center;
      margin-bottom: 40px;
    }

    .intro h1 {
      font-size: 2.2rem;
      color: var(--highlight-color, #ff4081);
      margin-bottom: 15px;
    }

    .intro p {
      color: var(--accent);
      line-height: 1.7;
      font-size: 1.1rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    .quiz-card {
      text-decoration: none;
      color: inherit;
      background: var(--bg-color);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 6px 15px var(--shadow-color);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .quiz-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 6px 15px rgb(241, 249, 16);
    }

    .quiz-card img {
      width: 100%;
      height: 180px;
      object-fit: cover;
    }

    .quiz-card .content {
      padding: 15px;
      flex: 1;
    }

    .quiz-card h3 {
      font-size: 1.2rem;
      margin-bottom: 10px;
      /* color: #222; */
    }

    .quiz-card p {
      /* color: #555; */
      font-size: 0.95rem;
      line-height: 1.5;
    }

    @media (max-width: 500px) {
      .intro h1 {
        font-size: 1.7rem;
      }
      .quiz-card img {
        height: 150px;
      }
    }
  </style>
</Layout>
